; simulation/separate_v4.rasm: separation and integration fused (AVX2)
;
; sim_separate_v3's lanes = entities kernel; when a group of up to 8
; consecutive slots has its separation sums, the same slots are integrated
; right away (spec 4.4, sim_integrate's operations in the same order), while
; their positions, velocities and sums are in registers. No sep columns, no
; second pass over the population. New positions go to the caller's output
; columns (fz_out_tab, per pool participant), because other groups still read
; this tick's start positions; velocities are written in place (separation
; never reads them). Over chunks of slots the output is sim_pos3 and the
; position columns are swapped afterwards; a fused band's job writes into
; its own cache-resident buffer and copies each row home into the start
; positions once no row next to it is left to separate (grid_mt.rasm), so
; no third position column streams through memory. A group shorter than 8
; stores with a lane mask, so groups never write each other's slots.

; The columns it works on (set by the caller): start positions in grid order,
; the velocities (updated in place) and the output positions.
fz_src_x: *f32 = 0
fz_src_z: *f32 = 0
fz_vel_x: *f32 = 0
fz_vel_z: *f32 = 0
#define FZ_BUF_ENTS 65536
#define FZ_PART_SHIFT 19
fz_out_tab: [128]u64 = {}              ; per participant (r9d): its output columns x, z (indexed by slot)
fz_buf: *f32 = 0
fz_inplace: u32 = 0                    ; this build's fused bands integrate in place (a large population)
#define FZ_INPLACE_MIN 262144
fz_pend_x: *f32 = 0                    ; integrated rows waiting for their boundary job (sim_pos3)
fz_pend_z: *f32 = 0                       ; per participant 1 << FZ_PART_SHIFT bytes: x, then z (sim_alloc)
fz_cell: *u32 = 0                      ; the next build's cell of each slot, bit 31: changed cell (written here)
next_band_total: [128]u32 = {}         ; the next build's members and movers per band
next_mov_total: [128]u32 = {}
grid_maxdisp: u32 = 0                  ; the largest |move| on one axis this tick (f32 bits, >= 0)
k_sep_cap17: [8]const u32[align(32)] = { 17, 17, 17, 17, 17, 17, 17, 17 }
k_cell_moved: [8]const u32[align(32)] = { 0x80000000, 0x80000000, 0x80000000, 0x80000000, 0x80000000, 0x80000000, 0x80000000, 0x80000000 }
k_abs: [8]const u32[align(32)] = { 0x7FFFFFFF, 0x7FFFFFFF, 0x7FFFFFFF, 0x7FFFFFFF, 0x7FFFFFFF, 0x7FFFFFFF, 0x7FFFFFFF, 0x7FFFFFFF }

; ecx: base slot, edx: participant. Its outputs go to its own buffer, slot
; `base` at the buffer's start (a fused band's job: the buffer stays in its
; cache, and the rows are copied home once nothing reads their start
; positions). Without fz_inplace (a population that fits in cache: nothing
; to save, only copies to pay) the entry stays sim_pos3. Clobbers rax, r10, r11.
fz_out_local: proc() = {
    cmp fz_inplace, 0
    je done
    mov eax, edx
    shl rax, FZ_PART_SHIFT
    mov r10, fz_buf
    add rax, r10
    mov r10d, ecx
    shl r10, 2
    sub rax, r10                       ; so that [rax + slot * 4] is the buffer
    lea r11, fz_out_tab
    mov r10d, edx
    shl r10d, 4
    mov qword ptr [r11 + r10], rax
    add rax, FZ_BUF_ENTS * 4
    mov qword ptr [r11 + r10 + 8], rax
done:
    ret
}

; ecx: first slot, edx: one past the last; r8, r9: source x, z; r10, r11:
; destination x, z (all indexed by slot). Clobbers rax, rcx, rdx.
fz_copy: proc() = {
    push rsi
    push rdi
    sub edx, ecx
    jbe done
    mov eax, ecx
    lea rsi, [r8 + rax*4]
    lea rdi, [r10 + rax*4]
    mov ecx, edx
    rep movsd
    lea rsi, [r9 + rax*4]
    lea rdi, [r11 + rax*4]
    mov ecx, edx
    rep movsd
done:
    pop rdi
    pop rsi
    ret
}

; ecx, edx: slots; r8d: participant. Its buffer's rows home: into the start
; positions, which become the integrated ones. Clobbers rax, rcx, rdx, r8 - r11.
fz_rows_home: proc() = {
    cmp fz_inplace, 0
    je done
    lea rax, fz_out_tab
    shl r8d, 4
    mov r9, qword ptr [rax + r8 + 8]
    mov r8, qword ptr [rax + r8]
    mov r10, fz_src_x
    mov r11, fz_src_z
    call fz_copy
done:
    ret
}

; ecx, edx: slots; r8d: participant. Its buffer's rows into the pending
; columns: a boundary job still reads their start positions.
fz_rows_stash: proc() = {
    cmp fz_inplace, 0
    je done
    lea rax, fz_out_tab
    shl r8d, 4
    mov r9, qword ptr [rax + r8 + 8]
    mov r8, qword ptr [rax + r8]
    mov r10, fz_pend_x
    mov r11, fz_pend_z
    call fz_copy
done:
    ret
}

; ecx, edx: slots. Pending rows home.
fz_rows_pend: proc() = {
    cmp fz_inplace, 0
    je done
    mov r8, fz_pend_x
    mov r9, fz_pend_z
    mov r10, fz_src_x
    mov r11, fz_src_z
    call fz_copy
done:
    ret
}

; ecx: first sorted slot, edx: one past the last, r9d: the participant (a pool
; job; its fz_out_tab entry says where the integrated positions go)
sim_separate_v4: proc(begin: u32, end: u32, chunk: u32) = {
    push rbp
    push rbx
    push rsi
    push rdi
    push r12
    push r13
    push r14
    push r15
    sub rsp, 1400                      ; 8 + 64 + 1336 = 1408; [rsp .. 63] lane scratch, xmm6..15 at [rsp + 64 ..], [rsp + 224] lanes, [rsp + 240] largest move, [rsp + 288] band counts, [rsp + 800] mover counts, [rsp + 1312] output x, z
    lea rax, fz_out_tab
    shl r9d, 4
    mov r10, qword ptr [rax + r9]
    mov qword ptr [rsp + 1312], r10    ; this participant's output columns
    mov r10, qword ptr [rax + r9 + 8]
    mov qword ptr [rsp + 1320], r10
    movaps xmmword ptr [rsp + 64], xmm6
    movaps xmmword ptr [rsp + 80], xmm7
    movaps xmmword ptr [rsp + 96], xmm8
    movaps xmmword ptr [rsp + 112], xmm9
    movaps xmmword ptr [rsp + 128], xmm10
    movaps xmmword ptr [rsp + 144], xmm11
    movaps xmmword ptr [rsp + 160], xmm12
    movaps xmmword ptr [rsp + 176], xmm13
    movaps xmmword ptr [rsp + 192], xmm14
    movaps xmmword ptr [rsp + 208], xmm15
    mov r12, fz_src_x
    mov r13, fz_src_z
    mov r14, sim_sorted_id
    mov r15, sim_cell_start
    mov ebx, edx                       ; end
    mov esi, ecx                       ; s: the group's first slot
    rdtsc
    shl rdx, 32
    or rax, rdx
    mov qword ptr [rsp + 280], rax
    mov dword ptr [rsp + 232], 0       ; groups start fast
    vxorps xmm0, xmm0, xmm0
    vmovups ymmword ptr [rsp + 240], ymm0
    lea rax, [rsp + 288]
    mov edx, 32
zero_counts:
    vmovups ymmword ptr [rax], ymm0
    add rax, 32
    dec edx
    jnz zero_counts
    vbroadcastss ymm14, k_one[0]
    vmovdqa ymm15, ymmword ptr k_sep_cap
group:
    cmp esi, ebx
    jae all_done
    vmovups ymm0, ymmword ptr [r12 + rsi*4]        ; px of the lanes (columns padded by 16)
    vmovups ymm1, ymmword ptr [r13 + rsi*4]        ; pz
    ; the lanes' cells
    vaddps ymm6, ymm1, ymmword ptr k_world_half
    vmulps ymm6, ymm6, ymmword ptr k_inv_cell
    vcvttps2dq ymm6, ymm6                          ; cz
    vaddps ymm7, ymm0, ymmword ptr k_world_half
    vmulps ymm7, ymm7, ymmword ptr k_inv_cell
    vcvttps2dq ymm7, ymm7                          ; cx
    ; the group: the leading lanes in lane 0's row, and before `end`
    vpbroadcastd ymm8, xmm6
    vpcmpeqd ymm8, ymm8, ymm6
    vmovmskps eax, ymm8
    not eax
    or eax, 256
    tzcnt eax, eax
    mov edx, ebx
    sub edx, esi
    cmp eax, edx
    cmova eax, edx                     ; k lanes, 1..8
    mov dword ptr [rsp + 224], eax
    shl eax, 5
    lea rdx, k_lane_valid
    vmovdqa ymm5, ymmword ptr [rdx + rax]          ; valid lanes
    vmovd xmm13, esi
    vpbroadcastd ymm13, xmm13
    vpaddd ymm13, ymm13, ymmword ptr k_iota        ; the lanes' slots
    ; window columns: first lane's cx - 1 .. last lane's cx + 1, clamped
    vmovdqu ymmword ptr [rsp], ymm7
    mov eax, dword ptr [rsp + 224]
    mov ecx, dword ptr [rsp]
    mov edx, dword ptr [rsp + rax*4 - 4]
    lea r11d, [rcx - 1]
    xor eax, eax
    test r11d, r11d
    cmovs r11d, eax                    ; lo column
    lea ebp, [rdx + 1]
    mov eax, GRID_DIM - 1
    cmp ebp, eax
    cmova ebp, eax                     ; hi column
    vmovd edi, xmm6
    dec edi                            ; first row
    mov dword ptr [rsp + 236], edi
    vxorps ymm2, ymm2, ymm2            ; sx
    vxorps ymm3, ymm3, ymm3            ; sz
    vpxor ymm4, ymm4, ymm4             ; hits per lane
    ; the integration's steering needs only the lanes' positions: start its
    ; sqrt/div chain now, so it runs alongside the candidate loop
    vbroadcastss ymm6, hero_x
    vsubps ymm6, ymm6, ymm0                        ; dx = hero - px
    vbroadcastss ymm7, hero_z
    vsubps ymm7, ymm7, ymm1                        ; dz
    vmulps ymm8, ymm6, ymm6
    vmulps ymm9, ymm7, ymm7
    vaddps ymm8, ymm8, ymm9                        ; d2
    vcmpps ymm9, ymm8, ymmword ptr k_stop, 30      ; d2 > STOP_R2
    vblendvps ymm8, ymm14, ymm8, ymm9              ; 1.0 where masked out
    vsqrtps ymm8, ymm8
    vdivps ymm8, ymm14, ymm8                       ; inv
    vmulps ymm6, ymm6, ymm8
    vmulps ymm6, ymm6, ymmword ptr k_speed         ; tx = (dx * inv) * speed
    vmulps ymm7, ymm7, ymm8
    vmulps ymm7, ymm7, ymmword ptr k_speed
    vandps ymm6, ymm6, ymm9
    vandps ymm7, ymm7, ymm9
    vmovups ymmword ptr [rsp + 1336], ymm6
    vmovups ymmword ptr [rsp + 1368], ymm7
    cmp dword ptr [rsp + 232], 0
    jne exact                          ; the last group reached the cap: go exact
    ; fast: no self test, no cap, no lane mask. A lane meets itself once, adding
    ; +0.0f (dx = dz = 0) and one hit; lanes past the group are never stored.
    mov r9d, 3
fast_row:
    cmp edi, GRID_DIM
    jae fast_next_row
    mov ecx, edi
    shl ecx, GRID_SHIFT
    lea edx, [rcx + rbp + 1]
    add ecx, r11d
    mov r8d, dword ptr [r15 + rcx*4]
    mov r10d, dword ptr [r15 + rdx*4]
    cmp r8d, r10d
    jae fast_next_row
    ; four per step when the overrun stays in this row: the slots past the
    ; run are cells hi + 1 .. hi + 7 of the same row, >= 2 m from every lane, so they
    ; never hit. w is masked once: a missed lane adds dx * 0 = +-0.0f, which
    ; changes no sum (a sum is never -0.0f). Else one per step.
    ; bound: the start of cell min(hi + 8, last) of this row, a counter this
    ; band owns (the next row's start may belong to the next band, unbuilt)
    lea eax, [rbp + 8]
    mov edx, GRID_DIM - 1
    cmp eax, edx
    cmova eax, edx
    mov edx, edi
    shl edx, GRID_SHIFT
    add eax, edx
    mov eax, dword ptr [r15 + rax*4]
    sub eax, 3
    cmp r10d, eax
    jg fast_one
fast_four:
    ; the state before this step, in case a lane passes 16 in it
    vmovaps ymm12, ymm2
    vmovaps ymm13, ymm3
    vmovdqa ymm15, ymm4
    mov dword ptr [rsp + 228], r8d
    vbroadcastss ymm6, dword ptr [r12 + r8*4]
    vbroadcastss ymm7, dword ptr [r13 + r8*4]
    vsubps ymm8, ymm0, ymm6
    vsubps ymm9, ymm1, ymm7
    vmulps ymm10, ymm8, ymm8
    vmulps ymm11, ymm9, ymm9
    vaddps ymm10, ymm10, ymm11
    vcmpps ymm11, ymm10, ymm14, 17
    vsubps ymm10, ymm14, ymm10
    vandps ymm10, ymm10, ymm11
    vmulps ymm8, ymm8, ymm10
    vmulps ymm9, ymm9, ymm10
    vaddps ymm2, ymm2, ymm8
    vaddps ymm3, ymm3, ymm9
    vpsubd ymm4, ymm4, ymm11
    vbroadcastss ymm6, dword ptr [r12 + r8*4 + 4]
    vbroadcastss ymm7, dword ptr [r13 + r8*4 + 4]
    vsubps ymm8, ymm0, ymm6
    vsubps ymm9, ymm1, ymm7
    vmulps ymm10, ymm8, ymm8
    vmulps ymm11, ymm9, ymm9
    vaddps ymm10, ymm10, ymm11
    vcmpps ymm11, ymm10, ymm14, 17
    vsubps ymm10, ymm14, ymm10
    vandps ymm10, ymm10, ymm11
    vmulps ymm8, ymm8, ymm10
    vmulps ymm9, ymm9, ymm10
    vaddps ymm2, ymm2, ymm8
    vaddps ymm3, ymm3, ymm9
    vpsubd ymm4, ymm4, ymm11
    vbroadcastss ymm6, dword ptr [r12 + r8*4 + 8]
    vbroadcastss ymm7, dword ptr [r13 + r8*4 + 8]
    vsubps ymm8, ymm0, ymm6
    vsubps ymm9, ymm1, ymm7
    vmulps ymm10, ymm8, ymm8
    vmulps ymm11, ymm9, ymm9
    vaddps ymm10, ymm10, ymm11
    vcmpps ymm11, ymm10, ymm14, 17
    vsubps ymm10, ymm14, ymm10
    vandps ymm10, ymm10, ymm11
    vmulps ymm8, ymm8, ymm10
    vmulps ymm9, ymm9, ymm10
    vaddps ymm2, ymm2, ymm8
    vaddps ymm3, ymm3, ymm9
    vpsubd ymm4, ymm4, ymm11
    vbroadcastss ymm6, dword ptr [r12 + r8*4 + 12]
    vbroadcastss ymm7, dword ptr [r13 + r8*4 + 12]
    vsubps ymm8, ymm0, ymm6
    vsubps ymm9, ymm1, ymm7
    vmulps ymm10, ymm8, ymm8
    vmulps ymm11, ymm9, ymm9
    vaddps ymm10, ymm10, ymm11
    vcmpps ymm11, ymm10, ymm14, 17
    vsubps ymm10, ymm14, ymm10
    vandps ymm10, ymm10, ymm11
    vmulps ymm8, ymm8, ymm10
    vmulps ymm9, ymm9, ymm10
    vaddps ymm2, ymm2, ymm8
    vaddps ymm3, ymm3, ymm9
    vpsubd ymm4, ymm4, ymm11
    ; a lane past 16 hits (itself included: a safe over-count) may have met
    ; the cap: redo from this step's start, exactly
    vpcmpgtd ymm6, ymm4, ymmword ptr k_sep_cap
    vptest ymm6, ymm5
    jnz step_exact
    add r8d, 4
    cmp r8d, r10d
    jb fast_four
    jmp fast_next_row
fast_one:
    vmovaps ymm12, ymm2
    vmovaps ymm13, ymm3
    vmovdqa ymm15, ymm4
    mov dword ptr [rsp + 228], r8d
    vbroadcastss ymm6, dword ptr [r12 + r8*4]
    vbroadcastss ymm7, dword ptr [r13 + r8*4]
    vsubps ymm8, ymm0, ymm6
    vsubps ymm9, ymm1, ymm7
    vmulps ymm10, ymm8, ymm8
    vmulps ymm11, ymm9, ymm9
    vaddps ymm10, ymm10, ymm11
    vcmpps ymm11, ymm10, ymm14, 17
    vsubps ymm10, ymm14, ymm10
    vandps ymm10, ymm10, ymm11
    vmulps ymm8, ymm8, ymm10
    vmulps ymm9, ymm9, ymm10
    vaddps ymm2, ymm2, ymm8
    vaddps ymm3, ymm3, ymm9
    vpsubd ymm4, ymm4, ymm11
    vpcmpgtd ymm6, ymm4, ymmword ptr k_sep_cap
    vptest ymm6, ymm5
    jnz step_exact
    inc r8d
    cmp r8d, r10d
    jb fast_one
fast_next_row:
    inc edi
    dec r9d
    jnz fast_row
    jmp separated
step_exact:
    vmovaps ymm2, ymm12
    vmovaps ymm3, ymm13
    vmovdqa ymm4, ymm15
    mov r8d, dword ptr [rsp + 228]     ; this step's first candidate
    ; the fast count included each lane's own slot once met: rows before the
    ; lanes' row (cz) have not met it, rows after have; in that row, lanes
    ; whose slot is before this candidate have
    mov eax, dword ptr [rsp + 236]
    inc eax                            ; cz
    cmp edi, eax
    jb step_counts
    vpcmpeqd ymm6, ymm6, ymm6
    ja step_seen
    vmovd xmm6, r8d
    vpbroadcastd ymm6, xmm6
    vmovd xmm7, esi
    vpbroadcastd ymm7, xmm7
    vpaddd ymm7, ymm7, ymmword ptr k_iota
    vpcmpgtd ymm6, ymm6, ymm7          ; candidate > the lane's slot: met
step_seen:
    vpaddd ymm4, ymm4, ymm6
step_counts:
    vmovdqa ymm15, ymmword ptr k_sep_cap
    vmovd xmm13, esi
    vpbroadcastd ymm13, xmm13
    vpaddd ymm13, ymm13, ymmword ptr k_iota
    jmp row_resume
row_exact:
    vmovaps ymm2, ymm12
    vmovaps ymm3, ymm13
    vmovdqa ymm4, ymm15
    cmp r9d, 1
    jne own_row_ahead
    vpcmpeqd ymm6, ymm6, ymm6          ; the third row: each lane met itself in the second
    vpaddd ymm4, ymm4, ymm6
own_row_ahead:
    vmovdqa ymm15, ymmword ptr k_sep_cap
    vmovd xmm13, esi                   ; the lanes' slots, for the self test
    vpbroadcastd ymm13, xmm13
    vpaddd ymm13, ymm13, ymmword ptr k_iota
    jmp row
exact:
    mov r9d, 3
row:
    cmp edi, GRID_DIM
    jae next_row
    mov ecx, edi
    shl ecx, GRID_SHIFT
    lea edx, [rcx + rbp + 1]
    add ecx, r11d
    mov r8d, dword ptr [r15 + rcx*4]   ; the row's run of the window
    mov r10d, dword ptr [r15 + rdx*4]
row_resume:
    ; the run in three parts: before the group's own slots and after them no
    ; candidate is a lane itself (no self test, w masked once: missed and
    ; garbage lanes add +-0.0f); the group's own slots, at most 8, get the test
    mov eax, esi
    cmp eax, r10d
    cmova eax, r10d                    ; the end of the part before
    mov dword ptr [rsp + 228], eax
ex_before:
    cmp r8d, dword ptr [rsp + 228]
    jae ex_own_start
    vbroadcastss ymm6, dword ptr [r12 + r8*4]
    vbroadcastss ymm7, dword ptr [r13 + r8*4]
    vsubps ymm8, ymm0, ymm6
    vsubps ymm9, ymm1, ymm7
    vmulps ymm10, ymm8, ymm8
    vmulps ymm11, ymm9, ymm9
    vaddps ymm10, ymm10, ymm11
    vcmpps ymm11, ymm10, ymm14, 17
    vpcmpgtd ymm12, ymm15, ymm4
    vptest ymm12, ymm5
    jz separated
    vpand ymm11, ymm11, ymm12
    vsubps ymm10, ymm14, ymm10
    vandps ymm10, ymm10, ymm11
    vmulps ymm8, ymm8, ymm10
    vmulps ymm9, ymm9, ymm10
    vaddps ymm2, ymm2, ymm8
    vaddps ymm3, ymm3, ymm9
    vpsubd ymm4, ymm4, ymm11
    inc r8d
    jmp ex_before
ex_own_start:
    mov eax, esi
    add eax, dword ptr [rsp + 224]
    cmp eax, r10d
    cmova eax, r10d                    ; the end of the group's own slots
    mov dword ptr [rsp + 228], eax
candidate:
    cmp r8d, dword ptr [rsp + 228]
    jae ex_after
    vbroadcastss ymm6, dword ptr [r12 + r8*4]
    vbroadcastss ymm7, dword ptr [r13 + r8*4]
    vsubps ymm8, ymm0, ymm6                        ; dx = px - x
    vsubps ymm9, ymm1, ymm7                        ; dz
    vmulps ymm10, ymm8, ymm8
    vmulps ymm11, ymm9, ymm9
    vaddps ymm10, ymm10, ymm11                     ; d2
    vcmpps ymm11, ymm10, ymm14, 17                 ; d2 < 1 (LT_OQ)
    vmovd xmm12, r8d
    vpbroadcastd ymm12, xmm12
    vpcmpeqd ymm12, ymm12, ymm13                   ; the lane itself
    vpandn ymm11, ymm12, ymm11
    vpcmpgtd ymm12, ymm15, ymm4                    ; fewer than 16 hits so far
    vptest ymm12, ymm5
    jz separated                       ; every lane has its 16: nothing more can change
    vpand ymm11, ymm11, ymm12
    vpand ymm11, ymm11, ymm5
    vsubps ymm10, ymm14, ymm10                     ; w = 1 - d2
    vmulps ymm8, ymm8, ymm10
    vmulps ymm9, ymm9, ymm10
    vandps ymm8, ymm8, ymm11
    vandps ymm9, ymm9, ymm11
    vaddps ymm2, ymm2, ymm8
    vaddps ymm3, ymm3, ymm9
    vpsubd ymm4, ymm4, ymm11                       ; hit lanes are -1
    inc r8d
    jmp candidate
ex_after:
ex_after_loop:
    cmp r8d, r10d
    jae next_row
    vbroadcastss ymm6, dword ptr [r12 + r8*4]
    vbroadcastss ymm7, dword ptr [r13 + r8*4]
    vsubps ymm8, ymm0, ymm6
    vsubps ymm9, ymm1, ymm7
    vmulps ymm10, ymm8, ymm8
    vmulps ymm11, ymm9, ymm9
    vaddps ymm10, ymm10, ymm11
    vcmpps ymm11, ymm10, ymm14, 17
    vpcmpgtd ymm12, ymm15, ymm4
    vptest ymm12, ymm5
    jz separated
    vpand ymm11, ymm11, ymm12
    vsubps ymm10, ymm14, ymm10
    vandps ymm10, ymm10, ymm11
    vmulps ymm8, ymm8, ymm10
    vmulps ymm9, ymm9, ymm10
    vaddps ymm2, ymm2, ymm8
    vaddps ymm3, ymm3, ymm9
    vpsubd ymm4, ymm4, ymm11
    inc r8d
    jmp ex_after_loop
next_row:
    inc edi
    dec r9d
    jnz row
separated:
    ; integrate the group's own entities now (spec 4.4, the operations of
    ; sim_integrate in the same order): positions to the spare columns, as
    ; other groups still read this tick's start positions; velocities in place
    vmovups ymm6, ymmword ptr [rsp + 1336]         ; tx (computed at the group's start)
    vmovups ymm7, ymmword ptr [rsp + 1368]         ; tz
    vmulps ymm10, ymm2, ymmword ptr k_sep
    vaddps ymm6, ymm6, ymm10                       ; tx + sep_x * 6
    vmulps ymm10, ymm3, ymmword ptr k_sep
    vaddps ymm7, ymm7, ymm10
    mov r9, fz_vel_x
    mov r10, fz_vel_z
    vmovups ymm10, ymmword ptr [r9 + rsi*4]        ; vel_x
    vsubps ymm6, ymm6, ymm10
    vmulps ymm6, ymm6, ymmword ptr k_steer
    vaddps ymm6, ymm10, ymm6                       ; vx
    vmovups ymm11, ymmword ptr [r10 + rsi*4]
    vsubps ymm7, ymm7, ymm11
    vmulps ymm7, ymm7, ymmword ptr k_steer
    vaddps ymm7, ymm11, ymm7                       ; vz
    vmulps ymm8, ymm6, ymmword ptr k_dt
    vaddps ymm8, ymm8, ymm0                        ; nx = vx * dt + pos
    vmulps ymm9, ymm7, ymmword ptr k_dt
    vaddps ymm9, ymm9, ymm1
    vmaxps ymm8, ymm8, ymmword ptr k_lo
    vminps ymm8, ymm8, ymmword ptr k_hi
    vmaxps ymm9, ymm9, ymmword ptr k_lo
    vminps ymm9, ymm9, ymmword ptr k_hi
    ; the largest move of the tick bounds how far any entity changed rows,
    ; which the next grid build relies on
    vsubps ymm10, ymm8, ymm0
    vsubps ymm11, ymm9, ymm1
    vandps ymm10, ymm10, ymmword ptr k_abs
    vandps ymm11, ymm11, ymmword ptr k_abs
    vmaxps ymm10, ymm10, ymm11
    vandps ymm10, ymm10, ymm5
    vmaxps ymm10, ymm10, ymmword ptr [rsp + 240]
    vmovups ymmword ptr [rsp + 240], ymm10
    ; the lanes' new cells for the next build: per slot, and counted per band
    ; (members, and movers). A slot's cell in this build's order is the cell
    ; of its start position (positions change only here and at spawns), so a
    ; lane that changes cell is known here: bit 31 of its stored cell says so,
    ; and the next build needs no column of old cells.
    vaddps ymm10, ymm8, ymmword ptr k_world_half
    vmulps ymm10, ymm10, ymmword ptr k_inv_cell
    vcvttps2dq ymm10, ymm10
    vaddps ymm11, ymm9, ymmword ptr k_world_half
    vmulps ymm11, ymm11, ymmword ptr k_inv_cell
    vcvttps2dq ymm11, ymm11
    vpslld ymm11, ymm11, GRID_SHIFT
    vpaddd ymm10, ymm10, ymm11                     ; new cells
    vaddps ymm12, ymm0, ymmword ptr k_world_half
    vmulps ymm12, ymm12, ymmword ptr k_inv_cell
    vcvttps2dq ymm12, ymm12
    vaddps ymm13, ymm1, ymmword ptr k_world_half
    vmulps ymm13, ymm13, ymmword ptr k_inv_cell
    vcvttps2dq ymm13, ymm13
    vpslld ymm13, ymm13, GRID_SHIFT
    vpaddd ymm12, ymm12, ymm13                     ; cells as of this build
    vpcmpeqd ymm12, ymm12, ymm10                   ; kept their cell
    vmovmskps r11d, ymm12
    vpandn ymm13, ymm12, ymmword ptr k_cell_moved
    vpor ymm13, ymm13, ymm10                       ; as stored
    vmovdqu ymmword ptr [rsp], ymm13
    mov ecx, dword ptr [rsp + 224]
    mov r14, fz_cell
    ; the usual case, all lanes in one band: one store, two popcounts
    vpsrld ymm11, ymm10, BAND_SHIFT
    vpbroadcastd ymm12, xmm11
    vpcmpeqd ymm12, ymm12, ymm11
    vmovmskps eax, ymm12
    vmovmskps edx, ymm5
    and eax, edx
    cmp eax, edx
    jne cell_lanes                     ; the group spans bands: lane by lane
    cmp ecx, 8
    jb cells_masked
    vmovdqu ymmword ptr [r14 + rsi*4], ymm13
    jmp cells_stored
cells_masked:
    vpmaskmovd ymmword ptr [r14 + rsi*4], ymm5, ymm13
cells_stored:
    vmovd edi, xmm11
    popcnt eax, edx
    add dword ptr [rsp + rdi*4 + 288], eax
    andn eax, r11d, edx                ; valid lanes that changed cell
    popcnt eax, eax
    add dword ptr [rsp + rdi*4 + 800], eax
    jmp cells_counted
cell_lanes:
    xor edx, edx
cell_lane:
    mov eax, dword ptr [rsp + rdx*4]
    lea r8d, [rsi + rdx]
    mov dword ptr [r14 + r8*4], eax
    mov edi, eax
    and edi, 0x7FFFFFFF
    shr edi, BAND_SHIFT
    inc dword ptr [rsp + rdi*4 + 288]
    test eax, eax
    jns cell_stays
    inc dword ptr [rsp + rdi*4 + 800]
cell_stays:
    inc edx
    cmp edx, ecx
    jb cell_lane
cells_counted:
    mov r11, qword ptr [rsp + 1312]
    mov r8, qword ptr [rsp + 1320]
    mov ecx, dword ptr [rsp + 224]
    cmp ecx, 8
    jb partial
    vmovups ymmword ptr [r9 + rsi*4], ymm6
    vmovups ymmword ptr [r10 + rsi*4], ymm7
    vmovups ymmword ptr [r11 + rsi*4], ymm8
    vmovups ymmword ptr [r8 + rsi*4], ymm9
    jmp written
partial:
    vmaskmovps ymmword ptr [r9 + rsi*4], ymm5, ymm6
    vmaskmovps ymmword ptr [r10 + rsi*4], ymm5, ymm7
    vmaskmovps ymmword ptr [r11 + rsi*4], ymm5, ymm8
    vmaskmovps ymmword ptr [r8 + rsi*4], ymm5, ymm9
written:
    add esi, ecx
    jmp group
all_done:
    ; publish this call's largest move (atomic max on the f32 bits)
    vmovups ymm0, ymmword ptr [rsp + 240]
    vextractf128 xmm1, ymm0, 1
    vmaxps xmm0, xmm0, xmm1
    vpermilps xmm1, xmm0, 0x4E
    vmaxps xmm0, xmm0, xmm1
    vpermilps xmm1, xmm0, 0xB1
    vmaxps xmm0, xmm0, xmm1
    vmovd edx, xmm0
publish:
    mov eax, grid_maxdisp
    cmp edx, eax
    jbe published
    lock cmpxchg grid_maxdisp, edx
    jnz publish
published:
    ; this call's counts into the next build's totals
    xor ecx, ecx
merge:
    mov eax, dword ptr [rsp + rcx*4 + 288]
    test eax, eax
    jz merged_band
    lea rdx, next_band_total
    lock add dword ptr [rdx + rcx*4], eax
merged_band:
    mov eax, dword ptr [rsp + rcx*4 + 800]
    test eax, eax
    jz merged_mover
    lea rdx, next_mov_total
    lock add dword ptr [rdx + rcx*4], eax
merged_mover:
    inc ecx
    cmp ecx, 128
    jb merge
    vzeroupper
    movaps xmm6, xmmword ptr [rsp + 64]
    movaps xmm7, xmmword ptr [rsp + 80]
    movaps xmm8, xmmword ptr [rsp + 96]
    movaps xmm9, xmmword ptr [rsp + 112]
    movaps xmm10, xmmword ptr [rsp + 128]
    movaps xmm11, xmmword ptr [rsp + 144]
    movaps xmm12, xmmword ptr [rsp + 160]
    movaps xmm13, xmmword ptr [rsp + 176]
    movaps xmm14, xmmword ptr [rsp + 192]
    movaps xmm15, xmmword ptr [rsp + 208]
    rdtsc
    shl rdx, 32
    or rax, rdx
    sub rax, qword ptr [rsp + 280]
    lock add grid_stage_cyc[24], rax
    add rsp, 1400
    pop r15
    pop r14
    pop r13
    pop r12
    pop rdi
    pop rsi
    pop rbx
    pop rbp
    ret
}
