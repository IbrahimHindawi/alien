; simulation/abilities.rasm: SIM 5 abilities (sim_spec.md 4.6)
;
; Dash lives in sim_hero. Pulse, beam and bomb are decided here in scalar
; code, then applied to every entity by one 8-wide pool job, effects in the
; spec's order. Lanes an effect does not touch keep their values exactly
; (vblendvps, not added zeros).

#define DASH_BIT 32
#define PULSE_BIT 64
#define BEAM_BIT 128
#define BOMB_BIT 256
#define DASH_TICKS 10
#define DASH_CD 45
#define PULSE_CD 240
#define BOMB_CD 480
#define BOMB_DELAY 50
#define AREA_CHUNK 16384

dash_ticks: u32 = 0
dash_cd: u32 = 0
dash_x: f32 = 0.0
dash_z: f32 = 0.0
pulse_cd: u32 = 0
pulse_on: u32 = 0
pulse_r: f32 = 0.0
pulse_cx: f32 = 0.0
pulse_cz: f32 = 0.0
energy: f32 = 100.0
beam_on: u32 = 0
beam_ux: f32 = 0.0
beam_uz: f32 = 1.0
bomb_cd: u32 = 0
bomb_timer: u32 = 0
bomb_x: f32 = 0.0
bomb_z: f32 = 0.0
; this tick's effects
fx_pulse: u32 = 0
fx_r0sq: f32 = 0.0
fx_r1sq: f32 = 0.0
fx_k: f32 = 0.0
fx_bomb: u32 = 0

k_dash_speed: const f32 = 32.0
k_pulse_step: const f32 = 0.75
k_pulse_max: const f32 = 36.0
k_pulse_push: const f32 = 26.0
k_beam_len: const f32 = 45.0
k_beam_w2: const f32 = 0.64
k_beam_dpt: const f32 = 0.2
k_energy_max: const f32 = 100.0
k_energy_regen: const f32 = 0.25
k_beam_cost: const f32 = 0.75
k_bomb_r: const f32 = 12.0
k_bomb_r2: const f32 = 144.0
k_bomb_damage: const f32 = 4.0
k_bomb_push: const f32 = 40.0

; The cells an effect can reach this tick (start-of-tick grid, so widened by
; the tick's largest move): only their entities are visited. An entity
; outside cannot meet any effect's test, and the effects are per entity, so
; the result is the spec's.
area_x0: u32 = 0
area_x1: u32 = 0
area_z0: u32 = 0
area_z1: u32 = 0
area_lo_x: f32 = 0.0
area_hi_x: f32 = 0.0
area_lo_z: f32 = 0.0
area_hi_z: f32 = 0.0
k_area_big: const f32 = 1.0e9
k_area_margin: const f32 = 1.0
k_beam_reach: const f32 = 1.0          ; >= sqrt(BEAM_W2) = 0.8

; Union of the active effects' boxes -> area_x0..x1, area_z0..z1 (cells, clamped).
area_bounds: proc() = {
    vmovss xmm0, k_area_big
    vxorps xmm1, xmm1, xmm1
    vsubss xmm1, xmm1, xmm0
    vmovss area_lo_x, xmm0
    vmovss area_lo_z, xmm0
    vmovss area_hi_x, xmm1
    vmovss area_hi_z, xmm1
    cmp fx_pulse, 0
    je no_pulse
        vsqrtss xmm2, xmm2, fx_r1sq                ; r1
        vmovss xmm0, pulse_cx
        vmovss xmm1, pulse_cz
        call area_add_disc
    no_pulse:
    cmp beam_on, 0
    je no_beam
        vmovss xmm2, k_beam_reach
        vmovss xmm0, hero_x
        vmovss xmm1, hero_z
        call area_add_disc
        vmovss xmm0, beam_ux
        vmulss xmm0, xmm0, k_beam_len
        vaddss xmm0, xmm0, hero_x
        vmovss xmm1, beam_uz
        vmulss xmm1, xmm1, k_beam_len
        vaddss xmm1, xmm1, hero_z
        vmovss xmm2, k_beam_reach
        call area_add_disc
    no_beam:
    cmp fx_bomb, 0
    je no_bomb
        vmovss xmm2, k_bomb_r
        vmovss xmm0, bomb_x
        vmovss xmm1, bomb_z
        call area_add_disc
    no_bomb:
    ; widen by the tick's largest move and a margin, then to cells
    vmovd xmm2, grid_maxdisp
    vaddss xmm2, xmm2, k_area_margin
    vmovss xmm0, area_lo_x
    vsubss xmm0, xmm0, xmm2
    call area_cell
    mov area_x0, eax
    vmovss xmm0, area_hi_x
    vaddss xmm0, xmm0, xmm2
    call area_cell
    mov area_x1, eax
    vmovss xmm0, area_lo_z
    vsubss xmm0, xmm0, xmm2
    call area_cell
    mov area_z0, eax
    vmovss xmm0, area_hi_z
    vaddss xmm0, xmm0, xmm2
    call area_cell
    mov area_z1, eax
    ret
}

; xmm0 x, xmm1 z, xmm2 radius: grow the box to hold the disc's square
area_add_disc: proc() = {
    vsubss xmm3, xmm0, xmm2
    vminss xmm3, xmm3, area_lo_x
    vmovss area_lo_x, xmm3
    vaddss xmm3, xmm0, xmm2
    vmaxss xmm3, xmm3, area_hi_x
    vmovss area_hi_x, xmm3
    vsubss xmm3, xmm1, xmm2
    vminss xmm3, xmm3, area_lo_z
    vmovss area_lo_z, xmm3
    vaddss xmm3, xmm1, xmm2
    vmaxss xmm3, xmm3, area_hi_z
    vmovss area_hi_z, xmm3
    ret
}

; xmm0: a world coordinate -> eax: its cell column (or row), clamped to the grid
area_cell: proc() = {
    vmaxss xmm0, xmm0, k_lo[0]
    vminss xmm0, xmm0, k_hi[0]
    vaddss xmm0, xmm0, k_world_half[0]
    vmulss xmm0, xmm0, k_inv_cell[0]
    vcvttss2si eax, xmm0
    xor ecx, ecx
    test eax, eax
    cmovs eax, ecx
    mov ecx, GRID_DIM - 1
    cmp eax, ecx
    cmova eax, ecx
    ret
}

; ecx: first row, edx: one past the last (relative to area_z0): each row's
; run of the box's cells is one slot range of grid-ordered storage
area_rows_job: proc(begin: u32, end: u32, chunk: u32) = {
    push rbx
    push rsi
    push rdi
    sub rsp, 32                        ; 8 + 24 + 32 = 64
    mov ebx, ecx
    mov edi, edx
row:
    cmp ebx, edi
    jae done
    mov eax, area_z0
    add eax, ebx
    shl eax, GRID_SHIFT
    mov rsi, sim_cell_start
    mov edx, eax
    add edx, area_x0
    mov ecx, dword ptr [rsi + rdx*4]
    mov edx, eax
    add edx, area_x1
    mov edx, dword ptr [rsi + rdx*4 + 4]
    call area_job
    inc ebx
    jmp row
done:
    add rsp, 32
    pop rdi
    pop rsi
    pop rbx
    ret
}

; tunables (see combat.rasm): spec values, reset by sim_init
g_dash_cd: u32 = DASH_CD
g_pulse_cd: u32 = PULSE_CD
g_bomb_cd: u32 = BOMB_CD
g_pulse_push: f32 = 26.0
g_energy_regen: f32 = 0.25
g_beam_dpt: f32 = 0.2

; -> xmm0, xmm1: the aim direction normalised, or (0, 1) (spec: as in Fire)
aim_direction: proc() = {
    vmovss xmm0, sim_aim_x
    vsubss xmm0, xmm0, hero_x
    vmovss xmm1, sim_aim_z
    vsubss xmm1, xmm1, hero_z
    vmulss xmm2, xmm0, xmm0
    vmulss xmm3, xmm1, xmm1
    vaddss xmm2, xmm2, xmm3
    vcomiss xmm2, k_fire_eps
    jbe straight
    vsqrtss xmm2, xmm2, xmm2
    vmovss xmm3, k_one[0]
    vdivss xmm3, xmm3, xmm2
    vmulss xmm0, xmm0, xmm3
    vmulss xmm1, xmm1, xmm3
    ret
straight:
    vxorps xmm0, xmm0, xmm0
    vmovss xmm1, k_one[0]
    ret
}

; Start a dash when asked (called by sim_hero before moving).
dash_start: proc() = {
    sub rsp, 40
    test sim_in_keys, DASH_BIT
    jz done
    cmp dash_cd, 0
    jne done
    cmp dash_ticks, 0
    jne done
    vmovss xmm0, sim_move_x
    vmovss xmm1, sim_move_z
    vmulss xmm2, xmm0, xmm0
    vmulss xmm3, xmm1, xmm1
    vaddss xmm2, xmm2, xmm3
    vcomiss xmm2, k_fire_eps
    jbe by_aim
        vsqrtss xmm2, xmm2, xmm2
        vdivss xmm0, xmm0, xmm2
        vdivss xmm1, xmm1, xmm2
        jmp have_dir
    by_aim:
        call aim_direction
    have_dir:
    vmovss dash_x, xmm0
    vmovss dash_z, xmm1
    mov dash_ticks, DASH_TICKS
    mov eax, g_dash_cd
    mov dash_cd, eax
done:
    add rsp, 40
    ret
}

; Decide this tick's effects, then apply them to every entity.
sim_abilities: proc() = {
    sub rsp, 40
    ; pulse
    mov fx_pulse, 0
    cmp hero_alive, 0
    je pulse_running
    test sim_in_keys, PULSE_BIT
    jz pulse_running
    cmp pulse_cd, 0
    jne pulse_running
        mov pulse_on, 1
        mov pulse_r, 0
        vmovss xmm0, hero_x
        vmovss pulse_cx, xmm0
        vmovss xmm0, hero_z
        vmovss pulse_cz, xmm0
        mov eax, g_pulse_cd
        mov pulse_cd, eax
    pulse_running:
    cmp pulse_on, 0
    je pulse_cool
        mov fx_pulse, 1
        vmovss xmm0, pulse_r                   ; r0
        vaddss xmm1, xmm0, k_pulse_step        ; r1
        vdivss xmm2, xmm0, k_pulse_max
        vmovss xmm3, k_one[0]
        vsubss xmm2, xmm3, xmm2
        vmovss xmm3, g_pulse_push
        vmulss xmm2, xmm3, xmm2                ; k = PUSH * (1 - r0 / MAX)
        vmovss fx_k, xmm2
        vmulss xmm2, xmm0, xmm0
        vmovss fx_r0sq, xmm2
        vmulss xmm2, xmm1, xmm1
        vmovss fx_r1sq, xmm2
        vmovss pulse_r, xmm1
        vcomiss xmm1, k_pulse_max
        jb pulse_cool
        mov pulse_on, 0
    pulse_cool:
    cmp pulse_cd, 0
    je pulse_done
    dec pulse_cd
    pulse_done:
    ; beam
    cmp hero_alive, 0
    je no_beam
    test sim_in_keys, BEAM_BIT
    jz no_beam
    vmovss xmm0, energy
    vcomiss xmm0, k_beam_cost
    jb no_beam
        vsubss xmm0, xmm0, k_beam_cost
        vmovss energy, xmm0
        mov beam_on, 1
        call aim_direction
        vmovss beam_ux, xmm0
        vmovss beam_uz, xmm1
        jmp beam_done
    no_beam:
        mov beam_on, 0
        vmovss xmm0, energy
        vaddss xmm0, xmm0, g_energy_regen
        vminss xmm0, xmm0, k_energy_max
        vmovss energy, xmm0
    beam_done:
    ; bomb
    mov fx_bomb, 0
    cmp hero_alive, 0
    je bomb_tick
    test sim_in_keys, BOMB_BIT
    jz bomb_tick
    cmp bomb_cd, 0
    jne bomb_tick
    cmp bomb_timer, 0
    jne bomb_tick
        mov bomb_timer, BOMB_DELAY
        vmovss xmm0, sim_aim_x
        vmovss bomb_x, xmm0
        vmovss xmm0, sim_aim_z
        vmovss bomb_z, xmm0
        mov eax, g_bomb_cd
        mov bomb_cd, eax
        jmp bomb_cool
    bomb_tick:
    cmp bomb_timer, 0
    je bomb_cool
        dec bomb_timer
        jnz bomb_cool
        mov fx_bomb, 1
    bomb_cool:
    cmp bomb_cd, 0
    je bomb_done
    dec bomb_cd
    bomb_done:
    ; apply
    mov eax, fx_pulse
    or eax, beam_on
    or eax, fx_bomb
    jz none
    call area_bounds
    mov edx, area_z1
    sub edx, area_z0
    inc edx                            ; rows
    mov rcx, area_rows_job&
    mov r8d, 2
    call pool_dispatch
none:
    add rsp, 40
    ret
}

k_seq_number: [8]const u32[align(32)] = { 0x3FFFFFFF, 0x3FFFFFFF, 0x3FFFFFFF, 0x3FFFFFFF, 0x3FFFFFFF, 0x3FFFFFFF, 0x3FFFFFFF, 0x3FFFFFFF }

; ecx: first slot, edx: one past the last (any slots: the tail is masked)
area_job: proc(begin: u32, end: u32, chunk: u32) = {
    push rbx
    push rsi
    push rdi
    sub rsp, 176                       ; 8 + 24 + 176 = 208; xmm6..12 at [rsp ..], [rsp + 112] hp before, [rsp + 144] sequences
    movaps xmmword ptr [rsp], xmm6
    movaps xmmword ptr [rsp + 16], xmm7
    movaps xmmword ptr [rsp + 32], xmm8
    movaps xmmword ptr [rsp + 48], xmm9
    movaps xmmword ptr [rsp + 64], xmm10
    movaps xmmword ptr [rsp + 80], xmm11
    movaps xmmword ptr [rsp + 96], xmm12
    mov r8, sim_pos_x
    mov r9, sim_pos_z
    mov r10, sim_vel_x
    mov r11, sim_vel_z
    mov rsi, sim_hp
    mov eax, ecx                       ; slot
    mov edi, edx                       ; end
block:
    cmp eax, edi
    jae done
    vmovups ymm0, ymmword ptr [r8 + rax*4]         ; px
    vmovups ymm1, ymmword ptr [r9 + rax*4]         ; pz
    vmovups ymm2, ymmword ptr [r10 + rax*4]        ; vx
    vmovups ymm3, ymmword ptr [r11 + rax*4]        ; vz
    ; hp lives at the sequence number: gathered for the block's own lanes
    mov ecx, edi
    sub ecx, eax
    cmp ecx, 8
    jbe lanes_n
    mov ecx, 8
    lanes_n:
    shl ecx, 5
    lea rdx, k_lane_valid
    vmovdqa ymm6, ymmword ptr [rdx + rcx]
    mov rdx, sim_seq
    vmovdqu ymm5, ymmword ptr [rdx + rax*4]
    vpand ymm5, ymm5, ymmword ptr k_seq_number
    vmovdqu ymmword ptr [rsp + 144], ymm5
    vpxor xmm4, xmm4, xmm4
    vpgatherdd ymm4, dword ptr [rsi + ymm5*4], ymm6
    vmovups ymmword ptr [rsp + 112], ymm4          ; hp
    cmp fx_pulse, 0
    je no_pulse
        vbroadcastss ymm5, pulse_cx
        vsubps ymm5, ymm0, ymm5                    ; dx
        vbroadcastss ymm6, pulse_cz
        vsubps ymm6, ymm1, ymm6                    ; dz
        vmulps ymm7, ymm5, ymm5
        vmulps ymm8, ymm6, ymm6
        vaddps ymm7, ymm7, ymm8                    ; d2
        vbroadcastss ymm8, fx_r0sq
        vcmpps ymm9, ymm7, ymm8, 29                ; d2 >= r0^2
        vbroadcastss ymm8, fx_r1sq
        vcmpps ymm10, ymm7, ymm8, 17               ; d2 < r1^2
        vandps ymm9, ymm9, ymm10
        vbroadcastss ymm8, k_fire_eps
        vcmpps ymm10, ymm7, ymm8, 30               ; d2 > 1e-4
        vandps ymm9, ymm9, ymm10                   ; mask
        vbroadcastss ymm8, k_one[0]
        vblendvps ymm7, ymm8, ymm7, ymm10          ; d2, or 1 where too close
        vsqrtps ymm7, ymm7
        vdivps ymm7, ymm8, ymm7                    ; inv
        vbroadcastss ymm8, fx_k
        vmulps ymm5, ymm5, ymm7
        vmulps ymm5, ymm5, ymm8                    ; (dx * inv) * k
        vaddps ymm5, ymm2, ymm5
        vblendvps ymm2, ymm2, ymm5, ymm9
        vmulps ymm6, ymm6, ymm7
        vmulps ymm6, ymm6, ymm8
        vaddps ymm6, ymm3, ymm6
        vblendvps ymm3, ymm3, ymm6, ymm9
    no_pulse:
    cmp beam_on, 0
    je no_beam
        vbroadcastss ymm5, hero_x
        vsubps ymm5, ymm0, ymm5                    ; dx
        vbroadcastss ymm6, hero_z
        vsubps ymm6, ymm1, ymm6                    ; dz
        vbroadcastss ymm7, beam_ux
        vmulps ymm7, ymm5, ymm7
        vbroadcastss ymm8, beam_uz
        vmulps ymm8, ymm6, ymm8
        vaddps ymm7, ymm7, ymm8                    ; t
        vmulps ymm5, ymm5, ymm5
        vmulps ymm6, ymm6, ymm6
        vaddps ymm5, ymm5, ymm6                    ; d2
        vmulps ymm6, ymm7, ymm7
        vsubps ymm5, ymm5, ymm6                    ; perp2
        vxorps ymm6, ymm6, ymm6
        vcmpps ymm9, ymm7, ymm6, 29                ; t >= 0
        vbroadcastss ymm6, k_beam_len
        vcmpps ymm10, ymm7, ymm6, 18               ; t <= LEN (LE_OQ)
        vandps ymm9, ymm9, ymm10
        vbroadcastss ymm6, k_beam_w2
        vcmpps ymm10, ymm5, ymm6, 17               ; perp2 < W2
        vandps ymm9, ymm9, ymm10
        vbroadcastss ymm6, g_beam_dpt
        vsubps ymm6, ymm4, ymm6
        vblendvps ymm4, ymm4, ymm6, ymm9
    no_beam:
    cmp fx_bomb, 0
    je no_bomb
        vbroadcastss ymm5, bomb_x
        vsubps ymm5, ymm0, ymm5                    ; dx
        vbroadcastss ymm6, bomb_z
        vsubps ymm6, ymm1, ymm6                    ; dz
        vmulps ymm7, ymm5, ymm5
        vmulps ymm8, ymm6, ymm6
        vaddps ymm7, ymm7, ymm8                    ; d2
        vbroadcastss ymm8, k_bomb_r2
        vcmpps ymm9, ymm7, ymm8, 17                ; d2 < R2
        vbroadcastss ymm8, k_bomb_damage
        vsubps ymm8, ymm4, ymm8
        vblendvps ymm4, ymm4, ymm8, ymm9           ; hp
        vbroadcastss ymm8, k_fire_eps
        vcmpps ymm10, ymm7, ymm8, 30
        vandps ymm9, ymm9, ymm10                   ; pushed lanes
        vbroadcastss ymm8, k_one[0]
        vblendvps ymm7, ymm8, ymm7, ymm10
        vsqrtps ymm7, ymm7                         ; d
        vdivps ymm11, ymm8, ymm7                   ; inv
        vbroadcastss ymm12, k_bomb_r
        vdivps ymm7, ymm7, ymm12                   ; d / R
        vsubps ymm7, ymm8, ymm7                    ; 1 - d / R
        vbroadcastss ymm12, k_bomb_push
        vmulps ymm7, ymm12, ymm7                   ; k = PUSH * (1 - d / R)
        vmulps ymm5, ymm5, ymm11
        vmulps ymm5, ymm5, ymm7
        vaddps ymm5, ymm2, ymm5
        vblendvps ymm2, ymm2, ymm5, ymm9
        vmulps ymm6, ymm6, ymm11
        vmulps ymm6, ymm6, ymm7
        vaddps ymm6, ymm3, ymm6
        vblendvps ymm3, ymm3, ymm6, ymm9
    no_bomb:
    ; the lanes this block killed (hp was > 0, is now <= 0) go to the dead list
    vxorps xmm5, xmm5, xmm5
    vcmpps ymm6, ymm4, ymm5, 18                    ; new hp <= 0 (LE_OQ)
    vmovups ymm7, ymmword ptr [rsp + 112]          ; the hp before
    vcmpps ymm7, ymm7, ymm5, 30                    ; > 0
    vandps ymm6, ymm6, ymm7
    vmovmskps ecx, ymm6
    mov edx, edi
    sub edx, eax
    cmp edx, 8
    jae killed_full
        bzhi ecx, ecx, edx
    killed_full:
    test ecx, ecx
    jz killed_none
killed:
    tzcnt edx, ecx
    blsr ecx, ecx
    add edx, eax
    call dead_push
    test ecx, ecx
    jnz killed
killed_none:
    ; a block past the range's end writes only its own lanes: the next range
    ; may belong to another thread
    mov ecx, edi
    sub ecx, eax
    cmp ecx, 8
    jb partial
    vmovups ymmword ptr [r10 + rax*4], ymm2
    vmovups ymmword ptr [r11 + rax*4], ymm3
    jmp stored
partial:
    shl ecx, 5
    lea rdx, k_lane_valid
    vmovdqa ymm5, ymmword ptr [rdx + rcx]
    vmaskmovps ymmword ptr [r10 + rax*4], ymm5, ymm2
    vmaskmovps ymmword ptr [r11 + rax*4], ymm5, ymm3
stored:
    ; hp back at the sequence numbers: the block's own lanes it changed
    vcmpps ymm5, ymm4, ymmword ptr [rsp + 112], 4  ; NEQ_UQ
    vmovmskps ecx, ymm5
    mov edx, edi
    sub edx, eax
    cmp edx, 8
    jae hp_all
        bzhi ecx, ecx, edx
    hp_all:
    test ecx, ecx
    jz hp_done
    vmovups ymmword ptr [rsp + 112], ymm4
hp_lane:
    tzcnt edx, ecx
    blsr ecx, ecx
    mov ebx, dword ptr [rsp + rdx*4 + 144]
    mov edx, dword ptr [rsp + rdx*4 + 112]
    mov dword ptr [rsi + rbx*4], edx
    test ecx, ecx
    jnz hp_lane
hp_done:
    add eax, 8
    jmp block
done:
    vzeroupper
    movaps xmm6, xmmword ptr [rsp]
    movaps xmm7, xmmword ptr [rsp + 16]
    movaps xmm8, xmmword ptr [rsp + 32]
    movaps xmm9, xmmword ptr [rsp + 48]
    movaps xmm10, xmmword ptr [rsp + 64]
    movaps xmm11, xmmword ptr [rsp + 80]
    movaps xmm12, xmmword ptr [rsp + 96]
    add rsp, 176
    pop rdi
    pop rsi
    pop rbx
    ret
}
