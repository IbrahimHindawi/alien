; simulation/compact_mt.rasm: deaths (spec 4.5 Deaths), on the pool
;
; Storage is in grid order and the next tick's grid build copies every
; survivor anyway (grid_mt.rasm), so the dead are not moved here: the build
; skips them (sequence bit 30). This pass only does what the spec's
; compaction does besides moving: it counts the dead (kills) and the living
; (sim_alive, which spawning uses), and appends each death's position to the
; death events. Until the build, a dead entity stays in storage with hp <= 0;
; every reader in between (projectiles, contact, the hash and the dump)
; already ignores hp <= 0.

; the spare columns (allocated by sim_alloc)
sim_pos_x2: *f32 = 0
sim_pos_z2: *f32 = 0
sim_vel_x2: *f32 = 0
sim_vel_z2: *f32 = 0
sim_hp2: *f32 = 0
sim_seq2: *u32 = 0

; The dead of this tick: every hit that took an entity's hp from > 0 to <= 0
; appended its slot to dead_list (projectiles serially, the area effects with
; an atomic), so nobody scans the population for them. For each: a death
; event, no cell for the next build, out of the next build's counts.
dead_list: *u32 = 0                    ; MAX_ENTITIES, allocated by sim_alloc
dead_n: u32 = 0

; edx: a slot that just died. Preserves everything but flags.
dead_push: proc() = {
    push rax
    push rcx
    mov eax, 1
    lock xadd dead_n, eax
    mov rcx, dead_list
    mov dword ptr [rcx + rax*4], edx
    pop rcx
    pop rax
    ret
}

sim_deaths_mt: proc() = {
    push rbx
    push rsi
    push rdi
    sub rsp, 32
    mov esi, dead_n
    test esi, esi
    jz done
    mov ebx, death_count
    xor edi, edi
dead:
    mov r8, dead_list
    mov eax, dword ptr [r8 + rdi*4]    ; slot
    lea ecx, [rbx + rdi]
    cmp ecx, DEATH_EVENTS_MAX
    jae no_event
    mov r9, sim_pos_x
    mov edx, dword ptr [r9 + rax*4]
    lea r9, death_x
    mov dword ptr [r9 + rcx*4], edx
    mov r9, sim_pos_z
    mov edx, dword ptr [r9 + rax*4]
    lea r9, death_z
    mov dword ptr [r9 + rcx*4], edx
no_event:
    ; out of the next build: sequence bit 30, and out of its band's counts
    ; (bit 31: it changed cell, so it was counted a mover too)
    mov r9, sim_seq
    mov edx, dword ptr [r9 + rax*4]
    test edx, 0x40000000
    jnz counted
    or dword ptr [r9 + rax*4], 0x40000000
    mov r11d, edx
    mov ecx, eax
    call cell_of_slot
    shr eax, BAND_SHIFT
    lea r10, next_band_total
    dec dword ptr [r10 + rax*4]
    test r11d, r11d
    jns counted
    lea r10, next_mov_total
    dec dword ptr [r10 + rax*4]
counted:
    inc edi
    cmp edi, esi
    jb dead
    add kills, esi
    sub sim_alive, esi
    lea eax, [rbx + rsi]
    mov ecx, DEATH_EVENTS_MAX
    cmp eax, ecx
    cmova eax, ecx
    mov death_count, eax
    mov dead_n, 0
done:
    add rsp, 32
    pop rdi
    pop rsi
    pop rbx
    ret
}
