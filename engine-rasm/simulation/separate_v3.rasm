; simulation/separate_v3.rasm: separation with lanes = entities (AVX2)
;
; Same rule and the same result, bit for bit, as the scalar sim_separate
; (spec 4.3). The lanes are up to 8 consecutive sorted slots of one grid row
; (the sorted order is by cell, so they are a run of the row). Every
; candidate of the window, rows cz-1 .. cz+1 and columns from the first
; lane's cx-1 to the last lane's cx+1, is broadcast to all lanes:
;
;   - a candidate outside a lane's own 3x3 cells is at least 2 m away on one
;     axis (the cell of a point is a monotonic function of its position
;     against exactly representable edges), so its rounded d2 >= 4: it never
;     hits that lane;
;   - the window is read row by row, slots ascending, which is the spec's
;     order (rows ascending, x ascending, slots ascending), so each lane adds
;     exactly its own neighbours in the spec's order;
;   - lanes that do not hit add +0.0f, which changes nothing: a sum that
;     starts at +0.0f is never -0.0f, and x + 0.0f == x for every other x;
;   - each lane counts its hits and stops at SEP_MAX_NEIGH, like the spec.
;
; No branch depends on a distance test (the scalar and v2 kernels paid a
; mispredict per hit in dense crowds). The idea is the C rival's
; (docs/performance/contest.md), done here in assembly.

k_iota: [8]const u32[align(32)] = { 0, 1, 2, 3, 4, 5, 6, 7 }
k_sep_cap: [8]const u32[align(32)] = { 16, 16, 16, 16, 16, 16, 16, 16 }

; ecx: first sorted slot, edx: one past the last (a pool job)
sim_separate_v3: proc(begin: u32, end: u32, chunk: u32) = {
    push rbp
    push rbx
    push rsi
    push rdi
    push r12
    push r13
    push r14
    push r15
    sub rsp, 248                       ; 8 + 64 + 248 = 320; [rsp .. 63] lane scratch, xmm6..15 at [rsp + 64 ..], [rsp + 224] lanes
    movaps xmmword ptr [rsp + 64], xmm6
    movaps xmmword ptr [rsp + 80], xmm7
    movaps xmmword ptr [rsp + 96], xmm8
    movaps xmmword ptr [rsp + 112], xmm9
    movaps xmmword ptr [rsp + 128], xmm10
    movaps xmmword ptr [rsp + 144], xmm11
    movaps xmmword ptr [rsp + 160], xmm12
    movaps xmmword ptr [rsp + 176], xmm13
    movaps xmmword ptr [rsp + 192], xmm14
    movaps xmmword ptr [rsp + 208], xmm15
    mov r12, sim_sorted_x
    mov r13, sim_sorted_z
    mov r14, sim_sorted_id
    mov r15, sim_cell_start
    mov ebx, edx                       ; end
    mov esi, ecx                       ; s: the group's first slot
    vbroadcastss ymm14, k_one[0]
    vmovdqa ymm15, ymmword ptr k_sep_cap
group:
    cmp esi, ebx
    jae all_done
    vmovups ymm0, ymmword ptr [r12 + rsi*4]        ; px of the lanes (columns padded by 16)
    vmovups ymm1, ymmword ptr [r13 + rsi*4]        ; pz
    ; the lanes' cells
    vaddps ymm6, ymm1, ymmword ptr k_world_half
    vmulps ymm6, ymm6, ymmword ptr k_inv_cell
    vcvttps2dq ymm6, ymm6                          ; cz
    vaddps ymm7, ymm0, ymmword ptr k_world_half
    vmulps ymm7, ymm7, ymmword ptr k_inv_cell
    vcvttps2dq ymm7, ymm7                          ; cx
    ; the group: the leading lanes in lane 0's row, and before `end`
    vpbroadcastd ymm8, xmm6
    vpcmpeqd ymm8, ymm8, ymm6
    vmovmskps eax, ymm8
    not eax
    or eax, 256
    tzcnt eax, eax
    mov edx, ebx
    sub edx, esi
    cmp eax, edx
    cmova eax, edx                     ; k lanes, 1..8
    mov dword ptr [rsp + 224], eax
    shl eax, 5
    lea rdx, k_lane_valid
    vmovdqa ymm5, ymmword ptr [rdx + rax]          ; valid lanes
    vmovd xmm13, esi
    vpbroadcastd ymm13, xmm13
    vpaddd ymm13, ymm13, ymmword ptr k_iota        ; the lanes' slots
    ; window columns: first lane's cx - 1 .. last lane's cx + 1, clamped
    vmovdqu ymmword ptr [rsp], ymm7
    mov eax, dword ptr [rsp + 224]
    mov ecx, dword ptr [rsp]
    mov edx, dword ptr [rsp + rax*4 - 4]
    lea r11d, [rcx - 1]
    xor eax, eax
    test r11d, r11d
    cmovs r11d, eax                    ; lo column
    lea ebp, [rdx + 1]
    mov eax, GRID_DIM - 1
    cmp ebp, eax
    cmova ebp, eax                     ; hi column
    vmovd edi, xmm6
    dec edi                            ; first row
    mov r9d, 3
    vxorps ymm2, ymm2, ymm2            ; sx
    vxorps ymm3, ymm3, ymm3            ; sz
    vpxor ymm4, ymm4, ymm4             ; hits per lane
row:
    cmp edi, GRID_DIM
    jae next_row
    mov ecx, edi
    shl ecx, GRID_SHIFT
    lea edx, [rcx + rbp + 1]
    add ecx, r11d
    mov r8d, dword ptr [r15 + rcx*4]   ; the row's run of the window
    mov r10d, dword ptr [r15 + rdx*4]
candidate:
    cmp r8d, r10d
    jae next_row
    vbroadcastss ymm6, dword ptr [r12 + r8*4]
    vbroadcastss ymm7, dword ptr [r13 + r8*4]
    vsubps ymm8, ymm0, ymm6                        ; dx = px - x
    vsubps ymm9, ymm1, ymm7                        ; dz
    vmulps ymm10, ymm8, ymm8
    vmulps ymm11, ymm9, ymm9
    vaddps ymm10, ymm10, ymm11                     ; d2
    vcmpps ymm11, ymm10, ymm14, 17                 ; d2 < 1 (LT_OQ)
    vmovd xmm12, r8d
    vpbroadcastd ymm12, xmm12
    vpcmpeqd ymm12, ymm12, ymm13                   ; the lane itself
    vpandn ymm11, ymm12, ymm11
    vpcmpgtd ymm12, ymm15, ymm4                    ; fewer than 16 hits so far
    vpand ymm11, ymm11, ymm12
    vpand ymm11, ymm11, ymm5
    vsubps ymm10, ymm14, ymm10                     ; w = 1 - d2
    vmulps ymm8, ymm8, ymm10
    vmulps ymm9, ymm9, ymm10
    vandps ymm8, ymm8, ymm11
    vandps ymm9, ymm9, ymm11
    vaddps ymm2, ymm2, ymm8
    vaddps ymm3, ymm3, ymm9
    vpsubd ymm4, ymm4, ymm11                       ; hit lanes are -1
    inc r8d
    jmp candidate
next_row:
    inc edi
    dec r9d
    jnz row
    ; results to sep[id] of each lane
    vmovups ymmword ptr [rsp], ymm2
    vmovups ymmword ptr [rsp + 32], ymm3
    mov ecx, dword ptr [rsp + 224]
    mov r9, sim_sep_x
    mov r10, sim_sep_z
    xor edx, edx
out:
    lea r8d, [rsi + rdx]
    mov eax, dword ptr [r14 + r8*4]
    mov r8d, dword ptr [rsp + rdx*4]
    mov dword ptr [r9 + rax*4], r8d
    mov r8d, dword ptr [rsp + rdx*4 + 32]
    mov dword ptr [r10 + rax*4], r8d
    inc edx
    cmp edx, ecx
    jb out
    add esi, ecx
    jmp group
all_done:
    vzeroupper
    movaps xmm6, xmmword ptr [rsp + 64]
    movaps xmm7, xmmword ptr [rsp + 80]
    movaps xmm8, xmmword ptr [rsp + 96]
    movaps xmm9, xmmword ptr [rsp + 112]
    movaps xmm10, xmmword ptr [rsp + 128]
    movaps xmm11, xmmword ptr [rsp + 144]
    movaps xmm12, xmmword ptr [rsp + 160]
    movaps xmm13, xmmword ptr [rsp + 176]
    movaps xmm14, xmmword ptr [rsp + 192]
    movaps xmm15, xmmword ptr [rsp + 208]
    add rsp, 248
    pop r15
    pop r14
    pop r13
    pop r12
    pop rdi
    pop rsi
    pop rbx
    pop rbp
    ret
}
