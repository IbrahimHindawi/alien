; simulation/grid_mt.rasm: storage into grid order, binned by band, for threads
;
; The live columns (pos, vel, hp, seq) are kept in grid order: sorted by cell,
; then by creation sequence, which is the spec's index order. Each tick they
; are permuted into the new cells' order (mostly the identity: few entities
; change cell in a tick, so every pass streams memory in order), and the sorted
; views (sim_sorted_x/z/id) are the live columns themselves, ids the identity.
;
; The rebuild is incremental. Storage is sorted by (old cell, seq), and
; sim_slot_cell holds each slot's old cell (-1 for spawns since). An entity
; whose cell did not change (a stayer) keeps its place relative to the other
; stayers of its cell, so only the movers need placing:
;
;   bin       (chunks)      cell[i] (-1 for the dead, who are left behind);
;                           per chunk, a histogram of bands for everyone
;                           alive and one for movers
;   offsets   (main)        exclusive prefixes, band-major then chunk: band
;                           bases and mover-list offsets
;   bucket    (chunks)      the movers' storage indices, grouped by band
;   band      (per band)    the band's old slot range by binary search on the
;                           old cells; count stayers and movers per cell;
;                           prefix from the band's base; stayers placed
;                           (descending, so they end each cell's run, in
;                           order); movers placed ahead of them; each mover
;                           slides forward into its cell's run by sequence;
;                           then the live columns are gathered slot by slot
;
; The result is sorted by (cell, seq) exactly as a full sort would be (the
; self test against sim_grid and every reference hash check it), and a tick's
; work is a sequential pass plus work in proportion to the movers.

#define BAND_ROWS 8
#define BAND_SHIFT 13
#define BAND_CELLS 8192
#define GRID_BANDS 128
#define BIN_CHUNK 16384
#define BIN_CHUNKS 64

band_total: [GRID_BANDS]u32 = {}
grid_live: u32 = 0
band_offset: [GRID_BANDS]u32 = {}
bin_hist: [8192]u32[align(64)] = {}    ; [chunk * GRID_BANDS + band]
bin_off: [8192]u32[align(64)] = {}
sim_band_ids: *u32 = 0                  ; the movers by band (storage indices, then slots)
mov_hist: [8192]u32[align(64)] = {}     ; movers: [chunk * GRID_BANDS + band]
mov_off: [8192]u32[align(64)] = {}
mov_band_off: [GRID_BANDS]u32 = {}
mov_band_total: [GRID_BANDS]u32 = {}
grid_old_count: u32 = 0                 ; storage at the start of the build
grid_fuse: u32 = 0                      ; 1: also separate and integrate (sim_step)
grid_fuse_now: u32 = 0                  ; this build fuses per band (the population is spread out)
grid_windowed_ticks: u32 = 0
grid_windowed: u32 = 0                  ; this build counts from row windows (no bin, no bucket)
grid_count_error: u32 = 0
grid_build_id: u32 = 0                  ; this build's stamp
band_done: [GRID_BANDS]u32 = {}         ; the stamp of the build that last finished each band
edge_claim: [129]u32 = {}               ; [b]: the rows at the boundary below band b are done
#define MERGE_FEW 256
#define MERGE_NONE 0x7FFFFFFFFFFFFFFF
k_shift1: [8]const u32[align(32)] = { 0, 0, 1, 2, 3, 4, 5, 6 }
sim_mcount: *u32 = 0                    ; GRID_CELLS: per band region, the movers' cell starts
sim_mkey: *u64 = 0                      ; MAX_ENTITIES: the sorted movers' keys
k_bcast3: [8]const u32[align(32)] = { 3, 3, 3, 3, 3, 3, 3, 3 }
k_bcast7: [8]const u32[align(32)] = { 7, 7, 7, 7, 7, 7, 7, 7 }
k_upper_half: [8]const u32[align(32)] = { 0, 0, 0, 0, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF }
grid_built_n: u32 = 0                   ; slots sorted by the last build; spawns follow them
grid_d_rows: u32 = 0                    ; rows any entity can have moved since the last build
k_disp_rows: const f32 = 0.5            ; a cell is 2 m
#define WINDOW_MAX_ROWS 4
#define WINDOW_MAX_TAIL 4096
sim_pos3_x: *f32 = 0                    ; the integrated positions of a fused build
sim_pos3_z: *f32 = 0
sim_slot_cell2: *u32 = 0                ; the new cells of the slots, swapped in at the end

; ecx: begin, edx: end (entities; begin a multiple of 8), r8d: chunk
grid_bin_job: proc(begin: u32, end: u32, chunk: u32) = {
    push rbx
    push rsi
    push rdi
    mov ebx, ecx                       ; begin
    mov edi, edx                       ; end
    ; this chunk's histogram row, zeroed
    mov eax, r8d
    shl eax, 9                         ; chunk * GRID_BANDS * 4
    lea rsi, bin_hist
    add rsi, rax
    lea r11, mov_hist
    add r11, rax
    vpxor ymm0, ymm0, ymm0
    xor eax, eax
zero:
    vmovdqa ymmword ptr [rsi + rax], ymm0
    vmovdqa ymmword ptr [r11 + rax], ymm0
    add eax, 32
    cmp eax, GRID_BANDS * 4
    jb zero
    ; cells, 8 at a time
    mov r8, sim_pos_x
    mov r9, sim_pos_z
    mov r10, sim_cell
    vmovaps ymm4, ymmword ptr k_world_half
    vmovaps ymm5, ymmword ptr k_inv_cell
    mov eax, ebx
    mov edx, edi
    sub edx, ebx
    add edx, 7
    shr edx, 3                         ; blocks
    shl rax, 2
    test edx, edx
    jz cells_done
cells:
    vaddps ymm0, ymm4, ymmword ptr [r8 + rax]
    vmulps ymm0, ymm0, ymm5
    vcvttps2dq ymm0, ymm0
    vaddps ymm1, ymm4, ymmword ptr [r9 + rax]
    vmulps ymm1, ymm1, ymm5
    vcvttps2dq ymm1, ymm1
    vpslld ymm1, ymm1, GRID_SHIFT
    vpaddd ymm0, ymm0, ymm1
    vmovdqa ymmword ptr [r10 + rax], ymm0
    add rax, 32
    dec edx
    jnz cells
cells_done:
    vzeroupper
    ; band histogram (the cells are still in L1/L2); the dead of the last
    ; tick get no cell and are left behind
    mov r8, sim_hp
    mov r9, sim_slot_cell
    vxorps xmm1, xmm1, xmm1
    mov eax, ebx
count:
    cmp eax, edi
    jae counted
    vmovss xmm0, dword ptr [r8 + rax*4]
    vcomiss xmm0, xmm1
    jbe dead
    mov edx, dword ptr [r10 + rax*4]
    mov ecx, edx
    shr edx, BAND_SHIFT
    inc dword ptr [rsi + rdx*4]
    cmp ecx, dword ptr [r9 + rax*4]
    je stayer
    inc dword ptr [r11 + rdx*4]        ; a mover (or a spawn)
stayer:
    inc eax
    jmp count
dead:
    mov dword ptr [r10 + rax*4], -1
    inc eax
    jmp count
counted:
    pop rdi
    pop rsi
    pop rbx
    ret
}

; ecx: begin, edx: end, r8d: chunk. The chunk's movers into the movers lists.
grid_bucket_job: proc(begin: u32, end: u32, chunk: u32) = {
    push rsi
    mov eax, r8d
    shl eax, 9
    lea rsi, mov_off
    add rsi, rax
    mov r10, sim_cell
    mov r9, sim_band_ids
    mov r8, sim_slot_cell
bucket:
    cmp ecx, edx
    jae done
    mov eax, dword ptr [r10 + rcx*4]
    cmp eax, -1
    je skip                            ; dead
    cmp eax, dword ptr [r8 + rcx*4]
    je skip                            ; a stayer
    shr eax, BAND_SHIFT
    mov r11d, dword ptr [rsi + rax*4]
    mov dword ptr [r9 + r11*4], ecx
    inc r11d
    mov dword ptr [rsi + rax*4], r11d
skip:
    inc ecx
    jmp bucket
done:
    pop rsi
    ret
}

; ecx: key, r10: the old cells, r11d: their count -> eax: the first slot whose
; old cell >= key (unsigned: spawns' -1 sorts last). Clobbers rdx, r8.
band_lower_bound: proc() = {
    xor eax, eax
    mov edx, r11d
search:
    cmp eax, edx
    jae found
    lea r8d, [rax + rdx]
    shr r8d, 1
    cmp dword ptr [r10 + r8*4], ecx
    jae left
    lea eax, [r8 + 1]
    jmp search
left:
    mov edx, r8d
    jmp search
found:
    ret
}

; r8d: band. The band's entities into grid order, in the spare columns.
grid_band_job: proc(begin: u32, end: u32, band: u32) = {
    push rbx
    push rsi
    push rdi
    push r12
    push r13
    push r14
    push r15
    push rbp
    sub rsp, 72                        ; [rsp] base, [+4] n, [+8] end, [+12] old lo, [+16] old hi, [+24] lo cell, [+40..] the merge's state
    mov ebx, r8d
    mov r9d, ebx
    shl r9d, BAND_SHIFT                ; lo cell
    mov dword ptr [rsp + 24], r9d
    mov rsi, sim_cell_arr
    ; zero arr[lo + 1 .. lo + BAND_CELLS] (and arr[0] for band 0); a windowed
    ; build keeps them: they are the last build's cell starts, its counts' source
    cmp grid_windowed, 0
    jne zeroed
    lea rdi, [rsi + r9*4 + 4]
    xor eax, eax
    mov ecx, BAND_CELLS
    rep stosd
    test ebx, ebx
    jnz zeroed
        mov dword ptr [rsi], 0
    zeroed:
    lea rax, band_offset
    mov r12d, dword ptr [rax + rbx*4]  ; base
    lea rax, band_total
    mov r13d, dword ptr [rax + rbx*4]  ; n
    mov dword ptr [rsp], r12d
    mov dword ptr [rsp + 4], r13d
    lea eax, [r12 + r13]
    mov dword ptr [rsp + 8], eax
    ; the band's old slots: old cell in [lo, lo + BAND_CELLS)
    mov r10, sim_slot_cell
    mov r11d, grid_old_count
    mov ecx, r9d
    call band_lower_bound
    mov dword ptr [rsp + 12], eax
    lea ecx, [r9 + BAND_CELLS]
    call band_lower_bound
    mov dword ptr [rsp + 16], eax
    ; the band's movers
    lea rax, mov_band_off
    mov edx, dword ptr [rax + rbx*4]
    mov rbp, sim_band_ids
    lea rbp, [rbp + rdx*4]
    lea rax, mov_band_total
    mov r15d, dword ptr [rax + rbx*4]
    mov r8, sim_cell
    cmp grid_windowed, 0
    je full_counts
    ; windowed: the movers come from the band's old rows widened by the
    ; largest move, and from the spawns after the sorted slots, ascending
    mov eax, ebx
    shl eax, 3                         ; the band's first row
    mov edx, eax
    sub eax, grid_d_rows
    xor ecx, ecx
    test eax, eax
    cmovs eax, ecx
    add edx, BAND_ROWS
    add edx, grid_d_rows
    mov ecx, GRID_DIM
    cmp edx, ecx
    cmova edx, ecx
    shl eax, GRID_SHIFT
    shl edx, GRID_SHIFT
    mov dword ptr [rsp + 28], edx
    mov r11d, grid_old_count
    mov ecx, eax
    call band_lower_bound
    mov dword ptr [rsp + 32], eax
    mov ecx, dword ptr [rsp + 28]
    call band_lower_bound
    mov edx, eax
    mov ecx, dword ptr [rsp + 32]
    mov r8, sim_cell
    xor edi, edi
collect_window:
    cmp ecx, edx
    jae collected_window
    mov eax, dword ptr [r8 + rcx*4]
    mov r13d, eax
    sub r13d, r9d
    cmp r13d, BAND_CELLS
    jae next_window                    ; another band, or dead (-1)
    cmp eax, dword ptr [r10 + rcx*4]
    je next_window                     ; a stayer
    mov dword ptr [rbp + rdi*4], ecx
    inc edi
next_window:
    inc ecx
    jmp collect_window
collected_window:
    mov ecx, grid_built_n
    mov edx, grid_old_count
collect_tail:
    cmp ecx, edx
    jae collected_tail
    mov eax, dword ptr [r8 + rcx*4]
    mov r13d, eax
    sub r13d, r9d
    cmp r13d, BAND_CELLS
    jae next_tail
    mov dword ptr [rbp + rdi*4], ecx
    inc edi
next_tail:
    inc ecx
    jmp collect_tail
collected_tail:
    cmp edi, r15d
    je full_counts
    mov grid_count_error, 1            ; the integration's counts disagree: a bug
    mov r15d, edi
full_counts:
    cmp grid_windowed, 0
    jne window_counts
    ; count stayers (new cell = old cell) and movers
    mov ecx, dword ptr [rsp + 12]
count_stay:
    cmp ecx, dword ptr [rsp + 16]
    jae counted_stay
    mov edx, dword ptr [r8 + rcx*4]
    cmp edx, dword ptr [r10 + rcx*4]
    jne next_stay
    inc dword ptr [rsi + rdx*4 + 4]
next_stay:
    inc ecx
    jmp count_stay
    jmp counted_stay
window_counts:
    ; stayers per cell = the cell's old size (from the last build's starts,
    ; still in the counters) minus the old slots that left it (movers, dead)
    lea rdi, [rsi + r9*4 + 4]          ; arr[lo + 1]: start of cell lo
    mov ecx, BAND_CELLS / 8 - 1
old_sizes:
    vmovdqu ymm0, ymmword ptr [rdi]
    vmovdqu ymm1, ymmword ptr [rdi + 4]
    vpsubd ymm1, ymm1, ymm0
    vmovdqu ymmword ptr [rdi], ymm1
    add rdi, 32
    dec ecx
    jnz old_sizes
    ; the band's last block: the last cell ends at the old range's end (the next
    ; counter belongs to the next band)
    vmovdqu ymm0, ymmword ptr [rdi]
    vmovdqu ymm1, ymmword ptr [rdi + 4]
    vmovd xmm2, dword ptr [rsp + 16]
    vpbroadcastd ymm2, xmm2
    vpblendd ymm1, ymm1, ymm2, 0x80
    vpsubd ymm1, ymm1, ymm0
    vmovdqu ymmword ptr [rdi], ymm1
    mov ecx, dword ptr [rsp + 12]
leavers:
    mov edx, dword ptr [rsp + 16]
    sub edx, ecx
    jbe counted_stay
    vmovdqu ymm0, ymmword ptr [r8 + rcx*4]
    vpcmpeqd ymm0, ymm0, ymmword ptr [r10 + rcx*4]
    vmovmskps eax, ymm0
    not eax
    mov r11d, 255
    cmp edx, 8
    jae leavers_full
        mov r11d, edx
        bzhi r11d, eax, r11d           ; only the lanes before the range's end
        mov eax, r11d
        jmp leaving
    leavers_full:
    and eax, r11d
leaving:
    test eax, eax
    jz leavers_next
    tzcnt edx, eax
    blsr eax, eax
    lea r11d, [rcx + rdx]
    mov r11d, dword ptr [r10 + r11*4]  ; its old cell
    dec dword ptr [rsi + r11*4 + 4]
    jmp leaving
leavers_next:
    add ecx, 8
    jmp leavers
counted_stay:
    vzeroupper
    xor ecx, ecx
count_move:
    cmp ecx, r15d
    jae counted_move
    mov eax, dword ptr [rbp + rcx*4]
    mov edx, dword ptr [r8 + rax*4]
    inc dword ptr [rsi + rdx*4 + 4]
    inc ecx
    jmp count_move
counted_move:
    ; inclusive prefix from the band's base, 8 counters per step: within
    ; each 128-bit half by shifts, the low half's last into the high half,
    ; then the running total; the last becomes the next running total
    lea rdi, [rsi + r9*4 + 4]
    vmovd xmm1, r12d
    vpbroadcastd ymm1, xmm1
    vmovdqa ymm4, ymmword ptr k_bcast7
    vmovdqa ymm5, ymmword ptr k_bcast3
    vmovdqa ymm3, ymmword ptr k_upper_half
    xor eax, eax
    cmp grid_windowed, 0
    jne prefix_excl
prefix:
    vmovdqu ymm0, ymmword ptr [rdi + rax*4]
    vpslldq ymm2, ymm0, 4
    vpaddd ymm0, ymm0, ymm2
    vpslldq ymm2, ymm0, 8
    vpaddd ymm0, ymm0, ymm2
    vpermd ymm2, ymm5, ymm0
    vpand ymm2, ymm2, ymm3
    vpaddd ymm0, ymm0, ymm2
    vpaddd ymm0, ymm0, ymm1
    vmovdqu ymmword ptr [rdi + rax*4], ymm0
    vpermd ymm1, ymm4, ymm0
    add eax, 8
    cmp eax, BAND_CELLS
    jb prefix
    jmp prefixed
prefix_excl:
    ; (windowed: exclusive, the cells' starts directly)
    vmovdqu ymm0, ymmword ptr [rdi + rax*4]
    vpslldq ymm2, ymm0, 4
    vpaddd ymm0, ymm0, ymm2
    vpslldq ymm2, ymm0, 8
    vpaddd ymm0, ymm0, ymm2
    vpermd ymm2, ymm5, ymm0
    vpand ymm2, ymm2, ymm3
    vpaddd ymm0, ymm0, ymm2
    vpaddd ymm0, ymm0, ymm1
    vpsubd ymm2, ymm0, ymmword ptr [rdi + rax*4]   ; minus the counts: the starts
    vmovdqu ymmword ptr [rdi + rax*4], ymm2
    vpermd ymm1, ymm4, ymm0
    add eax, 8
    cmp eax, BAND_CELLS
    jb prefix_excl
prefixed:
    vzeroupper
    ; ---------------------------------------------------------------------
    ; windowed: the merge build. Stayers keep their old order, which is
    ; already (cell, seq) order; the movers, sorted by (cell, seq), are merged
    ; in. The output is written once, in order: no slot ids, no gather.
    cmp grid_windowed, 0
    je place_full
    ; A. (the prefix wrote the cells' starts)
    ; B. the movers by (cell, seq). Few movers: keys in list order, then one
    ; insertion sort. Many: counted per cell in the band's region of
    ; sim_mcount, placed by exclusive start, then insertion by seq in each cell
    lea rax, mov_band_off
    mov eax, dword ptr [rax + rbx*4]
    mov rdx, sim_slot_id
    lea r13, [rdx + rax*4]             ; S: the sorted movers' storage indices
    mov rdx, sim_mkey
    lea r14, [rdx + rax*8]             ; K: their keys (cell << 32 | seq)
    cmp r15d, MERGE_FEW
    jae many_movers
    mov r11, sim_seq
    xor ecx, ecx
few_keys:
    cmp ecx, r15d
    jae mplaced
    mov eax, dword ptr [rbp + rcx*4]
    mov dword ptr [r13 + rcx*4], eax
    mov edx, dword ptr [r8 + rax*4]
    shl rdx, 32
    mov eax, dword ptr [r11 + rax*4]
    or rdx, rax
    mov qword ptr [r14 + rcx*8], rdx
    inc ecx
    jmp few_keys
many_movers:
    mov r11, sim_mcount
    lea rdi, [r11 + r9*4]
    vpxor ymm0, ymm0, ymm0
    mov ecx, BAND_CELLS / 8
mzero:
    vmovdqu ymmword ptr [rdi], ymm0
    add rdi, 32
    dec ecx
    jnz mzero
    xor ecx, ecx
mcount:
    cmp ecx, r15d
    jae mcounted
    mov eax, dword ptr [rbp + rcx*4]
    mov edx, dword ptr [r8 + rax*4]
    inc dword ptr [r11 + rdx*4]
    inc ecx
    jmp mcount
mcounted:
    ; exclusive prefix over the band's 8192 counters (only cells with movers matter)
    lea rdi, [r11 + r9*4]
    xor edx, edx
    xor ecx, ecx
mprefix:
    mov eax, dword ptr [rdi + rcx*4]
    mov dword ptr [rdi + rcx*4], edx
    add edx, eax
    inc ecx
    cmp ecx, BAND_CELLS
    jb mprefix
    ; place into the sorted region (slot ids at the band's mover offset) with keys
    xor ecx, ecx
mplace:
    cmp ecx, r15d
    jae mplaced
    mov eax, dword ptr [rbp + rcx*4]   ; storage index
    mov edx, dword ptr [r8 + rax*4]    ; cell
    mov edi, dword ptr [r11 + rdx*4]
    inc dword ptr [r11 + rdx*4]
    mov dword ptr [r13 + rdi*4], eax
    mov r10, sim_seq
    mov r10d, dword ptr [r10 + rax*4]
    shl rdx, 32
    or rdx, r10
    mov qword ptr [r14 + rdi*8], rdx
    inc ecx
    jmp mplace
mplaced:
    ; insertion by key (runs are per cell: short)
    mov ecx, 1
msort:
    cmp ecx, r15d
    jae msorted
    mov rdx, qword ptr [r14 + rcx*8]
    mov eax, dword ptr [r13 + rcx*4]
    mov edi, ecx
mshift:
    test edi, edi
    jz mput
    cmp qword ptr [r14 + rdi*8 - 8], rdx
    jbe mput
    mov r10, qword ptr [r14 + rdi*8 - 8]
    mov qword ptr [r14 + rdi*8], r10
    mov r10d, dword ptr [r13 + rdi*4 - 4]
    mov dword ptr [r13 + rdi*4], r10d
    dec edi
    jmp mshift
mput:
    mov qword ptr [r14 + rdi*8], rdx
    mov dword ptr [r13 + rdi*4], eax
    inc ecx
    jmp msort
msorted:
    ; C. merge the old range's stayers with the sorted movers
    mov r10, sim_slot_cell
    mov ebx, dword ptr [rsp]           ; w: the next output slot
    mov r12d, dword ptr [rsp + 12]     ; i: the old block
    xor edx, edx                       ; k: the next mover
    mov dword ptr [rsp + 40], edx
    mov rsi, MERGE_NONE                ; the next mover's key (none: the largest signed key)
    test r15d, r15d
    jz merge_blocks
    mov rsi, qword ptr [r14]
merge_blocks:
    mov eax, dword ptr [rsp + 16]
    sub eax, r12d
    jbe merge_tail
    ; stayers of the block: new cell = old cell, lanes before the old range's end
    vmovdqu ymm0, ymmword ptr [r8 + r12*4]
    vpcmpeqd ymm1, ymm0, ymmword ptr [r10 + r12*4]
    vmovmskps edi, ymm1
    cmp eax, 8
    jae merge_full
        bzhi edi, edi, eax
    merge_full:
    test edi, edi
    jz merge_next
    ; the stayers' keys (cell << 32 | seq), 4 per vector: ymm2 lanes 0..3, ymm5 lanes 4..7
    mov r11, sim_seq
    vmovdqu ymm1, ymmword ptr [r11 + r12*4]
    vpmovzxdq ymm2, xmm1
    vextracti128 xmm1, ymm1, 1
    vpmovzxdq ymm5, xmm1
    vpmovzxdq ymm1, xmm0
    vpsllq ymm1, ymm1, 32
    vpor ymm2, ymm2, ymm1
    vextracti128 xmm1, ymm0, 1
    vpmovzxdq ymm1, xmm1
    vpsllq ymm1, ymm1, 32
    vpor ymm5, ymm5, ymm1
    mov dword ptr [rsp + 48], edi      ; the block's stayers not yet out
piece:
    ; the stayers whose key comes before the next mover's: a prefix of them
    vmovq xmm1, rsi
    vpbroadcastq ymm1, xmm1
    vpcmpgtq ymm4, ymm1, ymm2
    vmovmskpd eax, ymm4
    vpcmpgtq ymm4, ymm1, ymm5
    vmovmskpd ecx, ymm4
    shl ecx, 4
    or eax, ecx
    and eax, dword ptr [rsp + 48]
    jz piece_movers
    xor dword ptr [rsp + 48], eax
    ; left-pack them (pdep/pext permutation) and store the seven columns
    mov rcx, 0x0101010101010101
    pdep rcx, rax, rcx
    imul rcx, rcx, 255
    mov rdx, 0x0706050403020100
    pext rdx, rdx, rcx
    vmovq xmm3, rdx
    vpmovzxbd ymm3, xmm3
    popcnt ecx, eax
    mov dword ptr [rsp + 44], ecx
    shl ecx, 5
    lea rdx, k_lane_valid
    vmovdqa ymm4, ymmword ptr [rdx + rcx]
    mov r11, sim_pos_x
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_pos_x2
    vpmaskmovd ymmword ptr [r11 + rbx*4], ymm4, ymm1
    mov r11, sim_pos_z
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_pos_z2
    vpmaskmovd ymmword ptr [r11 + rbx*4], ymm4, ymm1
    mov r11, sim_vel_x
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_vel_x2
    vpmaskmovd ymmword ptr [r11 + rbx*4], ymm4, ymm1
    mov r11, sim_vel_z
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_vel_z2
    vpmaskmovd ymmword ptr [r11 + rbx*4], ymm4, ymm1
    mov r11, sim_hp
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_hp2
    vpmaskmovd ymmword ptr [r11 + rbx*4], ymm4, ymm1
    mov r11, sim_seq
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_seq2
    vpmaskmovd ymmword ptr [r11 + rbx*4], ymm4, ymm1
    vpermd ymm1, ymm3, ymm0
    mov r11, sim_slot_cell2
    vpmaskmovd ymmword ptr [r11 + rbx*4], ymm4, ymm1
    add ebx, dword ptr [rsp + 44]
    cmp dword ptr [rsp + 48], 0
    je merge_next
piece_movers:
    ; the movers before the next stayer
    mov eax, dword ptr [rsp + 48]
    tzcnt eax, eax
    lea r9d, [r12 + rax]
    mov eax, dword ptr [r8 + r9*4]
    shl rax, 32
    mov r11, sim_seq
    mov r11d, dword ptr [r11 + r9*4]
    or rax, r11
    mov qword ptr [rsp + 56], rax
piece_mover:
    cmp rsi, qword ptr [rsp + 56]
    jae piece_again
    call merge_emit_mover
    jmp piece_mover
piece_again:
    vmovdqu ymm0, ymmword ptr [r8 + r12*4]          ; (the copies used xmm0)
    jmp piece
merge_next:
    add r12d, 8
    jmp merge_blocks
merge_tail:
    ; the movers after every stayer
    mov rax, MERGE_NONE
    cmp rsi, rax
    je merged
    call merge_emit_mover
    jmp merge_tail
merged:
    vzeroupper
    jmp gathered_b
place_full:
    ; stayers, descending: they end each cell's run, in (cell, seq) order
    mov r11, sim_slot_id
    mov r14, sim_slot_cell2
    mov ecx, dword ptr [rsp + 16]
place_stay:
    cmp ecx, dword ptr [rsp + 12]
    jbe placed_stay
    dec ecx
    mov edx, dword ptr [r8 + rcx*4]
    cmp edx, dword ptr [r10 + rcx*4]
    jne place_stay
    mov eax, dword ptr [rsi + rdx*4 + 4]
    dec eax
    mov dword ptr [rsi + rdx*4 + 4], eax
    mov dword ptr [r11 + rax*4], ecx
    mov dword ptr [r14 + rax*4], edx
    jmp place_stay
placed_stay:
    ; movers ahead of them; the list now records each mover's slot
    xor ecx, ecx
place_move:
    cmp ecx, r15d
    jae placed_move
    mov edi, dword ptr [rbp + rcx*4]
    mov edx, dword ptr [r8 + rdi*4]
    mov eax, dword ptr [rsi + rdx*4 + 4]
    dec eax
    mov dword ptr [rsi + rdx*4 + 4], eax
    mov dword ptr [r11 + rax*4], edi
    mov dword ptr [r14 + rax*4], edx
    mov dword ptr [rbp + rcx*4], eax
    inc ecx
    jmp place_move
placed_move:
    ; creation order: each mover, in placement order, slides forward into the
    ; sorted rest of its cell's run (arr[c + 1] is now the start of cell c)
    mov r13, sim_seq
    mov r12d, dword ptr [rsp + 24]
    add r12d, BAND_CELLS - 1           ; the band's last cell
    xor ecx, ecx
order:
    cmp ecx, r15d
    jae ordered
    mov edx, dword ptr [rbp + rcx*4]   ; the mover's slot
    mov eax, dword ptr [r14 + rdx*4]   ; its cell
    mov edi, dword ptr [rsp + 8]       ; the run's end: the band's end for the last cell,
    cmp eax, r12d
    je slide
    mov edi, dword ptr [rsi + rax*4 + 8]   ; else the start of the next cell
slide:
    lea eax, [rdx + 1]
    cmp eax, edi
    jae next_mover
    mov eax, dword ptr [r11 + rdx*4]
    mov ebx, dword ptr [r11 + rdx*4 + 4]
    mov r9d, dword ptr [r13 + rax*4]
    cmp r9d, dword ptr [r13 + rbx*4]
    jb next_mover
    mov dword ptr [r11 + rdx*4], ebx
    mov dword ptr [r11 + rdx*4 + 4], eax
    inc edx
    jmp slide
next_mover:
    inc ecx
    jmp order
ordered:
    ; gather the six live columns into slot order in one pass (the slot ids
    ; are read once; values move through xmm0, so twelve pointers fit)
    mov rbx, sim_pos_x
    mov rsi, sim_pos_x2
    mov rdi, sim_pos_z
    mov rbp, sim_pos_z2
    mov r8, sim_vel_x
    mov r9, sim_vel_x2
    mov r10, sim_vel_z
    mov r12, sim_vel_z2
    mov r13, sim_hp
    mov r14, sim_hp2
    mov r15, sim_seq
    mov rdx, sim_seq2
    mov ecx, dword ptr [rsp]
    vmovdqa ymm2, ymmword ptr k_iota
gather:
    ; a block of 8 slots whose ids run consecutively (stayers, mostly) is
    ; copied as vectors; else slot by slot
    mov eax, dword ptr [rsp + 8]
    sub eax, ecx
    cmp eax, 8
    jb gather_one
    vmovdqu ymm0, ymmword ptr [r11 + rcx*4]
    vpbroadcastd ymm1, xmm0
    vpaddd ymm1, ymm1, ymm2
    vpcmpeqd ymm1, ymm1, ymm0
    vmovmskps eax, ymm1
    cmp eax, 255
    jne gather_eight
    vmovd eax, xmm0
    vmovups ymm1, ymmword ptr [rbx + rax*4]
    vmovups ymmword ptr [rsi + rcx*4], ymm1
    vmovups ymm1, ymmword ptr [rdi + rax*4]
    vmovups ymmword ptr [rbp + rcx*4], ymm1
    vmovups ymm1, ymmword ptr [r8 + rax*4]
    vmovups ymmword ptr [r9 + rcx*4], ymm1
    vmovups ymm1, ymmword ptr [r10 + rax*4]
    vmovups ymmword ptr [r12 + rcx*4], ymm1
    vmovups ymm1, ymmword ptr [r13 + rax*4]
    vmovups ymmword ptr [r14 + rcx*4], ymm1
    vmovups ymm1, ymmword ptr [r15 + rax*4]
    vmovups ymmword ptr [rdx + rcx*4], ymm1
    add ecx, 8
    jmp gather
gather_eight:
    mov eax, ecx
    add eax, 8
    mov dword ptr [rsp + 32], eax
gather_slot:
    mov eax, dword ptr [r11 + rcx*4]
    vmovd xmm0, dword ptr [rbx + rax*4]
    vmovd dword ptr [rsi + rcx*4], xmm0
    vmovd xmm0, dword ptr [rdi + rax*4]
    vmovd dword ptr [rbp + rcx*4], xmm0
    vmovd xmm0, dword ptr [r8 + rax*4]
    vmovd dword ptr [r9 + rcx*4], xmm0
    vmovd xmm0, dword ptr [r10 + rax*4]
    vmovd dword ptr [r12 + rcx*4], xmm0
    vmovd xmm0, dword ptr [r13 + rax*4]
    vmovd dword ptr [r14 + rcx*4], xmm0
    vmovd xmm0, dword ptr [r15 + rax*4]
    vmovd dword ptr [rdx + rcx*4], xmm0
    inc ecx
    cmp ecx, dword ptr [rsp + 32]
    jb gather_slot
    jmp gather
gather_one:
    cmp ecx, dword ptr [rsp + 8]
    jae gathered_b
    mov eax, dword ptr [r11 + rcx*4]
    vmovd xmm0, dword ptr [rbx + rax*4]
    vmovd dword ptr [rsi + rcx*4], xmm0
    vmovd xmm0, dword ptr [rdi + rax*4]
    vmovd dword ptr [rbp + rcx*4], xmm0
    vmovd xmm0, dword ptr [r8 + rax*4]
    vmovd dword ptr [r9 + rcx*4], xmm0
    vmovd xmm0, dword ptr [r10 + rax*4]
    vmovd dword ptr [r12 + rcx*4], xmm0
    vmovd xmm0, dword ptr [r13 + rax*4]
    vmovd dword ptr [r14 + rcx*4], xmm0
    vmovd xmm0, dword ptr [r15 + rax*4]
    vmovd dword ptr [rdx + rcx*4], xmm0
    inc ecx
    jmp gather_one
gathered_b:
    vzeroupper
    ; fused: the band's interior rows (lo + 1 .. lo + 6) need only the band's
    ; own rows, which this thread has just written: separate and integrate
    ; them now, while they are in its cache
    cmp grid_fuse_now, 0
    je not_fused
    mov eax, dword ptr [rsp + 24]      ; lo cell
    mov rsi, sim_cell_arr
    mov ecx, dword ptr [rsi + rax*4 + 4 + GRID_DIM * 4]         ; start of row lo + 1
    mov edx, dword ptr [rsi + rax*4 + 4 + 7 * GRID_DIM * 4]     ; start of row lo + 7
    call sim_separate_v4
    ; Boundary rows. The two rows either side of a boundary between bands
    ; need only those two bands. Each band, when finished, publishes its
    ; stamp with a locked exchange (a full fence), then claims (lock cmpxchg)
    ; each boundary whose other band is finished too and separates its rows:
    ; of two neighbours, the later one always sees the earlier one done, and
    ; only one claim succeeds. No pass over the edges, no barrier for them.
    mov eax, dword ptr [rsp + 24]
    shr eax, BAND_SHIFT
    mov dword ptr [rsp + 32], eax      ; band
    mov rsi, sim_cell_start
    test eax, eax
    jnz not_first
        mov ecx, dword ptr [rsi]                       ; band 0: row 0 has no row below
        mov edx, dword ptr [rsi + GRID_DIM * 4]
        call sim_separate_v4
    not_first:
    cmp dword ptr [rsp + 32], GRID_BANDS - 1
    jne not_last
        mov rsi, sim_cell_start                        ; the last band: row 1023 has no row above
        mov ecx, dword ptr [rsi + (GRID_CELLS - GRID_DIM) * 4]
        mov edx, dword ptr [rsp + 8]
        call sim_separate_v4
    not_last:
    mov eax, grid_build_id
    mov ecx, dword ptr [rsp + 32]
    lea rdx, band_done
    xchg dword ptr [rdx + rcx*4], eax  ; publish (xchg with memory is locked)
    ; the boundary below: rows lo - 1 and lo
    mov eax, dword ptr [rsp + 32]
    test eax, eax
    jz below_done
    lea rdx, band_done
    mov ecx, dword ptr [rdx + rax*4 - 4]
    cmp ecx, grid_build_id
    jne below_done
    lea rdx, edge_claim
    xor eax, eax
    mov ecx, 1
    mov r8d, dword ptr [rsp + 32]
    lock cmpxchg dword ptr [rdx + r8*4], ecx
    jnz below_done
    mov rsi, sim_cell_start
    mov eax, dword ptr [rsp + 24]
    mov ecx, dword ptr [rsi + rax*4 - GRID_DIM * 4]  ; start of row lo - 1
    mov edx, dword ptr [rsi + rax*4 + GRID_DIM * 4]  ; start of row lo + 1
    call sim_separate_v4
below_done:
    ; the boundary above: rows lo + 7 and lo + 8
    mov eax, dword ptr [rsp + 32]
    cmp eax, GRID_BANDS - 1
    je above_done
    lea rdx, band_done
    mov ecx, dword ptr [rdx + rax*4 + 4]
    cmp ecx, grid_build_id
    jne above_done
    lea rdx, edge_claim
    xor eax, eax
    mov ecx, 1
    mov r8d, dword ptr [rsp + 32]
    lock cmpxchg dword ptr [rdx + r8*4 + 4], ecx
    jnz above_done
    mov rsi, sim_cell_start
    mov eax, dword ptr [rsp + 24]
    mov ecx, dword ptr [rsi + rax*4 + 7 * GRID_DIM * 4]  ; start of row lo + 7
    mov edx, dword ptr [rsi + rax*4 + 9 * GRID_DIM * 4]  ; start of row lo + 9
    call sim_separate_v4
above_done:
not_fused:
    add rsp, 72
    pop rbp
    pop r15
    pop r14
    pop r13
    pop r12
    pop rdi
    pop rsi
    pop rbx
    ret
}

; Inside grid_band_job's merge (its frame: k at [rsp + 8 + 40]): emit mover k
; to slot rbx, advance k and its key in rsi. r13: the sorted storage indices,
; r14: their keys, r15d: the movers' count.
merge_emit_mover: proc() = {
    mov edx, dword ptr [rsp + 48]      ; k (the caller's [rsp + 40])
    mov ecx, dword ptr [r13 + rdx*4]   ; storage index
    mov r11, sim_pos_x
    vmovd xmm0, dword ptr [r11 + rcx*4]
    mov r11, sim_pos_x2
    vmovd dword ptr [r11 + rbx*4], xmm0
    mov r11, sim_pos_z
    vmovd xmm0, dword ptr [r11 + rcx*4]
    mov r11, sim_pos_z2
    vmovd dword ptr [r11 + rbx*4], xmm0
    mov r11, sim_vel_x
    vmovd xmm0, dword ptr [r11 + rcx*4]
    mov r11, sim_vel_x2
    vmovd dword ptr [r11 + rbx*4], xmm0
    mov r11, sim_vel_z
    vmovd xmm0, dword ptr [r11 + rcx*4]
    mov r11, sim_vel_z2
    vmovd dword ptr [r11 + rbx*4], xmm0
    mov r11, sim_hp
    vmovd xmm0, dword ptr [r11 + rcx*4]
    mov r11, sim_hp2
    vmovd dword ptr [r11 + rbx*4], xmm0
    mov r11, sim_seq
    vmovd xmm0, dword ptr [r11 + rcx*4]
    mov r11, sim_seq2
    vmovd dword ptr [r11 + rbx*4], xmm0
    mov rax, rsi
    shr rax, 32
    mov r11, sim_slot_cell2
    mov dword ptr [r11 + rbx*4], eax
    inc ebx
    inc edx
    mov dword ptr [rsp + 48], edx
    mov rsi, MERGE_NONE
    cmp edx, r15d
    jae done
    mov rsi, qword ptr [r14 + rdx*8]
done:
    ret
}

; r8d: band. The band's first and last rows, after every band is built.
grid_edge_job: proc(begin: u32, end: u32, band: u32) = {
    push rbx
    push rsi
    push rdi
    sub rsp, 32                        ; 8 + 24 + 32 = 64
    mov edi, r8d                       ; band
    mov ebx, r8d
    shl ebx, BAND_SHIFT                ; lo cell
    mov rsi, sim_cell_start
    lea rax, edge_claim
    cmp dword ptr [rax + rdi*4], 0
    jne bottom_done                    ; done by this band's job
    mov ecx, dword ptr [rsi + rbx*4]
    mov edx, dword ptr [rsi + rbx*4 + GRID_DIM * 4]
    call sim_separate_v4
bottom_done:
    lea rax, edge_claim
    cmp dword ptr [rax + rdi*4 + 4], 0
    jne top_done                       ; done by the next band's job
    mov ecx, dword ptr [rsi + rbx*4 + 7 * GRID_DIM * 4]
    mov edx, dword ptr [rsi + rbx*4 + BAND_CELLS * 4]
    call sim_separate_v4
top_done:
    add rsp, 32
    pop rdi
    pop rsi
    pop rbx
    ret
}

; The whole grid build on the pool.
grid_stage_cyc: [4]u64 = {}

; rdtsc into rax
grid_stamp: proc() = {
    rdtsc
    shl rdx, 32
    or rax, rdx
    ret
}

sim_grid_mt: proc() = {
    push rbx
    push rsi
    push rdi
    sub rsp, 32                        ; 8 + 24 + 32 = 64
    call grid_stamp
    mov qword ptr [rsp + 24], rax
    mov eax, sim_count
    mov grid_old_count, eax
    ; a fused build works on the columns it is building
    mov rax, sim_pos_x2
    mov fz_src_x, rax
    mov rax, sim_pos_z2
    mov fz_src_z, rax
    mov rax, sim_vel_x2
    mov fz_vel_x, rax
    mov rax, sim_vel_z2
    mov fz_vel_z, rax
    mov rax, sim_pos3_x
    mov fz_out_x, rax
    mov rax, sim_pos3_z
    mov fz_out_z, rax
    mov rax, sim_cell2
    mov fz_cell, rax
    mov rax, sim_slot_cell2
    mov fz_slot_cell, rax
    ; rows anyone can have moved since the last build (a cell is 2 m)
    vmovd xmm0, grid_maxdisp
    vmulss xmm0, xmm0, k_disp_rows
    vcvttss2si eax, xmm0
    inc eax
    mov grid_d_rows, eax
    mov grid_maxdisp, 0
    ; the windowed sweep when the last build's order is a good start: few
    ; spawns since, small moves; else the full binned build
    mov grid_windowed, 0
    cmp grid_fuse, 0
    je full_build
    mov eax, grid_built_n
    test eax, eax
    jz full_build
    mov ecx, sim_count
    sub ecx, eax
    cmp ecx, WINDOW_MAX_TAIL
    ja full_build
    cmp grid_d_rows, WINDOW_MAX_ROWS
    ja full_build
    mov grid_windowed, 1
    inc grid_windowed_ticks
    ; this build's members and movers per band, counted by the last tick's
    ; integration, deaths and spawns
    xor ecx, ecx
take_counts:
    lea rax, next_band_total
    mov edx, dword ptr [rax + rcx*4]
    lea rax, band_total
    mov dword ptr [rax + rcx*4], edx
    lea rax, next_mov_total
    mov edx, dword ptr [rax + rcx*4]
    lea rax, mov_band_total
    mov dword ptr [rax + rcx*4], edx
    inc ecx
    cmp ecx, GRID_BANDS
    jb take_counts
    ; band bases and mover lists from the window counts
    xor edx, edx
    xor esi, esi
    xor ebx, ebx
    xor r10d, r10d
win_offsets:
    lea rax, band_offset
    mov dword ptr [rax + rbx*4], edx
    lea rax, band_total
    mov eax, dword ptr [rax + rbx*4]
    add edx, eax
    cmp eax, r10d
    cmova r10d, eax
    lea rax, mov_band_off
    mov dword ptr [rax + rbx*4], esi
    lea rax, mov_band_total
    add esi, dword ptr [rax + rbx*4]
    inc ebx
    cmp ebx, GRID_BANDS
    jb win_offsets
    mov grid_live, edx
    mov grid_fuse_now, 0
    shl r10d, 5
    cmp r10d, edx
    ja win_fuse_decided
    mov grid_fuse_now, 1
win_fuse_decided:
    jmp bands_ready
full_build:
    mov rcx, grid_bin_job&
    mov edx, sim_count
    mov r8d, BIN_CHUNK
    call pool_dispatch
    ; offsets: band-major, chunk-minor
    mov eax, sim_count
    add eax, BIN_CHUNK - 1
    shr eax, 14                        ; chunks used
    mov edi, eax
    xor edx, edx                       ; running
    xor ebx, ebx                       ; band
    xor r10d, r10d                     ; the fullest band
    lea r8, bin_hist
    lea r9, bin_off
bands:
    lea rax, band_offset
    mov dword ptr [rax + rbx*4], edx
    mov esi, edx
    xor ecx, ecx                       ; chunk
    mov eax, ebx                       ; index = chunk * GRID_BANDS + band
chunks:
    cmp ecx, edi
    jae chunks_done
    mov dword ptr [r9 + rax*4], edx
    add edx, dword ptr [r8 + rax*4]
    add eax, GRID_BANDS
    inc ecx
    jmp chunks
chunks_done:
    mov eax, edx
    sub eax, esi
    lea rcx, band_total
    mov dword ptr [rcx + rbx*4], eax
    cmp eax, r10d
    cmova r10d, eax
    inc ebx
    cmp ebx, GRID_BANDS
    jb bands
    mov grid_live, edx                 ; the survivors: the new population
    ; fuse per band only when no band holds more than 1/32 of everyone: a dense
    ; crowd fills a few bands, and per-band work would sit on a few threads
    mov grid_fuse_now, 0
    cmp grid_fuse, 0
    je fuse_decided
    shl r10d, 5
    cmp r10d, edx
    ja fuse_decided
    mov grid_fuse_now, 1
fuse_decided:
    ; the movers' lists, the same way
    xor edx, edx
    xor ebx, ebx
    lea r8, mov_hist
    lea r9, mov_off
mbands:
    lea rax, mov_band_off
    mov dword ptr [rax + rbx*4], edx
    mov esi, edx
    xor ecx, ecx
    mov eax, ebx
mchunks:
    cmp ecx, edi
    jae mchunks_done
    mov dword ptr [r9 + rax*4], edx
    add edx, dword ptr [r8 + rax*4]
    add eax, GRID_BANDS
    inc ecx
    jmp mchunks
mchunks_done:
    mov eax, edx
    sub eax, esi
    lea rcx, mov_band_total
    mov dword ptr [rcx + rbx*4], eax
    inc ebx
    cmp ebx, GRID_BANDS
    jb mbands
    call grid_stamp
    mov rcx, rax
    sub rcx, qword ptr [rsp + 24]
    add grid_stage_cyc[0], rcx
    mov qword ptr [rsp + 24], rax
    mov rcx, grid_bucket_job&
    mov edx, sim_count
    mov r8d, BIN_CHUNK
    call pool_dispatch
    call grid_stamp
    mov rcx, rax
    sub rcx, qword ptr [rsp + 24]
    add grid_stage_cyc[8], rcx
    mov qword ptr [rsp + 24], rax
bands_ready:
    inc grid_build_id
    xor eax, eax
    lea rdi, edge_claim
    mov ecx, GRID_BANDS + 1
    rep stosd
    ; this build's integration counts for the next one
    xor eax, eax
    lea rdi, next_band_total
    mov ecx, GRID_BANDS
    rep stosd
    lea rdi, next_mov_total
    mov ecx, GRID_BANDS
    rep stosd
    mov rcx, grid_band_job&
    mov edx, GRID_BANDS
    mov r8d, 1
    call pool_dispatch
    call grid_stamp
    mov rcx, rax
    sub rcx, qword ptr [rsp + 24]
    add grid_stage_cyc[16], rcx
    mov eax, grid_live
    mov sim_count, eax
    mov sim_alive, eax
    mov grid_built_n, eax
    ; the end of the last cell
    mov rax, sim_cell_arr
    mov edx, sim_count
    mov ecx, GRID_CELLS + 1
    mov dword ptr [rax + rcx*4], edx
    ; the grid-ordered columns become the live ones; the sorted views are them
    mov rax, sim_pos_x
    mov rcx, sim_pos_x2
    mov sim_pos_x, rcx
    mov sim_pos_x2, rax
    mov rax, sim_pos_z
    mov rcx, sim_pos_z2
    mov sim_pos_z, rcx
    mov sim_pos_z2, rax
    mov rax, sim_vel_x
    mov rcx, sim_vel_x2
    mov sim_vel_x, rcx
    mov sim_vel_x2, rax
    mov rax, sim_vel_z
    mov rcx, sim_vel_z2
    mov sim_vel_z, rcx
    mov sim_vel_z2, rax
    mov rax, sim_hp
    mov rcx, sim_hp2
    mov sim_hp, rcx
    mov sim_hp2, rax
    mov rax, sim_seq
    mov rcx, sim_seq2
    mov sim_seq, rcx
    mov sim_seq2, rax
    mov rax, sim_slot_cell
    mov rcx, sim_slot_cell2
    mov sim_slot_cell, rcx
    mov sim_slot_cell2, rax
    cmp grid_fuse, 0
    je unfused
    cmp grid_fuse_now, 0
    je by_slots
    ; (every boundary was claimed by one of its two bands)
    jmp separated
by_slots:
    ; a dense crowd: separation over chunks of slots, on every thread
    mov rcx, sim_separate_v4&
    mov edx, sim_count
    mov r8d, 2048
    call pool_dispatch
separated:
    ; the integrated positions become the live ones
    mov rax, sim_pos_x
    mov rcx, sim_pos3_x
    mov sim_pos_x, rcx
    mov sim_pos3_x, rax
    mov rax, sim_pos_z
    mov rcx, sim_pos3_z
    mov sim_pos_z, rcx
    mov sim_pos3_z, rax
    ; and its cells are the next build's
    mov rax, sim_cell
    mov rcx, sim_cell2
    mov sim_cell, rcx
    mov sim_cell2, rax
unfused:
    mov rax, sim_pos_x
    mov sim_sorted_x, rax
    mov rax, sim_pos_z
    mov sim_sorted_z, rax
    mov rax, sim_identity
    mov sim_sorted_id, rax
    add rsp, 32
    pop rdi
    pop rsi
    pop rbx
    ret
}
