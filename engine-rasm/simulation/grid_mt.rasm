; simulation/grid_mt.rasm: storage into grid order, binned by band, for threads
;
; The live columns (pos, vel, hp, seq) are kept in grid order: sorted by cell,
; then by creation sequence, which is the spec's index order. Each tick they
; are permuted into the new cells' order (mostly the identity: few entities
; change cell in a tick, so every pass streams memory in order), and the sorted
; views (sim_sorted_x/z/id) are the live columns themselves, ids the identity.
;
; The rebuild is incremental. Storage is sorted by (old cell, seq): the old
; cells are the last build's cell starts, and no column holds them. sim_cell
; holds each slot's new cell with bit 31 set when it differs from the old one
; (the fused integration knows: a slot's old cell is its start position's;
; spawns are set, the dead are -1). An entity whose cell did not change (a
; stayer) keeps its place relative to the other stayers of its cell, so only
; the movers need placing:
;
;   bin       (chunks)      cell[i] (-1 for the dead, who are left behind),
;                           bit 31 against the old cell (a cursor over the
;                           last build's starts); per chunk, a histogram of
;                           bands for everyone alive and one for movers
;   offsets   (main)        exclusive prefixes, band-major then chunk: band
;                           bases and mover-list offsets
;   bucket    (chunks)      the movers' storage indices, grouped by band
;   band      (per band)    the band's old slot range (read from the last
;                           build's starts before the jobs); count stayers
;                           and movers per cell;
;                           prefix from the band's base; stayers placed
;                           (descending, so they end each cell's run, in
;                           order); movers placed ahead of them; each mover
;                           slides forward into its cell's run by sequence;
;                           then the live columns are gathered slot by slot
;
; The result is sorted by (cell, seq) exactly as a full sort would be (the
; self test against sim_grid and every reference hash check it), and a tick's
; work is a sequential pass plus work in proportion to the movers.

; the band shape (rows per band, and what follows from it)
#define BAND_ROWS 4
#define BAND_ROW_SHIFT 2
#define BAND_SHIFT 12
#define BAND_CELLS 4096
#define GRID_BANDS 256
#define GRID_BANDS_1 257
#define GRID_BANDS_2 512
; a bin histogram row is GRID_BANDS u32: 1 << BAND_TABLE_SHIFT bytes
#define BAND_TABLE_SHIFT 10
; BIN_CHUNKS * GRID_BANDS
#define BIN_HIST_N 16384
#define BIN_CHUNK 16384
#define BIN_CHUNKS 64

band_total: [GRID_BANDS]u32 = {}
grid_live: u32 = 0
band_offset: [GRID_BANDS]u32 = {}
bin_hist: [BIN_HIST_N]u32[align(64)] = {}    ; [chunk * GRID_BANDS + band]
bin_off: [BIN_HIST_N]u32[align(64)] = {}
sim_band_ids: *u32 = 0                  ; the movers by band: (storage index, then slot; new cell) pairs
mov_hist: [BIN_HIST_N]u32[align(64)] = {}     ; movers: [chunk * GRID_BANDS + band]
mov_off: [BIN_HIST_N]u32[align(64)] = {}
mov_band_off: [GRID_BANDS]u32 = {}
mov_band_total: [GRID_BANDS]u32 = {}
grid_old_count: u32 = 0                 ; storage at the start of the build
grid_fuse: u32 = 0                      ; 1: also separate and integrate (sim_step)
grid_fuse_now: u32 = 0                  ; this build fuses per band (the population is spread out)
grid_windowed_ticks: u32 = 0
grid_windowed: u32 = 0                  ; this build counts from row windows (no bin, no bucket)
grid_count_error: u32 = 0
grid_build_id: u32 = 0                  ; this build's stamp
band_done: [GRID_BANDS]u32 = {}         ; the stamp of the build that last finished each band
edge_claim: [GRID_BANDS_1]u32 = {}               ; [b]: the rows at the boundary below band b are done
#define MERGE_FEW 256
#define MERGE_NONE 0x7FFFFFFFFFFFFFFF
k_shift1: [8]const u32[align(32)] = { 0, 0, 1, 2, 3, 4, 5, 6 }
sim_mcount: *u32 = 0                    ; GRID_CELLS: per band region, the movers' cell starts
sim_mkey: *u64 = 0                      ; MAX_ENTITIES: the sorted movers' keys
k_bcast3: [8]const u32[align(32)] = { 3, 3, 3, 3, 3, 3, 3, 3 }
k_bcast7: [8]const u32[align(32)] = { 7, 7, 7, 7, 7, 7, 7, 7 }
k_upper_half: [8]const u32[align(32)] = { 0, 0, 0, 0, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF }
band_old_lo: [GRID_BANDS_1]u32 = {}   ; per band: its first slot in the last build ([GRID_BANDS]: their end)
band_win: [GRID_BANDS_2]u32 = {}      ; per band: its window's slots in the last build (windowed)
grid_built_n: u32 = 0                   ; slots sorted by the last build; spawns follow them
grid_d_rows: u32 = 0                    ; rows any entity can have moved since the last build
k_disp_rows: const f32 = 0.5            ; a cell is 2 m
#define WINDOW_MAX_ROWS 4
#define WINDOW_MAX_TAIL 4096
sim_pos3_x: *f32 = 0                    ; the integrated positions of a fused build
sim_pos3_z: *f32 = 0
sim_slot_cell2: *u32 = 0                ; a full build's scratch: the cell of each output slot

; ecx: begin, edx: end (entities; begin a multiple of 8), r8d: chunk
grid_bin_job: proc(begin: u32, end: u32, chunk: u32) = {
    push rbx
    push rsi
    push rdi
    push r12
    push r13
    push r14
    mov ebx, ecx                       ; begin
    mov edi, edx                       ; end
    ; this chunk's histogram row, zeroed
    mov eax, r8d
    shl eax, BAND_TABLE_SHIFT          ; chunk * GRID_BANDS * 4
    lea rsi, bin_hist
    add rsi, rax
    lea r11, mov_hist
    add r11, rax
    vpxor ymm0, ymm0, ymm0
    xor eax, eax
zero:
    vmovdqa ymmword ptr [rsi + rax], ymm0
    vmovdqa ymmword ptr [r11 + rax], ymm0
    add eax, 32
    cmp eax, GRID_BANDS * 4
    jb zero
    ; cells, 8 at a time
    mov r8, sim_pos_x
    mov r9, sim_pos_z
    mov r10, sim_cell
    vmovaps ymm4, ymmword ptr k_world_half
    vmovaps ymm5, ymmword ptr k_inv_cell
    mov eax, ebx
    mov edx, edi
    sub edx, ebx
    add edx, 7
    shr edx, 3                         ; blocks
    shl rax, 2
    test edx, edx
    jz cells_done
cells:
    vaddps ymm0, ymm4, ymmword ptr [r8 + rax]
    vmulps ymm0, ymm0, ymm5
    vcvttps2dq ymm0, ymm0
    vaddps ymm1, ymm4, ymmword ptr [r9 + rax]
    vmulps ymm1, ymm1, ymm5
    vcvttps2dq ymm1, ymm1
    vpslld ymm1, ymm1, GRID_SHIFT
    vpaddd ymm0, ymm0, ymm1
    vmovdqa ymmword ptr [r10 + rax], ymm0
    add rax, 32
    dec edx
    jnz cells
cells_done:
    vzeroupper
    ; band histogram (the cells are still in L1/L2); the dead of the last
    ; tick get no cell and are left behind
    ; each slot's old cell: a cursor over the last build's cell starts
    ; (arr[c + 1]: the start of cell c), r12d the cell, r13d the start of the
    ; next; slots from grid_built_n on are spawns since (no old cell)
    mov r9, sim_cell_arr
    xor r12d, r12d
    mov edx, GRID_CELLS
    cmp ebx, grid_built_n
    jae cursor_set
search:
    mov ecx, edx
    sub ecx, r12d
    cmp ecx, 1
    jbe cursor_set
    shr ecx, 1
    add ecx, r12d
    cmp dword ptr [r9 + rcx*4 + 4], ebx
    ja search_left
    mov r12d, ecx
    jmp search
search_left:
    mov edx, ecx
    jmp search
cursor_set:
    mov r13d, dword ptr [r9 + r12*4 + 8]
    mov r8, sim_hp
    mov r14, sim_seq
    vxorps xmm1, xmm1, xmm1
    mov eax, ebx
count:
    cmp eax, edi
    jae counted
    mov edx, dword ptr [r14 + rax*4]
    and edx, 0x3FFFFFFF
    vmovss xmm0, dword ptr [r8 + rdx*4]            ; (hp at the sequence number)
    vcomiss xmm0, xmm1
    jbe dead
    mov edx, dword ptr [r10 + rax*4]
    mov ecx, edx
    shr edx, BAND_SHIFT
    inc dword ptr [rsi + rdx*4]
    cmp eax, grid_built_n
    jae mover
walk:
    cmp eax, r13d
    jb walked
    inc r12d
    mov r13d, dword ptr [r9 + r12*4 + 8]
    jmp walk
walked:
    cmp ecx, r12d
    je stayer
mover:
    inc dword ptr [r11 + rdx*4]        ; a mover (or a spawn)
    or dword ptr [r10 + rax*4], 0x80000000
stayer:
    inc eax
    jmp count
dead:
    mov dword ptr [r10 + rax*4], -1
    inc eax
    jmp count
counted:
    pop r14
    pop r13
    pop r12
    pop rdi
    pop rsi
    pop rbx
    ret
}

; ecx: begin, edx: end, r8d: chunk. The chunk's movers into the movers lists.
grid_bucket_job: proc(begin: u32, end: u32, chunk: u32) = {
    push rsi
    mov eax, r8d
    shl eax, BAND_TABLE_SHIFT
    lea rsi, mov_off
    add rsi, rax
    mov r10, sim_cell
    mov r9, sim_band_ids
bucket:
    cmp ecx, edx
    jae done
    mov eax, dword ptr [r10 + rcx*4]
    cmp eax, -1
    je skip                            ; dead
    test eax, eax
    jns skip                           ; a stayer (bit 31 clear)
    and eax, 0x7FFFFFFF
    mov r8d, eax
    shr eax, BAND_SHIFT
    mov r11d, dword ptr [rsi + rax*4]
    mov dword ptr [r9 + r11*8], ecx
    mov dword ptr [r9 + r11*8 + 4], r8d
    inc r11d
    mov dword ptr [rsi + rax*4], r11d
skip:
    inc ecx
    jmp bucket
done:
    pop rsi
    ret
}

; ecx: a storage slot -> eax: the cell of its position. Clobbers rdx, xmm0, xmm1.
cell_of_slot: proc() = {
    mov rax, sim_pos_x
    vmovss xmm0, dword ptr [rax + rcx*4]
    vaddss xmm0, xmm0, k_world_half[0]
    vmulss xmm0, xmm0, k_inv_cell[0]
    vcvttss2si eax, xmm0
    mov rdx, sim_pos_z
    vmovss xmm1, dword ptr [rdx + rcx*4]
    vaddss xmm1, xmm1, k_world_half[0]
    vmulss xmm1, xmm1, k_inv_cell[0]
    vcvttss2si edx, xmm1
    shl edx, GRID_SHIFT
    add eax, edx
    ret
}

; ecx: a slot among a band's old slots, edx: its new cell (bit 31 clear; any
; value for the dead), r9d: the band's first cell, rsi: sim_cell_arr (the
; last build's starts, arr[c + 1]), r11d: the end of the band's old slots ->
; eax: the slot's old cell. A cell changer almost always comes from a
; neighbour of its new cell: those eight go first (a check of the slot
; against the cell's old slots, exact), then a binary search over the band's
; cells. Clobbers rdx, r10.
k_cell_near: [8]const u32 = { 0xFFFFFFFF, 1, 0xFFFFFC00, 0x400, 0xFFFFFBFF, 0xFFFFFC01, 0x3FF, 0x401 }
old_cell_of: proc() = {
    push rbx
    push rdi
    lea rbx, k_cell_near
    xor edi, edi
near:
    mov eax, edx
    add eax, dword ptr [rbx + rdi*4]
    mov r10d, eax
    sub r10d, r9d
    cmp r10d, BAND_CELLS
    jae next_near                      ; not one of the band's cells
    cmp dword ptr [rsi + rax*4 + 4], ecx
    ja next_near                       ; it starts after the slot
    cmp r10d, BAND_CELLS - 1
    je last_cell
    cmp dword ptr [rsi + rax*4 + 8], ecx
    ja found                           ; and the next one after it
    jmp next_near
last_cell:
    cmp r11d, ecx
    ja found
next_near:
    inc edi
    cmp edi, 8
    jb near
    ; the band's last cell starting at or before the slot
    mov eax, r9d
    lea r10d, [r9 + BAND_CELLS]
search:
    mov edi, r10d
    sub edi, eax
    cmp edi, 1
    jbe found
    shr edi, 1
    add edi, eax
    cmp dword ptr [rsi + rdi*4 + 4], ecx
    ja search_left
    mov eax, edi
    jmp search
search_left:
    mov r10d, edi
    jmp search
found:
    pop rdi
    pop rbx
    ret
}

; r8d: band. The band's entities into grid order, in the spare columns.
grid_band_job: proc(begin: u32, end: u32, band: u32) = {
    push rbx
    push rsi
    push rdi
    push r12
    push r13
    push r14
    push r15
    push rbp
    sub rsp, 104                       ; [rsp] base, [+4] n, [+8] end, [+12] old lo, [+16] old hi, [+24] lo cell, [+40..] the merge's state, [+64] participant, [+72] a block's cells
    mov dword ptr [rsp + 64], r9d
    mov ebx, r8d
    mov r9d, ebx
    shl r9d, BAND_SHIFT                ; lo cell
    mov dword ptr [rsp + 24], r9d
    mov rsi, sim_cell_arr
    ; zero arr[lo + 1 .. lo + BAND_CELLS] (and arr[0] for band 0); a windowed
    ; build keeps them: they are the last build's cell starts, its counts' source
    cmp grid_windowed, 0
    jne zeroed
    lea rdi, [rsi + r9*4 + 4]
    xor eax, eax
    mov ecx, BAND_CELLS
    rep stosd
    test ebx, ebx
    jnz zeroed
        mov dword ptr [rsi], 0
    zeroed:
    lea rax, band_offset
    mov r12d, dword ptr [rax + rbx*4]  ; base
    lea rax, band_total
    mov r13d, dword ptr [rax + rbx*4]  ; n
    mov dword ptr [rsp], r12d
    mov dword ptr [rsp + 4], r13d
    lea eax, [r12 + r13]
    mov dword ptr [rsp + 8], eax
    ; the band's old slots: old cell in [lo, lo + BAND_CELLS), from the last
    ; build's cell starts (sim_grid_mt read them before any band job ran)
    lea rax, band_old_lo
    mov ecx, dword ptr [rax + rbx*4]
    mov dword ptr [rsp + 12], ecx
    mov ecx, dword ptr [rax + rbx*4 + 4]
    mov dword ptr [rsp + 16], ecx
    ; the band's movers
    lea rax, mov_band_off
    mov edx, dword ptr [rax + rbx*4]
    mov rbp, sim_band_ids
    lea rbp, [rbp + rdx*8]
    lea rax, mov_band_total
    mov r15d, dword ptr [rax + rbx*4]
    mov r8, sim_cell
    cmp grid_windowed, 0
    je full_counts
    ; windowed: the movers come from the band's old rows widened by the
    ; largest move (sim_grid_mt found their slots), and from the spawns after
    ; the sorted slots, ascending
    lea rax, band_win
    mov ecx, dword ptr [rax + rbx*8]
    mov edx, dword ptr [rax + rbx*8 + 4]
    mov dword ptr [rsp + 36], edx      ; the window's end
    ; the old cell sizes first, from the last build's starts, into this
    ; participant's scratch (its fz_buf, free until the separation): the
    ; starts stay intact for the leavers' old cells, and the pass below takes
    ; the leavers out of the sizes. r14: the counts, [r14 + cell * 4].
    mov eax, dword ptr [rsp + 64]
    shl rax, FZ_PART_SHIFT
    mov r14, fz_buf
    add r14, rax
    mov rdx, r14
    mov eax, r9d
    shl rax, 2
    sub r14, rax
    lea rdi, [rsi + r9*4 + 4]
    mov eax, BAND_CELLS / 8 - 1
win_sizes:
    vmovdqu ymm0, ymmword ptr [rdi]
    vmovdqu ymm1, ymmword ptr [rdi + 4]
    vpsubd ymm1, ymm1, ymm0
    vmovdqu ymmword ptr [rdx], ymm1
    add rdi, 32
    add rdx, 32
    dec eax
    jnz win_sizes
    vmovdqu ymm0, ymmword ptr [rdi]
    vmovdqu ymm1, ymmword ptr [rdi + 4]
    vmovd xmm2, dword ptr [rsp + 16]
    vpbroadcastd ymm2, xmm2
    vpblendd ymm1, ymm1, ymm2, 0x80
    vpsubd ymm1, ymm1, ymm0
    vmovdqu ymmword ptr [rdx], ymm1
    ; one pass over the window, 8 slots per step: movers into the band (cell
    ; changed, sequence bit 31, not dead, bit 30, and the new cell, from the
    ; position, in the band) are listed; leavers (changed or dead, from the
    ; band's old slots) leave their old cell's count (old_cell_of finds their
    ; old cells in the last build's starts).
    mov r8, sim_seq
    vmovd xmm5, r9d
    vpbroadcastd ymm5, xmm5            ; lo
    vpcmpeqd ymm4, ymm4, ymm4
    vpsrld ymm4, ymm4, 32 - BAND_SHIFT ; BAND_CELLS - 1
    xor edi, edi
collect_window:
    mov eax, dword ptr [rsp + 36]
    sub eax, ecx
    jbe collected_window
    mov edx, 255
    cmp eax, 8
    jae win_full
        bzhi edx, edx, eax
    win_full:
    mov dword ptr [rsp + 20], edx      ; valid lanes
    vmovdqu ymm0, ymmword ptr [r8 + rcx*4]         ; sequences
    vmovmskps r10d, ymm0                           ; changed cell
    vpslld ymm0, ymm0, 1
    vmovmskps r13d, ymm0                           ; dead
    ; lanes in the band's old slots [old lo, old hi): all of them or none,
    ; but for the two blocks at its ends
    mov r11d, edx
    mov eax, ecx
    cmp eax, dword ptr [rsp + 12]
    jb range_below
    add eax, 8
    cmp eax, dword ptr [rsp + 16]
    jbe range_done                     ; wholly inside
    cmp ecx, dword ptr [rsp + 16]
    jb range_edge
    xor r11d, r11d                     ; wholly above
    jmp range_done
range_below:
    add eax, 8
    cmp eax, dword ptr [rsp + 12]
    ja range_edge
    xor r11d, r11d                     ; wholly below
    jmp range_done
range_edge:
    mov eax, dword ptr [rsp + 16]
    sub eax, ecx
    jns hi_pos
    xor eax, eax
    hi_pos:
    cmp eax, 8
    jbe hi_in
    mov eax, 8
    hi_in:
    mov r11d, 255
    bzhi r11d, r11d, eax
    mov eax, dword ptr [rsp + 12]
    sub eax, ecx
    jns lo_pos
    xor eax, eax
    lo_pos:
    cmp eax, 8
    jbe lo_in
    mov eax, 8
    lo_in:
    mov edx, 255
    bzhi edx, edx, eax
    andn r11d, edx, r11d
    mov edx, dword ptr [rsp + 20]
    and r11d, edx
range_done:
    mov rax, sim_pos_x
    vmovups ymm1, ymmword ptr [rax + rcx*4]
    vaddps ymm1, ymm1, ymmword ptr k_world_half
    vmulps ymm1, ymm1, ymmword ptr k_inv_cell
    vcvttps2dq ymm1, ymm1
    mov rax, sim_pos_z
    vmovups ymm2, ymmword ptr [rax + rcx*4]
    vaddps ymm2, ymm2, ymmword ptr k_world_half
    vmulps ymm2, ymm2, ymmword ptr k_inv_cell
    vcvttps2dq ymm2, ymm2
    vpslld ymm2, ymm2, GRID_SHIFT
    vpaddd ymm1, ymm1, ymm2                        ; cells
    vmovdqu ymmword ptr [rsp + 72], ymm1
    vpsubd ymm3, ymm1, ymm5
    vpminud ymm1, ymm3, ymm4
    vpcmpeqd ymm1, ymm1, ymm3                      ; cell in the band
    vmovmskps eax, ymm1
    and eax, r10d
    andn eax, r13d, eax
    and eax, edx                                   ; movers into the band
    or r10d, r13d
    and r10d, r11d
    mov edx, r10d                                  ; leavers
    test eax, eax
    jz win_no_movers
win_mover:
    tzcnt r13d, eax
    blsr eax, eax
    mov r10d, dword ptr [rsp + r13*4 + 72]
    add r13d, ecx
    mov dword ptr [rbp + rdi*8], r13d
    mov dword ptr [rbp + rdi*8 + 4], r10d
    inc edi
    test eax, eax
    jnz win_mover
win_no_movers:
    test edx, edx
    jz win_next
win_leaver:
    tzcnt r13d, edx
    blsr edx, edx
    push rcx
    push rdx
    mov edx, dword ptr [rsp + r13*4 + 72 + 16]  ; its new cell
    add ecx, r13d                      ; the slot
    mov r11d, dword ptr [rsp + 16 + 16]
    call old_cell_of
    dec dword ptr [r14 + rax*4]
    pop rdx
    pop rcx
    test edx, edx
    jnz win_leaver
win_next:
    add ecx, 8
    jmp collect_window
collected_window:
    vzeroupper
    mov ecx, grid_built_n
    mov edx, grid_old_count
collect_tail:
    cmp ecx, edx
    jae collected_tail
    test dword ptr [r8 + rcx*4], 0x40000000
    jnz next_tail                      ; dead
    push rdx
    call cell_of_slot
    pop rdx
    mov r13d, eax
    sub r13d, r9d
    cmp r13d, BAND_CELLS
    jae next_tail
    mov dword ptr [rbp + rdi*8], ecx
    mov dword ptr [rbp + rdi*8 + 4], eax
    inc edi
next_tail:
    inc ecx
    jmp collect_tail
collected_tail:
    cmp edi, r15d
    je counted_stay                    ; the stayers are counted: on to the movers
    mov grid_count_error, 1            ; the integration's counts disagree: a bug
    mov r15d, edi
    jmp counted_stay
full_counts:
    ; count stayers (new cell = old cell) and movers, in the counters
    lea r14, [rsi + 4]
    mov ecx, dword ptr [rsp + 12]
count_stay:
    cmp ecx, dword ptr [rsp + 16]
    jae counted_stay
    mov edx, dword ptr [r8 + rcx*4]
    test edx, edx
    js next_stay                       ; changed cell, or dead
    inc dword ptr [rsi + rdx*4 + 4]
next_stay:
    inc ecx
    jmp count_stay
counted_stay:
    vzeroupper
    xor ecx, ecx
count_move:
    cmp ecx, r15d
    jae counted_move
    mov eax, dword ptr [rbp + rcx*8 + 4]
    inc dword ptr [r14 + rax*4]
    inc ecx
    jmp count_move
counted_move:
    ; inclusive prefix from the band's base, 8 counters per step: within
    ; each 128-bit half by shifts, the low half's last into the high half,
    ; then the running total; the last becomes the next running total
    lea rdi, [rsi + r9*4 + 4]
    vmovd xmm1, r12d
    vpbroadcastd ymm1, xmm1
    vmovdqa ymm4, ymmword ptr k_bcast7
    vmovdqa ymm5, ymmword ptr k_bcast3
    vmovdqa ymm3, ymmword ptr k_upper_half
    xor eax, eax
    lea r11, [r14 + r9*4]              ; (windowed: the counts in the scratch)
    cmp grid_windowed, 0
    jne prefix_excl
prefix:
    vmovdqu ymm0, ymmword ptr [rdi + rax*4]
    vpslldq ymm2, ymm0, 4
    vpaddd ymm0, ymm0, ymm2
    vpslldq ymm2, ymm0, 8
    vpaddd ymm0, ymm0, ymm2
    vpermd ymm2, ymm5, ymm0
    vpand ymm2, ymm2, ymm3
    vpaddd ymm0, ymm0, ymm2
    vpaddd ymm0, ymm0, ymm1
    vmovdqu ymmword ptr [rdi + rax*4], ymm0
    vpermd ymm1, ymm4, ymm0
    add eax, 8
    cmp eax, BAND_CELLS
    jb prefix
    jmp prefixed
prefix_excl:
    ; (windowed: exclusive, the cells' starts directly)
    vmovdqu ymm0, ymmword ptr [r11 + rax*4]
    vpslldq ymm2, ymm0, 4
    vpaddd ymm0, ymm0, ymm2
    vpslldq ymm2, ymm0, 8
    vpaddd ymm0, ymm0, ymm2
    vpermd ymm2, ymm5, ymm0
    vpand ymm2, ymm2, ymm3
    vpaddd ymm0, ymm0, ymm2
    vpaddd ymm0, ymm0, ymm1
    vpsubd ymm2, ymm0, ymmword ptr [r11 + rax*4]   ; minus the counts: the starts
    vmovdqu ymmword ptr [rdi + rax*4], ymm2
    vpermd ymm1, ymm4, ymm0
    add eax, 8
    cmp eax, BAND_CELLS
    jb prefix_excl
prefixed:
    vzeroupper
    ; ---------------------------------------------------------------------
    ; windowed: the merge build. Stayers keep their old order, which is
    ; already (cell, seq) order; the movers, sorted by (cell, seq), are merged
    ; in. The output is written once, in order: no slot ids, no gather.
    cmp grid_windowed, 0
    je place_full
    ; A. (the prefix wrote the cells' starts)
    ; B. the movers by (cell, seq). Few movers: keys in list order, then one
    ; insertion sort. Many: counted per cell in the band's region of
    ; sim_mcount, placed by exclusive start, then insertion by seq in each cell
    lea rax, mov_band_off
    mov eax, dword ptr [rax + rbx*4]
    mov rdx, sim_slot_id
    lea r13, [rdx + rax*4]             ; S: the sorted movers' storage indices
    mov rdx, sim_mkey
    lea r14, [rdx + rax*8]             ; K: their keys (cell << 32 | seq)
    cmp r15d, MERGE_FEW
    jae many_movers
    mov r11, sim_seq
    xor ecx, ecx
few_keys:
    cmp ecx, r15d
    jae mplaced
    mov eax, dword ptr [rbp + rcx*8]
    mov dword ptr [r13 + rcx*4], eax
    mov edx, dword ptr [rbp + rcx*8 + 4]
    shl rdx, 32
    mov eax, dword ptr [r11 + rax*4]
    and eax, 0x3FFFFFFF
    or rdx, rax
    mov qword ptr [r14 + rcx*8], rdx
    inc ecx
    jmp few_keys
many_movers:
    mov r11, sim_mcount
    lea rdi, [r11 + r9*4]
    vpxor ymm0, ymm0, ymm0
    mov ecx, BAND_CELLS / 8
mzero:
    vmovdqu ymmword ptr [rdi], ymm0
    add rdi, 32
    dec ecx
    jnz mzero
    xor ecx, ecx
mcount:
    cmp ecx, r15d
    jae mcounted
    mov eax, dword ptr [rbp + rcx*8 + 4]
    inc dword ptr [r11 + rax*4]
    inc ecx
    jmp mcount
mcounted:
    ; exclusive prefix over the band's counters, 8 per step (as the band's
    ; cell starts: shifts within each half, the low half's last into the high)
    lea rdi, [r11 + r9*4]
    vpxor xmm1, xmm1, xmm1
    vmovdqa ymm4, ymmword ptr k_bcast7
    vmovdqa ymm5, ymmword ptr k_bcast3
    vmovdqa ymm3, ymmword ptr k_upper_half
    xor ecx, ecx
mprefix:
    vmovdqu ymm0, ymmword ptr [rdi + rcx*4]
    vpslldq ymm2, ymm0, 4
    vpaddd ymm0, ymm0, ymm2
    vpslldq ymm2, ymm0, 8
    vpaddd ymm0, ymm0, ymm2
    vpermd ymm2, ymm5, ymm0
    vpand ymm2, ymm2, ymm3
    vpaddd ymm0, ymm0, ymm2
    vpaddd ymm0, ymm0, ymm1
    vpsubd ymm2, ymm0, ymmword ptr [rdi + rcx*4]
    vmovdqu ymmword ptr [rdi + rcx*4], ymm2
    vpermd ymm1, ymm4, ymm0
    add ecx, 8
    cmp ecx, BAND_CELLS
    jb mprefix
    vzeroupper
    ; place into the sorted region (slot ids at the band's mover offset) with keys
    xor ecx, ecx
mplace:
    cmp ecx, r15d
    jae mplaced
    mov eax, dword ptr [rbp + rcx*8]   ; storage index
    mov edx, dword ptr [rbp + rcx*8 + 4]   ; cell
    mov edi, dword ptr [r11 + rdx*4]
    inc dword ptr [r11 + rdx*4]
    mov dword ptr [r13 + rdi*4], eax
    mov r10, sim_seq
    mov r10d, dword ptr [r10 + rax*4]
    and r10d, 0x3FFFFFFF
    shl rdx, 32
    or rdx, r10
    mov qword ptr [r14 + rdi*8], rdx
    inc ecx
    jmp mplace
mplaced:
    ; insertion by key (runs are per cell: short)
    mov ecx, 1
msort:
    cmp ecx, r15d
    jae msorted
    mov rdx, qword ptr [r14 + rcx*8]
    mov eax, dword ptr [r13 + rcx*4]
    mov edi, ecx
mshift:
    test edi, edi
    jz mput
    cmp qword ptr [r14 + rdi*8 - 8], rdx
    jbe mput
    mov r10, qword ptr [r14 + rdi*8 - 8]
    mov qword ptr [r14 + rdi*8], r10
    mov r10d, dword ptr [r13 + rdi*4 - 4]
    mov dword ptr [r13 + rdi*4], r10d
    dec edi
    jmp mshift
mput:
    mov qword ptr [r14 + rdi*8], rdx
    mov dword ptr [r13 + rdi*4], eax
    inc ecx
    jmp msort
msorted:
    ; C. merge the old range's stayers with the sorted movers
    mov ebx, dword ptr [rsp]           ; w: the next output slot
    mov r12d, dword ptr [rsp + 12]     ; i: the old block
    xor edx, edx                       ; k: the next mover
    mov dword ptr [rsp + 40], edx
    mov rsi, MERGE_NONE                ; the next mover's key (none: the largest signed key)
    test r15d, r15d
    jz merge_blocks
    mov rsi, qword ptr [r14]
merge_blocks:
    mov eax, dword ptr [rsp + 16]
    sub eax, r12d
    jbe merge_tail
    ; stayers of the block: neither changed cell nor dead (sequence bits 31,
    ; 30 clear), lanes before the old range's end
    mov r11, sim_seq
    vmovdqu ymm1, ymmword ptr [r11 + r12*4]
    vpslld ymm0, ymm1, 1
    vpor ymm0, ymm0, ymm1
    vmovmskps edi, ymm0
    xor edi, 255
    cmp eax, 8
    jae merge_full
        bzhi edi, edi, eax
    merge_full:
    test edi, edi
    jz merge_next
    ; the usual case: every stayer of the block goes before the next mover,
    ; with no keys. The output is the sorted order, written in order, so
    ; when the stayers fit before the start of the next mover's cell (arr is
    ; this build's starts now), nothing else can come between: no mover can
    ; go before that start, and the stayers are next in the old order.
    mov rdx, MERGE_NONE
    cmp rsi, rdx
    je all_go                          ; no mover left
    mov rdx, rsi
    shr rdx, 32
    mov r11, sim_cell_arr
    mov edx, dword ptr [r11 + rdx*4 + 4]
    popcnt eax, edi
    add eax, ebx
    cmp eax, edx
    ja keyed
all_go:
    mov dword ptr [rsp + 48], 0
    mov eax, edi
    jmp piece_emit
keyed:
    ; their cells, from their positions
    mov r11, sim_pos_x
    vmovups ymm0, ymmword ptr [r11 + r12*4]
    vaddps ymm0, ymm0, ymmword ptr k_world_half
    vmulps ymm0, ymm0, ymmword ptr k_inv_cell
    vcvttps2dq ymm0, ymm0
    mov r11, sim_pos_z
    vmovups ymm3, ymmword ptr [r11 + r12*4]
    vaddps ymm3, ymm3, ymmword ptr k_world_half
    vmulps ymm3, ymm3, ymmword ptr k_inv_cell
    vcvttps2dq ymm3, ymm3
    vpslld ymm3, ymm3, GRID_SHIFT
    vpaddd ymm0, ymm0, ymm3
    ; the stayers' keys (cell << 32 | seq), 4 per vector: ymm2 lanes 0..3, ymm5 lanes 4..7
    vpmovzxdq ymm2, xmm1
    vextracti128 xmm1, ymm1, 1
    vpmovzxdq ymm5, xmm1
    vpmovzxdq ymm1, xmm0
    vpsllq ymm1, ymm1, 32
    vpor ymm2, ymm2, ymm1
    vextracti128 xmm1, ymm0, 1
    vpmovzxdq ymm1, xmm1
    vpsllq ymm1, ymm1, 32
    vpor ymm5, ymm5, ymm1
    mov dword ptr [rsp + 48], edi      ; the block's stayers not yet out
piece:
    ; the stayers whose key comes before the next mover's: a prefix of them
    vmovq xmm1, rsi
    vpbroadcastq ymm1, xmm1
    vpcmpgtq ymm4, ymm1, ymm2
    vmovmskpd eax, ymm4
    vpcmpgtq ymm4, ymm1, ymm5
    vmovmskpd ecx, ymm4
    shl ecx, 4
    or eax, ecx
    and eax, dword ptr [rsp + 48]
    jz piece_movers
    xor dword ptr [rsp + 48], eax
piece_emit:
    cmp eax, 255
    jne piece_pack
    ; the whole block, in order: eight band members, plain copies (masked
    ; 256-bit stores are microcoded on Zen, ~12 cycles each)
    mov r11, sim_pos_x
    vmovdqu ymm1, ymmword ptr [r11 + r12*4]
    mov r11, sim_pos_x2
    vmovdqu ymmword ptr [r11 + rbx*4], ymm1
    mov r11, sim_pos_z
    vmovdqu ymm1, ymmword ptr [r11 + r12*4]
    mov r11, sim_pos_z2
    vmovdqu ymmword ptr [r11 + rbx*4], ymm1
    mov r11, sim_vel_x
    vmovdqu ymm1, ymmword ptr [r11 + r12*4]
    mov r11, sim_vel_x2
    vmovdqu ymmword ptr [r11 + rbx*4], ymm1
    mov r11, sim_vel_z
    vmovdqu ymm1, ymmword ptr [r11 + r12*4]
    mov r11, sim_vel_z2
    vmovdqu ymmword ptr [r11 + rbx*4], ymm1
    mov r11, sim_seq
    vmovdqu ymm1, ymmword ptr [r11 + r12*4]
    mov r11, sim_seq2
    vmovdqu ymmword ptr [r11 + rbx*4], ymm1
    add ebx, 8
    jmp merge_next
piece_pack:
    ; left-pack them (pdep/pext permutation) and store the seven columns
    mov rcx, 0x0101010101010101
    pdep rcx, rax, rcx
    imul rcx, rcx, 255
    mov rdx, 0x0706050403020100
    pext rdx, rdx, rcx
    vmovq xmm3, rdx
    vpmovzxbd ymm3, xmm3
    popcnt ecx, eax
    mov dword ptr [rsp + 44], ecx
    ; output is written in ascending slots, so lanes past the packed ones
    ; land on slots this job writes next: plain stores, unless they would
    ; reach past the band's end
    mov edx, dword ptr [rsp + 8]
    sub edx, ebx
    cmp edx, 8
    jb piece_masked
    mov r11, sim_pos_x
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_pos_x2
    vmovdqu ymmword ptr [r11 + rbx*4], ymm1
    mov r11, sim_pos_z
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_pos_z2
    vmovdqu ymmword ptr [r11 + rbx*4], ymm1
    mov r11, sim_vel_x
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_vel_x2
    vmovdqu ymmword ptr [r11 + rbx*4], ymm1
    mov r11, sim_vel_z
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_vel_z2
    vmovdqu ymmword ptr [r11 + rbx*4], ymm1
    mov r11, sim_seq
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_seq2
    vmovdqu ymmword ptr [r11 + rbx*4], ymm1
    jmp piece_stored
piece_masked:
    shl ecx, 5
    lea rdx, k_lane_valid
    vmovdqa ymm4, ymmword ptr [rdx + rcx]
    mov r11, sim_pos_x
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_pos_x2
    vpmaskmovd ymmword ptr [r11 + rbx*4], ymm4, ymm1
    mov r11, sim_pos_z
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_pos_z2
    vpmaskmovd ymmword ptr [r11 + rbx*4], ymm4, ymm1
    mov r11, sim_vel_x
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_vel_x2
    vpmaskmovd ymmword ptr [r11 + rbx*4], ymm4, ymm1
    mov r11, sim_vel_z
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_vel_z2
    vpmaskmovd ymmword ptr [r11 + rbx*4], ymm4, ymm1
    mov r11, sim_seq
    vpermd ymm1, ymm3, ymmword ptr [r11 + r12*4]
    mov r11, sim_seq2
    vpmaskmovd ymmword ptr [r11 + rbx*4], ymm4, ymm1
piece_stored:
    add ebx, dword ptr [rsp + 44]
    cmp dword ptr [rsp + 48], 0
    je merge_next
piece_movers:
    ; the movers before the next stayer
    mov eax, dword ptr [rsp + 48]
    tzcnt eax, eax
    lea r9d, [r12 + rax]
    mov ecx, r9d
    call cell_of_slot
    shl rax, 32
    mov r11, sim_seq
    mov r11d, dword ptr [r11 + r9*4]
    or rax, r11
    mov qword ptr [rsp + 56], rax
piece_mover:
    cmp rsi, qword ptr [rsp + 56]
    jae piece_again
    call merge_emit_mover
    jmp piece_mover
piece_again:
    jmp piece
merge_next:
    add r12d, 8
    jmp merge_blocks
merge_tail:
    ; the movers after every stayer
    mov rax, MERGE_NONE
    cmp rsi, rax
    je merged
    call merge_emit_mover
    jmp merge_tail
merged:
    vzeroupper
    jmp gathered_b
place_full:
    ; stayers, descending: they end each cell's run, in (cell, seq) order
    mov r11, sim_slot_id
    mov r14, sim_slot_cell2
    mov ecx, dword ptr [rsp + 16]
place_stay:
    cmp ecx, dword ptr [rsp + 12]
    jbe placed_stay
    dec ecx
    mov edx, dword ptr [r8 + rcx*4]
    test edx, edx
    js place_stay                      ; changed cell, or dead
    mov eax, dword ptr [rsi + rdx*4 + 4]
    dec eax
    mov dword ptr [rsi + rdx*4 + 4], eax
    mov dword ptr [r11 + rax*4], ecx
    mov dword ptr [r14 + rax*4], edx
    jmp place_stay
placed_stay:
    ; movers ahead of them; the list now records each mover's slot
    xor ecx, ecx
place_move:
    cmp ecx, r15d
    jae placed_move
    mov edi, dword ptr [rbp + rcx*8]
    mov edx, dword ptr [rbp + rcx*8 + 4]
    mov eax, dword ptr [rsi + rdx*4 + 4]
    dec eax
    mov dword ptr [rsi + rdx*4 + 4], eax
    mov dword ptr [r11 + rax*4], edi
    mov dword ptr [r14 + rax*4], edx
    mov dword ptr [rbp + rcx*8], eax
    inc ecx
    jmp place_move
placed_move:
    ; creation order: each mover, in placement order, slides forward into the
    ; sorted rest of its cell's run (arr[c + 1] is now the start of cell c)
    mov r13, sim_seq
    mov r12d, dword ptr [rsp + 24]
    add r12d, BAND_CELLS - 1           ; the band's last cell
    xor ecx, ecx
order:
    cmp ecx, r15d
    jae ordered
    mov edx, dword ptr [rbp + rcx*8]   ; the mover's slot
    mov eax, dword ptr [r14 + rdx*4]   ; its cell
    mov edi, dword ptr [rsp + 8]       ; the run's end: the band's end for the last cell,
    cmp eax, r12d
    je slide
    mov edi, dword ptr [rsi + rax*4 + 8]   ; else the start of the next cell
slide:
    lea eax, [rdx + 1]
    cmp eax, edi
    jae next_mover
    mov eax, dword ptr [r11 + rdx*4]
    mov ebx, dword ptr [r11 + rdx*4 + 4]
    mov r9d, dword ptr [r13 + rax*4]
    and r9d, 0x3FFFFFFF
    mov r10d, dword ptr [r13 + rbx*4]
    and r10d, 0x3FFFFFFF
    cmp r9d, r10d
    jb next_mover
    mov dword ptr [r11 + rdx*4], ebx
    mov dword ptr [r11 + rdx*4 + 4], eax
    inc edx
    jmp slide
next_mover:
    inc ecx
    jmp order
ordered:
    ; gather the six live columns into slot order in one pass (the slot ids
    ; are read once; values move through xmm0, so twelve pointers fit)
    mov rbx, sim_pos_x
    mov rsi, sim_pos_x2
    mov rdi, sim_pos_z
    mov rbp, sim_pos_z2
    mov r8, sim_vel_x
    mov r9, sim_vel_x2
    mov r10, sim_vel_z
    mov r12, sim_vel_z2
    mov r15, sim_seq
    mov rdx, sim_seq2
    mov ecx, dword ptr [rsp]
    vmovdqa ymm2, ymmword ptr k_iota
gather:
    ; a block of 8 slots whose ids run consecutively (stayers, mostly) is
    ; copied as vectors; else slot by slot
    mov eax, dword ptr [rsp + 8]
    sub eax, ecx
    cmp eax, 8
    jb gather_one
    vmovdqu ymm0, ymmword ptr [r11 + rcx*4]
    vpbroadcastd ymm1, xmm0
    vpaddd ymm1, ymm1, ymm2
    vpcmpeqd ymm1, ymm1, ymm0
    vmovmskps eax, ymm1
    cmp eax, 255
    jne gather_eight
    vmovd eax, xmm0
    vmovups ymm1, ymmword ptr [rbx + rax*4]
    vmovups ymmword ptr [rsi + rcx*4], ymm1
    vmovups ymm1, ymmword ptr [rdi + rax*4]
    vmovups ymmword ptr [rbp + rcx*4], ymm1
    vmovups ymm1, ymmword ptr [r8 + rax*4]
    vmovups ymmword ptr [r9 + rcx*4], ymm1
    vmovups ymm1, ymmword ptr [r10 + rax*4]
    vmovups ymmword ptr [r12 + rcx*4], ymm1
    vmovups ymm1, ymmword ptr [r15 + rax*4]
    vmovups ymmword ptr [rdx + rcx*4], ymm1
    add ecx, 8
    jmp gather
gather_eight:
    mov eax, ecx
    add eax, 8
    mov dword ptr [rsp + 32], eax
gather_slot:
    mov eax, dword ptr [r11 + rcx*4]
    vmovd xmm0, dword ptr [rbx + rax*4]
    vmovd dword ptr [rsi + rcx*4], xmm0
    vmovd xmm0, dword ptr [rdi + rax*4]
    vmovd dword ptr [rbp + rcx*4], xmm0
    vmovd xmm0, dword ptr [r8 + rax*4]
    vmovd dword ptr [r9 + rcx*4], xmm0
    vmovd xmm0, dword ptr [r10 + rax*4]
    vmovd dword ptr [r12 + rcx*4], xmm0
    vmovd xmm0, dword ptr [r15 + rax*4]
    vmovd dword ptr [rdx + rcx*4], xmm0
    inc ecx
    cmp ecx, dword ptr [rsp + 32]
    jb gather_slot
    jmp gather
gather_one:
    cmp ecx, dword ptr [rsp + 8]
    jae gathered_b
    mov eax, dword ptr [r11 + rcx*4]
    vmovd xmm0, dword ptr [rbx + rax*4]
    vmovd dword ptr [rsi + rcx*4], xmm0
    vmovd xmm0, dword ptr [rdi + rax*4]
    vmovd dword ptr [rbp + rcx*4], xmm0
    vmovd xmm0, dword ptr [r8 + rax*4]
    vmovd dword ptr [r9 + rcx*4], xmm0
    vmovd xmm0, dword ptr [r10 + rax*4]
    vmovd dword ptr [r12 + rcx*4], xmm0
    vmovd xmm0, dword ptr [r15 + rax*4]
    vmovd dword ptr [rdx + rcx*4], xmm0
    inc ecx
    jmp gather_one
gathered_b:
    vzeroupper
    ; Fused: the band's interior rows (lo + 1 .. lo + BAND_ROWS - 2) need only the band's
    ; own rows, which this thread has just written: separate and integrate
    ; them now, while they are in its cache. The integrated positions go to
    ; this participant's buffer (it stays in cache too) and each row is
    ; copied home over its start positions as soon as no row next to it is
    ; left to separate: rows lo + 2 .. lo + BAND_ROWS - 3 now; rows lo + 1 and
    ; lo + BAND_ROWS - 2 wait in the pending columns for the boundary jobs
    ; below and above.
    cmp grid_fuse_now, 0
    je not_fused
    mov eax, dword ptr [rsp + 24]
    shr eax, BAND_SHIFT
    mov dword ptr [rsp + 32], eax      ; band
    mov ecx, dword ptr [rsp]
    mov edx, dword ptr [rsp + 64]
    call fz_out_local                  ; the band's slots into the buffer
    mov eax, dword ptr [rsp + 24]      ; lo cell
    mov rsi, sim_cell_start
    mov ecx, dword ptr [rsi + rax*4 + GRID_DIM * 4]         ; start of row lo + 1
    mov edx, dword ptr [rsi + rax*4 + BAND_ROWS * GRID_DIM * 4 - GRID_DIM * 4]  ; start of the last row
    mov r9d, dword ptr [rsp + 64]
    call sim_separate_v4
    cmp dword ptr [rsp + 32], 0
    jne not_first
        ; band 0: row 0 has no row below; rows 0 .. BAND_ROWS - 3 are final
        mov rsi, sim_cell_start
        mov ecx, dword ptr [rsi]
        mov edx, dword ptr [rsi + GRID_DIM * 4]
        mov r9d, dword ptr [rsp + 64]
        call sim_separate_v4
        mov rsi, sim_cell_start
        mov ecx, dword ptr [rsi]
        mov edx, dword ptr [rsi + BAND_ROWS * GRID_DIM * 4 - 2 * GRID_DIM * 4]
        mov r8d, dword ptr [rsp + 64]
        call fz_rows_home
        jmp first_done
    not_first:
        mov eax, dword ptr [rsp + 24]
        mov rsi, sim_cell_start
        mov ecx, dword ptr [rsi + rax*4 + GRID_DIM * 4]
        mov edx, dword ptr [rsi + rax*4 + 2 * GRID_DIM * 4]
        mov r8d, dword ptr [rsp + 64]
        call fz_rows_stash             ; row lo + 1
        mov eax, dword ptr [rsp + 24]
        mov rsi, sim_cell_start
        mov ecx, dword ptr [rsi + rax*4 + 2 * GRID_DIM * 4]
        mov edx, dword ptr [rsi + rax*4 + BAND_ROWS * GRID_DIM * 4 - 2 * GRID_DIM * 4]
        mov r8d, dword ptr [rsp + 64]
        call fz_rows_home              ; rows lo + 2 .. lo + BAND_ROWS - 3
    first_done:
    cmp dword ptr [rsp + 32], GRID_BANDS - 1
    jne not_last
        ; the last band: row 1023 has no row above; its last two rows are final
        mov rsi, sim_cell_start
        mov ecx, dword ptr [rsi + (GRID_CELLS - GRID_DIM) * 4]
        mov edx, dword ptr [rsp + 8]
        mov r9d, dword ptr [rsp + 64]
        call sim_separate_v4
        mov eax, dword ptr [rsp + 24]
        mov rsi, sim_cell_start
        mov ecx, dword ptr [rsi + rax*4 + BAND_ROWS * GRID_DIM * 4 - 2 * GRID_DIM * 4]
        mov edx, dword ptr [rsp + 8]
        mov r8d, dword ptr [rsp + 64]
        call fz_rows_home
        jmp last_done
    not_last:
        mov eax, dword ptr [rsp + 24]
        mov rsi, sim_cell_start
        mov ecx, dword ptr [rsi + rax*4 + BAND_ROWS * GRID_DIM * 4 - 2 * GRID_DIM * 4]
        mov edx, dword ptr [rsi + rax*4 + BAND_ROWS * GRID_DIM * 4 - GRID_DIM * 4]
        mov r8d, dword ptr [rsp + 64]
        call fz_rows_stash             ; row lo + BAND_ROWS - 2
    last_done:
    ; Boundary rows. The two rows either side of a boundary between bands
    ; need only those two bands. Each band, when finished, publishes its
    ; stamp with a locked exchange (a full fence), then claims (lock cmpxchg)
    ; each boundary whose other band is finished too and separates its rows:
    ; of two neighbours, the later one always sees the earlier one done, and
    ; only one claim succeeds. No pass over the edges, no barrier for them.
    ; After a boundary's two rows, they and the pending row on each side are
    ; final.
    mov eax, grid_build_id
    mov ecx, dword ptr [rsp + 32]
    lea rdx, band_done
    xchg dword ptr [rdx + rcx*4], eax  ; publish (xchg with memory is locked)
    ; the boundary below: rows lo - 1 and lo
    mov eax, dword ptr [rsp + 32]
    test eax, eax
    jz below_done
    lea rdx, band_done
    mov ecx, dword ptr [rdx + rax*4 - 4]
    cmp ecx, grid_build_id
    jne below_done
    lea rdx, edge_claim
    xor eax, eax
    mov ecx, 1
    mov r8d, dword ptr [rsp + 32]
    lock cmpxchg dword ptr [rdx + r8*4], ecx
    jnz below_done
    mov eax, dword ptr [rsp + 24]
    sub eax, GRID_DIM
    call grid_boundary                 ; rows lo - 1, lo
below_done:
    ; the boundary above: the band's last row and the next band's first
    mov eax, dword ptr [rsp + 32]
    cmp eax, GRID_BANDS - 1
    je above_done
    lea rdx, band_done
    mov ecx, dword ptr [rdx + rax*4 + 4]
    cmp ecx, grid_build_id
    jne above_done
    lea rdx, edge_claim
    xor eax, eax
    mov ecx, 1
    mov r8d, dword ptr [rsp + 32]
    lock cmpxchg dword ptr [rdx + r8*4 + 4], ecx
    jnz above_done
    mov eax, dword ptr [rsp + 24]
    add eax, BAND_ROWS * GRID_DIM - GRID_DIM
    call grid_boundary
above_done:
not_fused:
    add rsp, 104
    pop rbp
    pop r15
    pop r14
    pop r13
    pop r12
    pop rdi
    pop rsi
    pop rbx
    ret
}

; Inside grid_band_job's merge (its frame: k at [rsp + 8 + 40]): emit mover k
; to slot rbx, advance k and its key in rsi. r13: the sorted storage indices,
; r14: their keys, r15d: the movers' count.
merge_emit_mover: proc() = {
    mov edx, dword ptr [rsp + 48]      ; k (the caller's [rsp + 40])
    mov ecx, dword ptr [r13 + rdx*4]   ; storage index
    mov r11, sim_pos_x
    vmovd xmm0, dword ptr [r11 + rcx*4]
    mov r11, sim_pos_x2
    vmovd dword ptr [r11 + rbx*4], xmm0
    mov r11, sim_pos_z
    vmovd xmm0, dword ptr [r11 + rcx*4]
    mov r11, sim_pos_z2
    vmovd dword ptr [r11 + rbx*4], xmm0
    mov r11, sim_vel_x
    vmovd xmm0, dword ptr [r11 + rcx*4]
    mov r11, sim_vel_x2
    vmovd dword ptr [r11 + rbx*4], xmm0
    mov r11, sim_vel_z
    vmovd xmm0, dword ptr [r11 + rcx*4]
    mov r11, sim_vel_z2
    vmovd dword ptr [r11 + rbx*4], xmm0
    mov r11, sim_seq
    vmovd xmm0, dword ptr [r11 + rcx*4]
    mov r11, sim_seq2
    vmovd dword ptr [r11 + rbx*4], xmm0
    inc ebx
    inc edx
    mov dword ptr [rsp + 48], edx
    mov rsi, MERGE_NONE
    cmp edx, r15d
    jae done
    mov rsi, qword ptr [r14 + rdx*8]
done:
    ret
}

; Inside grid_band_job (its participant at the caller's [rsp + 64]). eax: the
; first cell of row r, the lower of a boundary's two rows r and r + 1 (both
; bands built). Separate both into the participant's buffer, then copy home
; rows r and r + 1 and the pending rows r - 1 and r + 2: every row next to
; them is separated now.
grid_boundary: proc() = {
    push rbx
    push rsi
    push rdi
    sub rsp, 32                        ; 8 + 24 + 32 = 64
    mov ebx, eax
    mov edi, dword ptr [rsp + 128]     ; the participant (the caller's [rsp + 64])
    mov rsi, sim_cell_start
    mov ecx, dword ptr [rsi + rbx*4]
    mov edx, edi
    call fz_out_local
    mov rsi, sim_cell_start
    mov ecx, dword ptr [rsi + rbx*4]
    mov edx, dword ptr [rsi + rbx*4 + 2 * GRID_DIM * 4]
    mov r9d, edi
    call sim_separate_v4
    mov rsi, sim_cell_start
    mov ecx, dword ptr [rsi + rbx*4]
    mov edx, dword ptr [rsi + rbx*4 + 2 * GRID_DIM * 4]
    mov r8d, edi
    call fz_rows_home
    mov rsi, sim_cell_start
    mov ecx, dword ptr [rsi + rbx*4 - GRID_DIM * 4]
    mov edx, dword ptr [rsi + rbx*4]
    call fz_rows_pend
    mov rsi, sim_cell_start
    mov ecx, dword ptr [rsi + rbx*4 + 2 * GRID_DIM * 4]
    mov edx, dword ptr [rsi + rbx*4 + 3 * GRID_DIM * 4]
    call fz_rows_pend
    add rsp, 32
    pop rdi
    pop rsi
    pop rbx
    ret
}

; The whole grid build on the pool.
grid_stage_cyc: [5]u64 = {}

; grid_band_job, its busy cycles summed over threads into grid_stage_cyc[4]
grid_band_job_timed: proc(begin: u32, end: u32, band: u32) = {
    push rbx
    sub rsp, 32
    mov r10, rdx
    rdtsc
    shl rdx, 32
    or rax, rdx
    mov rbx, rax
    mov rdx, r10
    cmp grid_local, 0
    jne timed_local
    call grid_band_job
    jmp timed_done
timed_local:
    call grid_band_local
timed_done:
    rdtsc
    shl rdx, 32
    or rax, rdx
    sub rax, rbx
    lock add grid_stage_cyc[4], rax
    add rsp, 32
    pop rbx
    ret
}

; rdtsc into rax
grid_stamp: proc() = {
    rdtsc
    shl rdx, 32
    or rax, rdx
    ret
}

sim_grid_mt: proc() = {
    push rbx
    push rsi
    push rdi
    sub rsp, 32                        ; 8 + 24 + 32 = 64
    call grid_stamp
    mov qword ptr [rsp + 24], rax
    mov eax, sim_count
    mov grid_old_count, eax
    ; a fused build works on the columns it is building
    mov rax, sim_pos_x2
    mov fz_src_x, rax
    mov rax, sim_pos_z2
    mov fz_src_z, rax
    mov rax, sim_vel_x2
    mov fz_vel_x, rax
    mov rax, sim_vel_z2
    mov fz_vel_z, rax
    ; integrated positions: into sim_pos3 (every participant; a fused band's
    ; job points its own entry at its buffer), which also holds the rows
    ; waiting for a boundary job
    mov rax, sim_pos3_x
    mov rdx, sim_pos3_z
    mov fz_pend_x, rax
    mov fz_pend_z, rdx
    mov r9, sim_seq2
    mov fz_seq, r9
    lea rcx, fz_out_tab
    xor r8d, r8d
out_tab:
    mov qword ptr [rcx + r8], rax
    mov qword ptr [rcx + r8 + 8], rdx
    mov r9, fz_src_x
    mov qword ptr [rcx + r8 + 16], r9
    mov r9, fz_src_z
    mov qword ptr [rcx + r8 + 24], r9
    mov r9, fz_vel_x
    mov qword ptr [rcx + r8 + 32], r9
    mov r9, fz_vel_z
    mov qword ptr [rcx + r8 + 40], r9
    mov r9, fz_seq
    mov qword ptr [rcx + r8 + 48], r9
    mov r9, sim_cell_start
    mov qword ptr [rcx + r8 + 56], r9
    add r8d, 64
    cmp r8d, 64 * 64
    jb out_tab
    ; rows anyone can have moved since the last build (a cell is 2 m)
    vmovd xmm0, grid_maxdisp
    vmulss xmm0, xmm0, k_disp_rows
    vcvttss2si eax, xmm0
    inc eax
    mov grid_d_rows, eax
    mov grid_maxdisp, 0
    ; the windowed sweep when the last build's order is a good start: few
    ; spawns since, small moves; else the full binned build
    mov grid_windowed, 0
    cmp grid_fuse, 0
    je full_build
    mov eax, grid_built_n
    test eax, eax
    jz full_build
    mov ecx, sim_count
    sub ecx, eax
    cmp ecx, WINDOW_MAX_TAIL
    ja full_build
    cmp grid_d_rows, WINDOW_MAX_ROWS
    ja full_build
    mov grid_windowed, 1
    inc grid_windowed_ticks
    ; this build's members and movers per band, counted by the last tick's
    ; integration, deaths and spawns
    xor ecx, ecx
take_counts:
    lea rax, next_band_total
    mov edx, dword ptr [rax + rcx*4]
    lea rax, band_total
    mov dword ptr [rax + rcx*4], edx
    lea rax, next_mov_total
    mov edx, dword ptr [rax + rcx*4]
    lea rax, mov_band_total
    mov dword ptr [rax + rcx*4], edx
    inc ecx
    cmp ecx, GRID_BANDS
    jb take_counts
    ; band bases and mover lists from the window counts
    xor edx, edx
    xor esi, esi
    xor ebx, ebx
    xor r10d, r10d
win_offsets:
    lea rax, band_offset
    mov dword ptr [rax + rbx*4], edx
    lea rax, band_total
    mov eax, dword ptr [rax + rbx*4]
    add edx, eax
    cmp eax, r10d
    cmova r10d, eax
    lea rax, mov_band_off
    mov dword ptr [rax + rbx*4], esi
    lea rax, mov_band_total
    add esi, dword ptr [rax + rbx*4]
    inc ebx
    cmp ebx, GRID_BANDS
    jb win_offsets
    mov grid_live, edx
    mov grid_fuse_now, 0
    shl r10d, 5
    cmp r10d, edx
    ja win_fuse_decided
    mov grid_fuse_now, 1
win_fuse_decided:
    jmp bands_ready
full_build:
    mov rcx, grid_bin_job&
    mov edx, sim_count
    mov r8d, BIN_CHUNK
    call pool_dispatch
    ; offsets: band-major, chunk-minor
    mov eax, sim_count
    add eax, BIN_CHUNK - 1
    shr eax, 14                        ; chunks used
    mov edi, eax
    xor edx, edx                       ; running
    xor ebx, ebx                       ; band
    xor r10d, r10d                     ; the fullest band
    lea r8, bin_hist
    lea r9, bin_off
bands:
    lea rax, band_offset
    mov dword ptr [rax + rbx*4], edx
    mov esi, edx
    xor ecx, ecx                       ; chunk
    mov eax, ebx                       ; index = chunk * GRID_BANDS + band
chunks:
    cmp ecx, edi
    jae chunks_done
    mov dword ptr [r9 + rax*4], edx
    add edx, dword ptr [r8 + rax*4]
    add eax, GRID_BANDS
    inc ecx
    jmp chunks
chunks_done:
    mov eax, edx
    sub eax, esi
    lea rcx, band_total
    mov dword ptr [rcx + rbx*4], eax
    cmp eax, r10d
    cmova r10d, eax
    inc ebx
    cmp ebx, GRID_BANDS
    jb bands
    mov grid_live, edx                 ; the survivors: the new population
    ; fuse per band only when no band holds more than 1/32 of everyone: a dense
    ; crowd fills a few bands, and per-band work would sit on a few threads
    mov grid_fuse_now, 0
    cmp grid_fuse, 0
    je fuse_decided
    shl r10d, 5
    cmp r10d, edx
    ja fuse_decided
    mov grid_fuse_now, 1
fuse_decided:
    ; the movers' lists, the same way
    xor edx, edx
    xor ebx, ebx
    lea r8, mov_hist
    lea r9, mov_off
mbands:
    lea rax, mov_band_off
    mov dword ptr [rax + rbx*4], edx
    mov esi, edx
    xor ecx, ecx
    mov eax, ebx
mchunks:
    cmp ecx, edi
    jae mchunks_done
    mov dword ptr [r9 + rax*4], edx
    add edx, dword ptr [r8 + rax*4]
    add eax, GRID_BANDS
    inc ecx
    jmp mchunks
mchunks_done:
    mov eax, edx
    sub eax, esi
    lea rcx, mov_band_total
    mov dword ptr [rcx + rbx*4], eax
    inc ebx
    cmp ebx, GRID_BANDS
    jb mbands
    call grid_stamp
    mov rcx, rax
    sub rcx, qword ptr [rsp + 24]
    add grid_stage_cyc[0], rcx
    mov qword ptr [rsp + 24], rax
    mov rcx, grid_bucket_job&
    mov edx, sim_count
    mov r8d, BIN_CHUNK
    call pool_dispatch
    call grid_stamp
    mov rcx, rax
    sub rcx, qword ptr [rsp + 24]
    add grid_stage_cyc[1], rcx
    mov qword ptr [rsp + 24], rax
bands_ready:
    ; the local build (grid_local.rasm) for bandwidth-bound ticks: windowed
    ; and fused, a large population, 8 to LB_PARTS participants, and no band
    ; too full for the participants' buffers
    mov grid_local, 0
    cmp grid_windowed, 0
    je local_decided
    cmp grid_fuse_now, 0
    je local_decided
    cmp grid_live, FZ_INPLACE_MIN
    jb local_decided
    mov eax, pool_parts
    cmp eax, 8
    jb local_decided
    cmp eax, LB_PARTS
    ja local_decided
    lea r9, band_total
    xor ecx, ecx
local_bands:
    cmp dword ptr [r9 + rcx*4], LB_BAND_MAX
    ja local_decided
    inc ecx
    cmp ecx, GRID_BANDS
    jb local_bands
    mov grid_local, 1
    ; each row's first slot in the last build
    mov r8, sim_cell_arr
    lea r9, lb_row_old
    xor ecx, ecx
local_rows:
    mov eax, ecx
    shl eax, GRID_SHIFT
    mov eax, dword ptr [r8 + rax*4 + 4]
    mov dword ptr [r9 + rcx*4], eax
    inc ecx
    cmp ecx, GRID_DIM
    jb local_rows
    mov eax, grid_built_n
    mov dword ptr [r9 + GRID_DIM * 4], eax
local_decided:
    ; each band's old slots and its window's, from the last build's cell
    ; starts (arr[c + 1]: the start of cell c; arr[GRID_CELLS + 1]: their
    ; end), before the band jobs turn them into this build's
    mov r8, sim_cell_arr
    lea r9, band_old_lo
    lea r10, band_win
    xor ecx, ecx
    cmp grid_built_n, 0
    jne old_ranges
zero_ranges:
    mov dword ptr [r9 + rcx*4], 0      ; nothing in grid order yet
    inc ecx
    cmp ecx, GRID_BANDS + 1
    jb zero_ranges
    jmp ranges_done
old_ranges:
    mov eax, ecx
    shl eax, BAND_SHIFT
    mov edx, dword ptr [r8 + rax*4 + 4]
    mov dword ptr [r9 + rcx*4], edx
    mov eax, ecx
    shl eax, BAND_ROW_SHIFT            ; the band's first row
    mov edx, eax
    sub eax, grid_d_rows
    xor r11d, r11d
    test eax, eax
    cmovs eax, r11d
    add edx, BAND_ROWS
    add edx, grid_d_rows
    mov r11d, GRID_DIM
    cmp edx, r11d
    cmova edx, r11d
    shl eax, GRID_SHIFT
    shl edx, GRID_SHIFT
    mov eax, dword ptr [r8 + rax*4 + 4]
    mov edx, dword ptr [r8 + rdx*4 + 4]
    mov dword ptr [r10 + rcx*8], eax
    mov dword ptr [r10 + rcx*8 + 4], edx
    inc ecx
    cmp ecx, GRID_BANDS
    jb old_ranges
    mov eax, grid_built_n
    mov dword ptr [r9 + GRID_BANDS * 4], eax
ranges_done:
    mov fz_inplace, 0
    cmp grid_live, FZ_INPLACE_MIN
    jb inplace_decided
    mov fz_inplace, 1
inplace_decided:
    inc grid_build_id
    xor eax, eax
    lea rdi, edge_claim
    mov ecx, GRID_BANDS + 1
    rep stosd
    ; this build's integration counts for the next one
    xor eax, eax
    lea rdi, next_band_total
    mov ecx, GRID_BANDS
    rep stosd
    lea rdi, next_mov_total
    mov ecx, GRID_BANDS
    rep stosd
    mov rcx, grid_band_job_timed&
    mov edx, GRID_BANDS
    mov r8d, 1
    call pool_dispatch
    call grid_stamp
    mov rcx, rax
    sub rcx, qword ptr [rsp + 24]
    add grid_stage_cyc[2], rcx
    mov eax, grid_live
    mov sim_count, eax
    mov sim_alive, eax
    mov grid_built_n, eax
    ; (a local build wrote this build's starts to the other array)
    cmp grid_local, 0
    je starts_kept
    mov rax, sim_cell_arr
    mov rcx, sim_cell_arr2
    mov sim_cell_arr, rcx
    mov sim_cell_arr2, rax
    lea rax, [rcx + 4]
    mov sim_cell_start, rax
    mov dword ptr [rcx], 0
starts_kept:
    ; the end of the last cell
    mov rax, sim_cell_arr
    mov edx, sim_count
    mov ecx, GRID_CELLS + 1
    mov dword ptr [rax + rcx*4], edx
    ; the grid-ordered columns become the live ones; the sorted views are them
    mov rax, sim_pos_x
    mov rcx, sim_pos_x2
    mov sim_pos_x, rcx
    mov sim_pos_x2, rax
    mov rax, sim_pos_z
    mov rcx, sim_pos_z2
    mov sim_pos_z, rcx
    mov sim_pos_z2, rax
    mov rax, sim_vel_x
    mov rcx, sim_vel_x2
    mov sim_vel_x, rcx
    mov sim_vel_x2, rax
    mov rax, sim_vel_z
    mov rcx, sim_vel_z2
    mov sim_vel_z, rcx
    mov sim_vel_z2, rax
    mov rax, sim_seq
    mov rcx, sim_seq2
    mov sim_seq, rcx
    mov sim_seq2, rax
    cmp grid_fuse, 0
    je unfused
    cmp grid_fuse_now, 0
    je by_slots
    ; (every boundary was claimed by one of its two bands; in place, every
    ; row's integrated positions are home in the live columns)
    cmp grid_local, 0
    jne cells_swap                     ; (local: the integrated positions are out)
    cmp fz_inplace, 0
    jne cells_swap
    jmp positions_swap
by_slots:
    ; a dense crowd: separation over chunks of slots, on every thread
    mov rcx, sim_separate_v4&
    mov edx, sim_count
    mov r8d, 2048
    call pool_dispatch
positions_swap:
    ; the integrated positions become the live ones
    mov rax, sim_pos_x
    mov rcx, sim_pos3_x
    mov sim_pos_x, rcx
    mov sim_pos3_x, rax
    mov rax, sim_pos_z
    mov rcx, sim_pos3_z
    mov sim_pos_z, rcx
    mov sim_pos3_z, rax
cells_swap:
unfused:
    mov rax, sim_pos_x
    mov sim_sorted_x, rax
    mov rax, sim_pos_z
    mov sim_sorted_z, rax
    mov rax, sim_identity
    mov sim_sorted_id, rax
    add rsp, 32
    pop rdi
    pop rsi
    pop rbx
    ret
}
