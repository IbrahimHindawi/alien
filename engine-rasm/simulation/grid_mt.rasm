; simulation/grid_mt.rasm: the grid's counting sort for threads, binned by band
;
; The cells are split into GRID_BANDS bands of BAND_ROWS whole rows. The
; entities are binned by band once, then each band is sorted on its own, so
; every entity's data is read a small constant number of times whatever the
; thread count:
;
;   bin       (chunks of entities)  cell[i]; the chunk's histogram of bands
;   offsets   (main thread)         exclusive prefix, band-major then chunk:
;                                   where each chunk's run of each band goes
;   bucket    (chunks of entities)  band_ids: entity ids grouped by band,
;                                   ascending within each band
;   sort      (one job per band)    zero, count, prefix (from the band's base)
;                                   and scatter the band's ids descending, as
;                                   sim_grid does, within the band's counters
;
; Within every cell the entities land in ascending order, exactly as in the
; single-threaded sim_grid, so the sorted arrays are bit-identical (the self
; test `banded grid equals sim_grid` and every reference hash check this).
; A band's counters (BAND_CELLS u32) fit in L1; small bands keep dense crowds
; spread over all the threads.

#define BAND_ROWS 8
#define BAND_SHIFT 13
#define BAND_CELLS 8192
#define GRID_BANDS 128
#define BIN_CHUNK 16384
#define BIN_CHUNKS 64

band_total: [GRID_BANDS]u32 = {}
band_offset: [GRID_BANDS]u32 = {}
bin_hist: [8192]u32[align(64)] = {}    ; [chunk * GRID_BANDS + band]
bin_off: [8192]u32[align(64)] = {}
sim_band_ids: *u32 = 0                  ; MAX_ENTITIES, allocated by sim_alloc

; ecx: begin, edx: end (entities; begin a multiple of 8), r8d: chunk
grid_bin_job: proc(begin: u32, end: u32, chunk: u32) = {
    push rbx
    push rsi
    push rdi
    mov ebx, ecx                       ; begin
    mov edi, edx                       ; end
    ; this chunk's histogram row, zeroed
    mov eax, r8d
    shl eax, 9                         ; chunk * GRID_BANDS * 4
    lea rsi, bin_hist
    add rsi, rax
    vpxor ymm0, ymm0, ymm0
    xor eax, eax
zero:
    vmovdqa ymmword ptr [rsi + rax], ymm0
    add eax, 32
    cmp eax, GRID_BANDS * 4
    jb zero
    ; cells, 8 at a time
    mov r8, sim_pos_x
    mov r9, sim_pos_z
    mov r10, sim_cell
    vmovaps ymm4, ymmword ptr k_world_half
    vmovaps ymm5, ymmword ptr k_inv_cell
    mov eax, ebx
    mov edx, edi
    sub edx, ebx
    add edx, 7
    shr edx, 3                         ; blocks
    shl rax, 2
    test edx, edx
    jz cells_done
cells:
    vaddps ymm0, ymm4, ymmword ptr [r8 + rax]
    vmulps ymm0, ymm0, ymm5
    vcvttps2dq ymm0, ymm0
    vaddps ymm1, ymm4, ymmword ptr [r9 + rax]
    vmulps ymm1, ymm1, ymm5
    vcvttps2dq ymm1, ymm1
    vpslld ymm1, ymm1, GRID_SHIFT
    vpaddd ymm0, ymm0, ymm1
    vmovdqa ymmword ptr [r10 + rax], ymm0
    add rax, 32
    dec edx
    jnz cells
cells_done:
    vzeroupper
    ; band histogram (the cells are still in L1/L2)
    mov eax, ebx
count:
    cmp eax, edi
    jae counted
    mov edx, dword ptr [r10 + rax*4]
    shr edx, BAND_SHIFT
    inc dword ptr [rsi + rdx*4]
    inc eax
    jmp count
counted:
    pop rdi
    pop rsi
    pop rbx
    ret
}

; ecx: begin, edx: end, r8d: chunk. Ids into band_ids at this chunk's offsets.
grid_bucket_job: proc(begin: u32, end: u32, chunk: u32) = {
    push rsi
    mov eax, r8d
    shl eax, 9
    lea rsi, bin_off
    add rsi, rax
    mov r10, sim_cell
    mov r9, sim_band_ids
bucket:
    cmp ecx, edx
    jae done
    mov eax, dword ptr [r10 + rcx*4]
    shr eax, BAND_SHIFT
    mov r11d, dword ptr [rsi + rax*4]
    mov dword ptr [r9 + r11*4], ecx
    inc r11d
    mov dword ptr [rsi + rax*4], r11d
    inc ecx
    jmp bucket
done:
    pop rsi
    ret
}

; r8d: band. Counting sort of the band's ids into the sorted arrays.
grid_band_job: proc(begin: u32, end: u32, band: u32) = {
    push rbx
    push rsi
    push rdi
    push r12
    push r13
    push r14
    push r15
    push rbp
    mov ebx, r8d
    mov r9d, ebx
    shl r9d, BAND_SHIFT                ; lo cell
    mov rsi, sim_cell_arr
    ; zero arr[lo + 1 .. lo + BAND_CELLS] (and arr[0] for band 0)
    lea rdi, [rsi + r9*4 + 4]
    xor eax, eax
    mov ecx, BAND_CELLS
    rep stosd
    test ebx, ebx
    jnz zeroed
        mov dword ptr [rsi], 0
    zeroed:
    ; the band's ids: band_ids[base .. base + n)
    lea rax, band_offset
    mov r12d, dword ptr [rax + rbx*4]  ; base
    lea rax, band_total
    mov r13d, dword ptr [rax + rbx*4]  ; n
    mov rbp, sim_band_ids
    lea rbp, [rbp + r12*4]
    mov r10, sim_cell
    ; count: arr[c + 1] += 1
    xor eax, eax
count:
    cmp eax, r13d
    jae counted
    mov edx, dword ptr [rbp + rax*4]
    mov edx, dword ptr [r10 + rdx*4]
    inc dword ptr [rsi + rdx*4 + 4]
    inc eax
    jmp count
counted:
    ; inclusive prefix from the band's base
    lea rdi, [rsi + r9*4 + 4]
    mov edx, r12d
    xor eax, eax
prefix:
    add edx, dword ptr [rdi + rax*4]
    mov dword ptr [rdi + rax*4], edx
    inc eax
    cmp eax, BAND_CELLS
    jb prefix
    ; scatter, ids descending: each cell's run comes out ascending
    mov r11, sim_pos_x
    mov r12, sim_pos_z
    mov r14, sim_sorted_x
    mov r15, sim_sorted_z
    mov rdi, sim_sorted_id
    mov ecx, r13d
scatter:
    test ecx, ecx
    jz scattered
    dec ecx
    mov r8d, dword ptr [rbp + rcx*4]   ; id
    mov edx, dword ptr [r10 + r8*4]    ; c
    mov eax, dword ptr [rsi + rdx*4 + 4]
    dec eax
    mov dword ptr [rsi + rdx*4 + 4], eax
    mov ebx, dword ptr [r11 + r8*4]
    mov dword ptr [r14 + rax*4], ebx
    mov ebx, dword ptr [r12 + r8*4]
    mov dword ptr [r15 + rax*4], ebx
    mov dword ptr [rdi + rax*4], r8d
    jmp scatter
scattered:
    pop rbp
    pop r15
    pop r14
    pop r13
    pop r12
    pop rdi
    pop rsi
    pop rbx
    ret
}

; The whole grid build on the pool.
sim_grid_mt: proc() = {
    push rbx
    push rsi
    push rdi
    sub rsp, 32                        ; 8 + 24 + 32 = 64
    mov rcx, grid_bin_job&
    mov edx, sim_count
    mov r8d, BIN_CHUNK
    call pool_dispatch
    ; offsets: band-major, chunk-minor
    mov eax, sim_count
    add eax, BIN_CHUNK - 1
    shr eax, 14                        ; chunks used
    mov edi, eax
    xor edx, edx                       ; running
    xor ebx, ebx                       ; band
    lea r8, bin_hist
    lea r9, bin_off
bands:
    lea rax, band_offset
    mov dword ptr [rax + rbx*4], edx
    mov esi, edx
    xor ecx, ecx                       ; chunk
    mov eax, ebx                       ; index = chunk * GRID_BANDS + band
chunks:
    cmp ecx, edi
    jae chunks_done
    mov dword ptr [r9 + rax*4], edx
    add edx, dword ptr [r8 + rax*4]
    add eax, GRID_BANDS
    inc ecx
    jmp chunks
chunks_done:
    mov eax, edx
    sub eax, esi
    lea rcx, band_total
    mov dword ptr [rcx + rbx*4], eax
    inc ebx
    cmp ebx, GRID_BANDS
    jb bands
    mov rcx, grid_bucket_job&
    mov edx, sim_count
    mov r8d, BIN_CHUNK
    call pool_dispatch
    mov rcx, grid_band_job&
    mov edx, GRID_BANDS
    mov r8d, 1
    call pool_dispatch
    ; the end of the last cell
    mov rax, sim_cell_arr
    mov edx, sim_count
    mov ecx, GRID_CELLS + 1
    mov dword ptr [rax + rcx*4], edx
    add rsp, 32
    pop rdi
    pop rsi
    pop rbx
    ret
}
