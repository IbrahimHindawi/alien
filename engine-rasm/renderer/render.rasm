; renderer/render.rasm: Direct3D 11
;
; One device, a flip-model swap chain viewed as sRGB, a depth buffer, the
; shared shaders from build/shaders/*.cso, MDM1 meshes, and three dynamic
; instance buffers, one per LOD. Per frame:
;
;   render_instances    cull every entity against the ground footprint, pick
;                       its LOD by distance, write float4(x, z, vx, vz) into
;                       that LOD's buffer (AVX2 tests, streaming stores)
;   render_frame        ground, units (3 instanced draws), hero, present
;
; Calls into D3D are vcalls; COM pointers are globals.

#define LOD_COUNT 3
#define INSTANCE_BYTES 16
#define CULL_MARGIN 3.0

Mesh: struct = {
    vb: *ID3D11Buffer
    ib: *ID3D11Buffer
    index_count: u32
    vertex_count: u32
    radius: f32
    pad: u32
}

FrameConstants: struct = {
    view_proj: [16]f32
    camera_pos: [4]f32
    light_dir: [4]f32
    fog_color: [4]f32
    params: [4]f32
    hero_world: [16]f32
    screen: [4]f32
    fx_pulse: [4]f32
    fx_bomb: [4]f32
    cam_x: [4]f32
    cam_y: [4]f32
    cam_z: [4]f32
    game: [4]f32
}

frame_cb: FrameConstants = {
    .light_dir = { -0.4777, 0.7961, -0.3715, 1.0 },
    .fog_color = { 0.045, 0.040, 0.085, 0.0032 },
    .params = { 1.5, 0.0, 1.0, 0.0 },
}

swap_desc: DXGI_SWAP_CHAIN_DESC = {
    .BufferDesc = { .Format = DXGI_FORMAT.DXGI_FORMAT_B8G8R8A8_UNORM },
    .SampleDesc = { .Count = 1 },
    .BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT,
    .BufferCount = 2,
    .Windowed = 1,
    .SwapEffect = DXGI_SWAP_EFFECT.DXGI_SWAP_EFFECT_FLIP_DISCARD,
}
rtv_desc: D3D11_RENDER_TARGET_VIEW_DESC = {
    .Format = DXGI_FORMAT.DXGI_FORMAT_B8G8R8A8_UNORM_SRGB,
    .ViewDimension = D3D11_RTV_DIMENSION.D3D11_RTV_DIMENSION_TEXTURE2D,
}
depth_desc: D3D11_TEXTURE2D_DESC = {
    .MipLevels = 1,
    .ArraySize = 1,
    .Format = DXGI_FORMAT.DXGI_FORMAT_D32_FLOAT,
    .SampleDesc = { .Count = 1 },
    .Usage = D3D11_USAGE.D3D11_USAGE_DEFAULT,
    .BindFlags = D3D11_BIND_FLAG.D3D11_BIND_DEPTH_STENCIL,
}
staging_desc: D3D11_TEXTURE2D_DESC = {
    .MipLevels = 1,
    .ArraySize = 1,
    .Format = DXGI_FORMAT.DXGI_FORMAT_B8G8R8A8_UNORM,
    .SampleDesc = { .Count = 1 },
    .Usage = D3D11_USAGE.D3D11_USAGE_STAGING,
    .CPUAccessFlags = D3D11_CPU_ACCESS_FLAG.D3D11_CPU_ACCESS_READ,
}
raster_desc: D3D11_RASTERIZER_DESC = {
    .FillMode = D3D11_FILL_MODE.D3D11_FILL_SOLID,
    .CullMode = D3D11_CULL_MODE.D3D11_CULL_BACK,
    .FrontCounterClockwise = 1,
    .DepthClipEnable = 1,
}
depth_state_desc: D3D11_DEPTH_STENCIL_DESC = {
    .DepthEnable = 1,
    .DepthWriteMask = D3D11_DEPTH_WRITE_MASK.D3D11_DEPTH_WRITE_MASK_ALL,
    .DepthFunc = D3D11_COMPARISON_FUNC.D3D11_COMPARISON_LESS,
}
cb_desc: D3D11_BUFFER_DESC = {
    .ByteWidth = sizeof(FrameConstants),
    .Usage = D3D11_USAGE.D3D11_USAGE_DYNAMIC,
    .BindFlags = D3D11_BIND_FLAG.D3D11_BIND_CONSTANT_BUFFER,
    .CPUAccessFlags = D3D11_CPU_ACCESS_FLAG.D3D11_CPU_ACCESS_WRITE,
}
instance_desc: D3D11_BUFFER_DESC = {
    .ByteWidth = MAX_ENTITIES * INSTANCE_BYTES,
    .Usage = D3D11_USAGE.D3D11_USAGE_DYNAMIC,
    .BindFlags = D3D11_BIND_FLAG.D3D11_BIND_VERTEX_BUFFER,
    .CPUAccessFlags = D3D11_CPU_ACCESS_FLAG.D3D11_CPU_ACCESS_WRITE,
}
bolt_desc: D3D11_BUFFER_DESC = {
    .ByteWidth = (PROJ_MAX + FX_EXTRA) * INSTANCE_BYTES,
    .Usage = D3D11_USAGE.D3D11_USAGE_DYNAMIC,
    .BindFlags = D3D11_BIND_FLAG.D3D11_BIND_VERTEX_BUFFER,
    .CPUAccessFlags = D3D11_CPU_ACCESS_FLAG.D3D11_CPU_ACCESS_WRITE,
}
; blob shadows: the alien instance stream alone, in slot 0
shadow_layout_desc: [1]const D3D11_INPUT_ELEMENT_DESC = {
    { .SemanticName = "INSTANCE", .Format = DXGI_FORMAT.DXGI_FORMAT_R32G32B32A32_FLOAT,
      .InputSlotClass = D3D11_INPUT_CLASSIFICATION.D3D11_INPUT_PER_INSTANCE_DATA, .InstanceDataStepRate = 1 },
}
; shadows multiply what is under them: dest * (1 - alpha)
shadow_blend_desc: D3D11_BLEND_DESC = {
    .RenderTarget = {
        {
            .BlendEnable = 1,
            .SrcBlend = D3D11_BLEND.D3D11_BLEND_ZERO,
            .DestBlend = D3D11_BLEND.D3D11_BLEND_INV_SRC_ALPHA,
            .BlendOp = D3D11_BLEND_OP.D3D11_BLEND_OP_ADD,
            .SrcBlendAlpha = D3D11_BLEND.D3D11_BLEND_ZERO,
            .DestBlendAlpha = D3D11_BLEND.D3D11_BLEND_ONE,
            .BlendOpAlpha = D3D11_BLEND_OP.D3D11_BLEND_OP_ADD,
            .RenderTargetWriteMask = 15,
        },
    },
}
shadow_depth_desc: D3D11_DEPTH_STENCIL_DESC = {
    .DepthEnable = 1,
    .DepthWriteMask = D3D11_DEPTH_WRITE_MASK.D3D11_DEPTH_WRITE_MASK_ZERO,
    .DepthFunc = D3D11_COMPARISON_FUNC.D3D11_COMPARISON_LESS_EQUAL,
}
mesh_buffer_desc: D3D11_BUFFER_DESC = { .Usage = D3D11_USAGE.D3D11_USAGE_IMMUTABLE }
mesh_init: D3D11_SUBRESOURCE_DATA = {}

unit_layout: [5]const D3D11_INPUT_ELEMENT_DESC = {
    { .SemanticName = "POSITION", .Format = DXGI_FORMAT.DXGI_FORMAT_R32G32B32_FLOAT, .AlignedByteOffset = 0 },
    { .SemanticName = "NORMAL", .Format = DXGI_FORMAT.DXGI_FORMAT_R8G8B8A8_SNORM, .AlignedByteOffset = 12 },
    { .SemanticName = "ANIM", .Format = DXGI_FORMAT.DXGI_FORMAT_R8G8B8A8_UNORM, .AlignedByteOffset = 12 },
    { .SemanticName = "COLOR", .Format = DXGI_FORMAT.DXGI_FORMAT_R8G8B8A8_UNORM, .AlignedByteOffset = 16 },
    { .SemanticName = "INSTANCE", .Format = DXGI_FORMAT.DXGI_FORMAT_R32G32B32A32_FLOAT, .InputSlot = 1,
      .InputSlotClass = D3D11_INPUT_CLASSIFICATION.D3D11_INPUT_PER_INSTANCE_DATA, .InstanceDataStepRate = 1 },
}

feature_level: D3D_FEATURE_LEVEL = D3D_FEATURE_LEVEL.D3D_FEATURE_LEVEL_11_0
swap_chain: *IDXGISwapChain = {}
device: *ID3D11Device = {}
context: *ID3D11DeviceContext = {}
backbuffer: *ID3D11Texture2D = {}
backbuffer_rtv: *ID3D11RenderTargetView = {}
depth_tex: *ID3D11Texture2D = {}
depth_dsv: *ID3D11DepthStencilView = {}
staging_tex: *ID3D11Texture2D = {}
raster_state: *ID3D11RasterizerState = {}
depth_state: *ID3D11DepthStencilState = {}
frame_buffer: *ID3D11Buffer = {}
input_layout: *ID3D11InputLayout = {}
shadow_layout: *ID3D11InputLayout = {}
shadow_blend: *ID3D11BlendState = {}
shadow_depth: *ID3D11DepthStencilState = {}
vs_bolt: *ID3D11VertexShader = {}
vs_sky: *ID3D11VertexShader = {}
ps_sky: *ID3D11PixelShader = {}
vs_shadow: *ID3D11VertexShader = {}
ps_shadow: *ID3D11PixelShader = {}
bomb_flash: f32 = 0.0
bomb_was_timing: u32 = 0
k_bomb_flash_decay: const f32 = 0.035
k_hp_full: const f32 = 0.01
k_bomb_delay_inv: const f32 = 0.02
vs_unit: *ID3D11VertexShader = {}
ps_unit: *ID3D11PixelShader = {}
vs_ground: *ID3D11VertexShader = {}
ps_ground: *ID3D11PixelShader = {}
vs_hero: *ID3D11VertexShader = {}
instance_buffers: [3]*ID3D11Buffer = {}
instance_counts: [3]u32 = {}
lod_meshes: [3]Mesh = {}
hero_mesh: Mesh = {}
bolt_mesh: Mesh = {}
bolt_buffer: *ID3D11Buffer = {}
bolt_count: u32 = 0
new_object: *void = {}
mapped: D3D11_MAPPED_SUBRESOURCE = {}
viewport: D3D11_VIEWPORT = { .MaxDepth = 1.0 }
clear_color: [4]const f32 = { 0.012, 0.014, 0.028, 1.0 }
mesh_stride: u32 = 20
mesh_offset: u32 = 0
instance_stride: u32 = 16
instance_offset: u32 = 0
render_shader_size: u64 = 0
render_time: f32 = 0.0
k_cull_margin: [8]const f32[align(32)] = { -3.0, -3.0, -3.0, -3.0, -3.0, -3.0, -3.0, -3.0 }
k_lod0_d2: [8]const f32[align(32)] = { 900.0, 900.0, 900.0, 900.0, 900.0, 900.0, 900.0, 900.0 }
k_lod1_d2: [8]const f32[align(32)] = { 6400.0, 6400.0, 6400.0, 6400.0, 6400.0, 6400.0, 6400.0, 6400.0 }
render_instance_cycles: u64 = 0
k_depth_one: const f32 = 1.0

; shaders --------------------------------------------------------------------

; rcx: file name under shaders/ -> rax: bytecode in arena_frame, render_shader_size set; exits on failure
load_shader_bytes: proc(name: *const u8) -> *u8 = {
    push rbx
    sub rsp, 32
    mov rbx, rcx
    call exe_path
    invoke(read_file, rax, arena_frame&, render_shader_size&)
    test rax, rax
    jnz done
    invoke(print, "cannot read shader %s\n", rbx)
    invoke(ExitProcess, 4)
done:
    add rsp, 32
    pop rbx
    ret
}

; meshes ---------------------------------------------------------------------

; rcx: path relative to the exe, rdx: Mesh to fill -> eax 1 ok. Validates the
; header against the file size before creating any buffer.
mesh_load: proc(path: *const u8, mesh: *Mesh) -> b32 = {
    push rbx
    push rsi
    push rdi
    sub rsp, 48                        ; 8 + 24 + 48 = 80
    mov rsi, rdx
    mov rdi, rcx
    call exe_path
    invoke(read_file, rax, arena_frame&, render_shader_size&)
    test rax, rax
    jz failed
    mov rbx, rax
    cmp render_shader_size, 48
    jb bad
    cmp dword ptr [rbx], 0x314D444D
    jne bad
    cmp dword ptr [rbx + 4], 1
    jne bad
    mov eax, dword ptr [rbx + 8]       ; vertices
    mov ecx, dword ptr [rbx + 12]      ; indices
    test eax, eax
    jz bad
    test ecx, ecx
    jz bad
    cmp eax, 1048576
    ja bad
    cmp ecx, 4194304
    ja bad
    ; 48 + 20 v + 4 i must equal the file size
    imul rdx, rax, 20
    lea rdx, [rdx + rcx*4 + 48]
    cmp rdx, render_shader_size
    jne bad
    ; every index < vertex count
    lea r8, [rbx + 48]
    imul r9, rax, 20
    add r8, r9                         ; indices
    xor edx, edx
check_index:
    cmp dword ptr [r8 + rdx*4], eax
    jae bad
    inc edx
    cmp edx, ecx
    jb check_index
    mov [rsi].Mesh.vertex_count, eax
    mov [rsi].Mesh.index_count, ecx
    mov eax, dword ptr [rbx + 40]
    mov [rsi].Mesh.radius, eax
    ; vertex buffer
    mov eax, [rsi].Mesh.vertex_count
    imul eax, eax, 20
    mov mesh_buffer_desc.ByteWidth, eax
    mov mesh_buffer_desc.BindFlags, D3D11_BIND_FLAG.D3D11_BIND_VERTEX_BUFFER
    lea rax, [rbx + 48]
    mov mesh_init.pSysMem, rax
    vcall(device, ID3D11DeviceVtbl.CreateBuffer, mesh_buffer_desc&, mesh_init&, new_object&)
    test eax, eax
    js failed
    mov rax, new_object
    mov [rsi].Mesh.vb, rax
    ; index buffer
    mov eax, [rsi].Mesh.index_count
    shl eax, 2
    mov mesh_buffer_desc.ByteWidth, eax
    mov mesh_buffer_desc.BindFlags, D3D11_BIND_FLAG.D3D11_BIND_INDEX_BUFFER
    mov eax, [rsi].Mesh.vertex_count
    imul rax, rax, 20
    lea rax, [rbx + rax + 48]
    mov mesh_init.pSysMem, rax
    vcall(device, ID3D11DeviceVtbl.CreateBuffer, mesh_buffer_desc&, mesh_init&, new_object&)
    test eax, eax
    js failed
    mov rax, new_object
    mov [rsi].Mesh.ib, rax
    mov eax, 1
    jmp done
bad:
    invoke(print, "invalid mesh %s\n", rdi)
failed:
    xor eax, eax
done:
    add rsp, 48
    pop rdi
    pop rsi
    pop rbx
    ret
}

; swap chain size ----------------------------------------------------------------

; (Re)create the views for the current client size.
render_create_targets: proc() = {
    sub rsp, 56
    vcall(swap_chain, IDXGISwapChainVtbl.GetBuffer, 0, IID_ID3D11Texture2D&, backbuffer&)
    vcall(device, ID3D11DeviceVtbl.CreateRenderTargetView, backbuffer, rtv_desc&, backbuffer_rtv&)
    mov eax, client_width
    mov depth_desc.Width, eax
    mov staging_desc.Width, eax
    mov eax, client_height
    mov depth_desc.Height, eax
    mov staging_desc.Height, eax
    vcall(device, ID3D11DeviceVtbl.CreateTexture2D, depth_desc&, 0, depth_tex&)
    vcall(device, ID3D11DeviceVtbl.CreateDepthStencilView, depth_tex, 0, depth_dsv&)
    vcall(device, ID3D11DeviceVtbl.CreateTexture2D, staging_desc&, 0, staging_tex&)
    call post_create_targets
    mov eax, client_width
    vcvtsi2ss xmm0, xmm0, eax
    vmovss viewport.Width, xmm0
    mov eax, client_height
    vcvtsi2ss xmm0, xmm0, eax
    vmovss viewport.Height, xmm0
    add rsp, 56
    ret
}

render_release_targets: proc() = {
    sub rsp, 40
    vcall(context, ID3D11DeviceContextVtbl.OMSetRenderTargets, 0, 0, 0)
    vcall(backbuffer_rtv, ID3D11RenderTargetViewVtbl.Release)
    vcall(backbuffer, ID3D11Texture2DVtbl.Release)
    vcall(depth_dsv, ID3D11DepthStencilViewVtbl.Release)
    vcall(depth_tex, ID3D11Texture2DVtbl.Release)
    vcall(staging_tex, ID3D11Texture2DVtbl.Release)
    call post_release_targets
    add rsp, 40
    ret
}

render_resize: proc() = {
    sub rsp, 56
    call render_release_targets
    mov eax, client_width
    mov r8, rax
    mov eax, client_height
    mov r9, rax
    vcall(swap_chain, IDXGISwapChainVtbl.ResizeBuffers, 0, r8, r9, DXGI_FORMAT.DXGI_FORMAT_UNKNOWN, 0)
    call render_create_targets
    mov resize_pending, 0
    add rsp, 56
    ret
}

; init -------------------------------------------------------------------------

; -> eax 1 ok
render_init: proc() -> b32 = {
    push rbx
    push rsi
    sub rsp, 104                       ; 12 arguments
    mov eax, client_width
    mov swap_desc.BufferDesc.Width, eax
    mov eax, client_height
    mov swap_desc.BufferDesc.Height, eax
    mov rax, window
    mov swap_desc.OutputWindow, rax
    invoke(D3D11CreateDeviceAndSwapChain, 0, D3D_DRIVER_TYPE.D3D_DRIVER_TYPE_HARDWARE, 0, 0, feature_level&, 1, D3D11_SDK_VERSION,
           swap_desc&, swap_chain&, device&, 0, context&)
    test eax, eax
    js failed
    call render_create_targets
    vcall(device, ID3D11DeviceVtbl.CreateRasterizerState, raster_desc&, raster_state&)
    vcall(device, ID3D11DeviceVtbl.CreateDepthStencilState, depth_state_desc&, depth_state&)
    vcall(device, ID3D11DeviceVtbl.CreateBuffer, cb_desc&, 0, frame_buffer&)
    test eax, eax
    js failed
    ; instance buffers
    lea rsi, instance_buffers
    mov ebx, LOD_COUNT
instance:
    vcall(device, ID3D11DeviceVtbl.CreateBuffer, instance_desc&, 0, rsi)
    test eax, eax
    js failed
    add rsi, 8
    dec ebx
    jnz instance
    ; shaders
    invoke(load_shader_bytes, "shaders\\unit_vs.cso")
    mov rbx, rax
    vcall(device, ID3D11DeviceVtbl.CreateVertexShader, rbx, render_shader_size, 0, vs_unit&)
    test eax, eax
    js failed
    vcall(device, ID3D11DeviceVtbl.CreateInputLayout, unit_layout&, 5, rbx, render_shader_size, input_layout&)
    test eax, eax
    js failed
    invoke(load_shader_bytes, "shaders\\unit_ps.cso")
    vcall(device, ID3D11DeviceVtbl.CreatePixelShader, rax, render_shader_size, 0, ps_unit&)
    test eax, eax
    js failed
    invoke(load_shader_bytes, "shaders\\ground_vs.cso")
    vcall(device, ID3D11DeviceVtbl.CreateVertexShader, rax, render_shader_size, 0, vs_ground&)
    test eax, eax
    js failed
    invoke(load_shader_bytes, "shaders\\ground_ps.cso")
    vcall(device, ID3D11DeviceVtbl.CreatePixelShader, rax, render_shader_size, 0, ps_ground&)
    test eax, eax
    js failed
    invoke(load_shader_bytes, "shaders\\bolt_vs.cso")
    vcall(device, ID3D11DeviceVtbl.CreateVertexShader, rax, render_shader_size, 0, vs_bolt&)
    test eax, eax
    js failed
    invoke(load_shader_bytes, "shaders\\shadow_vs.cso")
    mov rbx, rax
    vcall(device, ID3D11DeviceVtbl.CreateVertexShader, rbx, render_shader_size, 0, vs_shadow&)
    test eax, eax
    js failed
    vcall(device, ID3D11DeviceVtbl.CreateInputLayout, shadow_layout_desc&, 1, rbx, render_shader_size, shadow_layout&)
    test eax, eax
    js failed
    invoke(load_shader_bytes, "shaders\\shadow_ps.cso")
    vcall(device, ID3D11DeviceVtbl.CreatePixelShader, rax, render_shader_size, 0, ps_shadow&)
    test eax, eax
    js failed
    invoke(load_shader_bytes, "shaders\\sky_vs.cso")
    vcall(device, ID3D11DeviceVtbl.CreateVertexShader, rax, render_shader_size, 0, vs_sky&)
    test eax, eax
    js failed
    invoke(load_shader_bytes, "shaders\\sky_ps.cso")
    vcall(device, ID3D11DeviceVtbl.CreatePixelShader, rax, render_shader_size, 0, ps_sky&)
    test eax, eax
    js failed
    vcall(device, ID3D11DeviceVtbl.CreateBlendState, shadow_blend_desc&, shadow_blend&)
    test eax, eax
    js failed
    vcall(device, ID3D11DeviceVtbl.CreateDepthStencilState, shadow_depth_desc&, shadow_depth&)
    test eax, eax
    js failed
    invoke(load_shader_bytes, "shaders\\hero_vs.cso")
    vcall(device, ID3D11DeviceVtbl.CreateVertexShader, rax, render_shader_size, 0, vs_hero&)
    test eax, eax
    js failed
    ; meshes
    invoke(mesh_load, "assets\\meshes\\scuttler.lod0.mdm", lod_meshes&)
    test eax, eax
    jz failed
    mov rdx, lod_meshes&
    add rdx, sizeof(Mesh)
    invoke(mesh_load, "assets\\meshes\\scuttler.lod1.mdm", rdx)
    test eax, eax
    jz failed
    mov rdx, lod_meshes&
    add rdx, 2 * sizeof(Mesh)
    invoke(mesh_load, "assets\\meshes\\scuttler.lod2.mdm", rdx)
    test eax, eax
    jz failed
    invoke(mesh_load, "assets\\meshes\\hero.lod0.mdm", hero_mesh&)
    test eax, eax
    jz failed
    invoke(mesh_load, "assets\\fixtures\\bolt.mdm", bolt_mesh&)
    test eax, eax
    jz failed
    invoke(mesh_load, "assets\\fixtures\\shard.mdm", shard_mesh&)
    test eax, eax
    jz failed
    vcall(device, ID3D11DeviceVtbl.CreateBuffer, part_desc&, 0, part_buffer&)
    test eax, eax
    js failed
    invoke(load_shader_bytes, "shaders\\particle_vs.cso")
    vcall(device, ID3D11DeviceVtbl.CreateVertexShader, rax, render_shader_size, 0, vs_particle&)
    test eax, eax
    js failed
    invoke(mesh_load, "assets\\fixtures\\bolt_red.mdm", bolt_red_mesh&)
    test eax, eax
    jz failed
    vcall(device, ID3D11DeviceVtbl.CreateBuffer, red_desc&, 0, fx_red_buffer&)
    test eax, eax
    js failed
    vcall(device, ID3D11DeviceVtbl.CreateBuffer, bolt_desc&, 0, bolt_buffer&)
    test eax, eax
    js failed
    call ui_init
    test eax, eax
    jz failed
    call post_init
    test eax, eax
    jz failed
    call gems_init
    test eax, eax
    jz failed
    invoke(arena_reset, arena_frame&)
    mov eax, 1
    jmp done
failed:
    invoke(print, "render_init failed (hr %x)\n", rax)
    xor eax, eax
done:
    add rsp, 104
    pop rsi
    pop rbx
    ret
}

; per frame ----------------------------------------------------------------------

; Cull and bucket every entity into the three instance buffers.
render_instances: proc() = {
    push rbx
    push rsi
    push rdi
    push r12
    push r13
    push r14
    push r15
    sub rsp, 224                       ; 8 + 56 + 224 = 288; xmm6..15 at [rsp + 48 ..]
    movaps xmmword ptr [rsp + 48], xmm6
    movaps xmmword ptr [rsp + 64], xmm7
    movaps xmmword ptr [rsp + 80], xmm8
    movaps xmmword ptr [rsp + 96], xmm9
    movaps xmmword ptr [rsp + 112], xmm10
    movaps xmmword ptr [rsp + 128], xmm11
    movaps xmmword ptr [rsp + 144], xmm12
    movaps xmmword ptr [rsp + 160], xmm13
    movaps xmmword ptr [rsp + 176], xmm14
    movaps xmmword ptr [rsp + 192], xmm15
    rdtsc
    shl rdx, 32
    or rax, rdx
    mov qword ptr [rsp + 208], rax
    ; map the three buffers: write pointers in r13, r14, r15
    mov ecx, 0
    call map_instances
    mov r13, rax
    mov ecx, 1
    call map_instances
    mov r14, rax
    mov ecx, 2
    call map_instances
    mov r15, rax
    mov qword ptr [rsp + 32], r13      ; region starts, for the counts
    mov qword ptr [rsp + 40], r14
    mov qword ptr [rsp + 216], r15
    ; plane coefficients broadcast: a0 b0 c0 .. a3 b3 c3 would need 12 registers;
    ; planes 0..1 live in ymm6..11, planes 2..3 are read from memory.
    lea rax, cull_planes
    vbroadcastss ymm6, dword ptr [rax]
    vbroadcastss ymm7, dword ptr [rax + 4]
    vbroadcastss ymm8, dword ptr [rax + 8]
    vbroadcastss ymm9, dword ptr [rax + 16]
    vbroadcastss ymm10, dword ptr [rax + 20]
    vbroadcastss ymm11, dword ptr [rax + 24]
    vbroadcastss ymm12, cam_focus_x
    vbroadcastss ymm13, cam_focus_z
    vmovaps ymm14, ymmword ptr k_cull_margin
    mov r8, sim_pos_x
    mov r9, sim_pos_z
    mov r10, sim_vel_x
    mov r11, sim_vel_z
    xor esi, esi                       ; entity index of the block
    mov edi, sim_count
block:
    cmp esi, edi
    jae blocks_done
    vmovaps ymm0, ymmword ptr [r8 + rsi*4]          ; x
    vmovaps ymm1, ymmword ptr [r9 + rsi*4]          ; z
    ; plane 0
    vmulps ymm2, ymm0, ymm6
    vmulps ymm3, ymm1, ymm7
    vaddps ymm2, ymm2, ymm3
    vaddps ymm2, ymm2, ymm8
    vcmpps ymm15, ymm2, ymm14, 29                   ; >= -margin (GE_OQ)
    ; plane 1
    vmulps ymm2, ymm0, ymm9
    vmulps ymm3, ymm1, ymm10
    vaddps ymm2, ymm2, ymm3
    vaddps ymm2, ymm2, ymm11
    vcmpps ymm3, ymm2, ymm14, 29
    vandps ymm15, ymm15, ymm3
    ; planes 2, 3
    lea rax, cull_planes
    vbroadcastss ymm4, dword ptr [rax + 32]
    vmulps ymm2, ymm0, ymm4
    vbroadcastss ymm4, dword ptr [rax + 36]
    vmulps ymm3, ymm1, ymm4
    vaddps ymm2, ymm2, ymm3
    vbroadcastss ymm4, dword ptr [rax + 40]
    vaddps ymm2, ymm2, ymm4
    vcmpps ymm3, ymm2, ymm14, 29
    vandps ymm15, ymm15, ymm3
    vbroadcastss ymm4, dword ptr [rax + 48]
    vmulps ymm2, ymm0, ymm4
    vbroadcastss ymm4, dword ptr [rax + 52]
    vmulps ymm3, ymm1, ymm4
    vaddps ymm2, ymm2, ymm3
    vbroadcastss ymm4, dword ptr [rax + 56]
    vaddps ymm2, ymm2, ymm4
    vcmpps ymm3, ymm2, ymm14, 29
    vandps ymm15, ymm15, ymm3
    vmovmskps ebx, ymm15
    test ebx, ebx
    jz next_block
    ; lanes past the live count are not visible
    mov eax, edi
    sub eax, esi
    cmp eax, 8
    jae full_block
        mov ecx, eax
        mov eax, 1
        shl eax, cl
        dec eax
        and ebx, eax
        jz next_block
    full_block:
    ; LOD masks from the squared distance to the focus
    vsubps ymm2, ymm0, ymm12
    vsubps ymm3, ymm1, ymm13
    vmulps ymm2, ymm2, ymm2
    vmulps ymm3, ymm3, ymm3
    vaddps ymm2, ymm2, ymm3
    vcmpps ymm3, ymm2, ymmword ptr k_lod0_d2, 1    ; < LOD0 (LT_OS)
    vmovmskps r12d, ymm3
    vcmpps ymm3, ymm2, ymmword ptr k_lod1_d2, 1
    vmovmskps ecx, ymm3                             ; < LOD1
    ; ebx visible; r12d lod0 within visible; ecx lod1 = (<LOD1) & ~lod0; lod2 = rest
    and r12d, ebx
    andn ecx, r12d, ecx
    and ecx, ebx
    mov eax, r12d
    or eax, ecx
    andn eax, eax, ebx                 ; lod2
    mov dword ptr [rsp + 24], eax
    mov dword ptr [rsp + 28], ecx
    ; write lod0 lanes
    mov edx, r12d
lane0:
    test edx, edx
    jz lod1_lanes
    tzcnt eax, edx
    blsr edx, edx
    add eax, esi
    vmovss xmm2, dword ptr [r8 + rax*4]
    vinsertps xmm2, xmm2, dword ptr [r9 + rax*4], 0x10
    vinsertps xmm2, xmm2, dword ptr [r10 + rax*4], 0x20
    vinsertps xmm2, xmm2, dword ptr [r11 + rax*4], 0x30
    vmovntps xmmword ptr [r13], xmm2
    add r13, 16
    jmp lane0
lod1_lanes:
    mov edx, dword ptr [rsp + 28]
lane1:
    test edx, edx
    jz lod2_lanes
    tzcnt eax, edx
    blsr edx, edx
    add eax, esi
    vmovss xmm2, dword ptr [r8 + rax*4]
    vinsertps xmm2, xmm2, dword ptr [r9 + rax*4], 0x10
    vinsertps xmm2, xmm2, dword ptr [r10 + rax*4], 0x20
    vinsertps xmm2, xmm2, dword ptr [r11 + rax*4], 0x30
    vmovntps xmmword ptr [r14], xmm2
    add r14, 16
    jmp lane1
lod2_lanes:
    mov edx, dword ptr [rsp + 24]
lane2:
    test edx, edx
    jz next_block
    tzcnt eax, edx
    blsr edx, edx
    add eax, esi
    vmovss xmm2, dword ptr [r8 + rax*4]
    vinsertps xmm2, xmm2, dword ptr [r9 + rax*4], 0x10
    vinsertps xmm2, xmm2, dword ptr [r10 + rax*4], 0x20
    vinsertps xmm2, xmm2, dword ptr [r11 + rax*4], 0x30
    vmovntps xmmword ptr [r15], xmm2
    add r15, 16
    jmp lane2
next_block:
    add esi, 8
    jmp block
blocks_done:
    sfence
    vzeroupper
    ; counts
    mov rax, r13
    sub rax, qword ptr [rsp + 32]
    shr rax, 4
    mov instance_counts[0], eax
    mov rax, r14
    sub rax, qword ptr [rsp + 40]
    shr rax, 4
    mov instance_counts[1], eax
    mov rax, r15
    sub rax, qword ptr [rsp + 216]
    shr rax, 4
    mov instance_counts[2], eax
    vcall(context, ID3D11DeviceContextVtbl.Unmap, instance_buffers[0], 0)
    vcall(context, ID3D11DeviceContextVtbl.Unmap, instance_buffers[1], 0)
    vcall(context, ID3D11DeviceContextVtbl.Unmap, instance_buffers[2], 0)
    rdtsc
    shl rdx, 32
    or rax, rdx
    sub rax, qword ptr [rsp + 208]
    mov render_instance_cycles, rax
    movaps xmm6, xmmword ptr [rsp + 48]
    movaps xmm7, xmmword ptr [rsp + 64]
    movaps xmm8, xmmword ptr [rsp + 80]
    movaps xmm9, xmmword ptr [rsp + 96]
    movaps xmm10, xmmword ptr [rsp + 112]
    movaps xmm11, xmmword ptr [rsp + 128]
    movaps xmm12, xmmword ptr [rsp + 144]
    movaps xmm13, xmmword ptr [rsp + 160]
    movaps xmm14, xmmword ptr [rsp + 176]
    movaps xmm15, xmmword ptr [rsp + 192]
    add rsp, 224
    pop r15
    pop r14
    pop r13
    pop r12
    pop rdi
    pop rsi
    pop rbx
    ret

; ecx: LOD -> rax: the mapped write pointer of its buffer (WRITE_DISCARD).
; A local routine: rsp is 8 off its 16 alignment here, fixed by the sub.
map_instances:
    sub rsp, 56
    lea rax, instance_buffers
    mov rdx, [rax + rcx*8]             ; not rcx: vcall moves the object into rcx first
    vcall(context, ID3D11DeviceContextVtbl.Map, rdx, 0, D3D11_MAP.D3D11_MAP_WRITE_DISCARD, 0, mapped&)
    mov rax, mapped.pData
    add rsp, 56
    ret
}

; Upload frame_cb.
render_upload_frame: proc() = {
    push rsi
    push rdi
    sub rsp, 56                        ; 8 + 16 + 56 = 80
    vcall(context, ID3D11DeviceContextVtbl.Map, frame_buffer, 0, D3D11_MAP.D3D11_MAP_WRITE_DISCARD, 0, mapped&)
    mov rdi, mapped.pData
    lea rsi, frame_cb
    mov ecx, sizeof(FrameConstants)
    rep movsb
    vcall(context, ID3D11DeviceContextVtbl.Unmap, frame_buffer, 0)
    add rsp, 56
    pop rdi
    pop rsi
    ret
}

; Draw one frame and present it.
render_frame: proc() = {
    push rbx
    push rsi
    sub rsp, 72                        ; 8 + 16 + 72 = 96
    cmp resize_pending, 0
    je sized
        call render_resize
    sized:
    call render_instances
    ; frame constants
    lea rsi, cam_view_proj
    lea rdi, frame_cb
    mov ecx, 64
    push rdi
    push rsi
    rep movsb
    pop rsi
    pop rdi
    vmovaps xmm0, xmmword ptr cam_eye
    vmovups xmmword ptr frame_cb.camera_pos, xmm0
    vmovss xmm0, render_time
    vmovss frame_cb.camera_pos[3], xmm0
    mov eax, client_width
    vcvtsi2ss xmm0, xmm0, eax
    vmovss frame_cb.screen[0], xmm0
    mov eax, client_height
    vcvtsi2ss xmm0, xmm0, eax
    vmovss frame_cb.screen[1], xmm0
    call render_fill_effects
    call render_upload_frame

    vcall(context, ID3D11DeviceContextVtbl.ClearRenderTargetView, hdr_rtv, clear_color&)
    vmovss xmm3, k_depth_one           ; Depth is a float: the fourth argument goes in xmm3
    vcall(context, ID3D11DeviceContextVtbl.ClearDepthStencilView, depth_dsv, D3D11_CLEAR_FLAG.D3D11_CLEAR_DEPTH, 0, 0)
    vcall(context, ID3D11DeviceContextVtbl.OMSetRenderTargets, 1, hdr_rtv&, depth_dsv)
    vcall(context, ID3D11DeviceContextVtbl.OMSetDepthStencilState, depth_state, 0)
    vcall(context, ID3D11DeviceContextVtbl.RSSetViewports, 1, viewport&)
    vcall(context, ID3D11DeviceContextVtbl.RSSetState, raster_state)
    vcall(context, ID3D11DeviceContextVtbl.VSSetConstantBuffers, 0, 1, frame_buffer&)
    vcall(context, ID3D11DeviceContextVtbl.PSSetConstantBuffers, 0, 1, frame_buffer&)
    vcall(context, ID3D11DeviceContextVtbl.OMSetBlendState, 0, 0, 0xFFFFFFFF)

    ; sky: one triangle, no depth
    vcall(context, ID3D11DeviceContextVtbl.OMSetDepthStencilState, ui_depth, 0)
    vcall(context, ID3D11DeviceContextVtbl.IASetInputLayout, 0)
    vcall(context, ID3D11DeviceContextVtbl.IASetPrimitiveTopology, D3D11_PRIMITIVE_TOPOLOGY.D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST)
    vcall(context, ID3D11DeviceContextVtbl.VSSetShader, vs_sky, 0, 0)
    vcall(context, ID3D11DeviceContextVtbl.PSSetShader, ps_sky, 0, 0)
    vcall(context, ID3D11DeviceContextVtbl.Draw, 3, 0)
    vcall(context, ID3D11DeviceContextVtbl.OMSetDepthStencilState, depth_state, 0)

    ; ground
    vcall(context, ID3D11DeviceContextVtbl.IASetInputLayout, 0)
    vcall(context, ID3D11DeviceContextVtbl.IASetPrimitiveTopology, D3D11_PRIMITIVE_TOPOLOGY.D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST)
    vcall(context, ID3D11DeviceContextVtbl.VSSetShader, vs_ground, 0, 0)
    vcall(context, ID3D11DeviceContextVtbl.PSSetShader, ps_ground, 0, 0)
    vcall(context, ID3D11DeviceContextVtbl.Draw, 6, 0)

    ; blob shadows: every visible alien, all LODs, before the aliens themselves
    vcall(context, ID3D11DeviceContextVtbl.IASetInputLayout, shadow_layout)
    vcall(context, ID3D11DeviceContextVtbl.VSSetShader, vs_shadow, 0, 0)
    vcall(context, ID3D11DeviceContextVtbl.PSSetShader, ps_shadow, 0, 0)
    vcall(context, ID3D11DeviceContextVtbl.OMSetBlendState, shadow_blend, 0, 0xFFFFFFFF)
    vcall(context, ID3D11DeviceContextVtbl.OMSetDepthStencilState, shadow_depth, 0)
    xor ebx, ebx
shadow:
    lea rax, instance_counts
    mov eax, dword ptr [rax + rbx*4]
    test eax, eax
    jz next_shadow
    lea rax, instance_buffers
    lea rax, [rax + rbx*8]
    vcall(context, ID3D11DeviceContextVtbl.IASetVertexBuffers, 0, 1, rax, instance_stride&, instance_offset&)
    lea rax, instance_counts
    mov r8d, dword ptr [rax + rbx*4]   ; r8 itself: vcall fills rdx before r8
    vcall(context, ID3D11DeviceContextVtbl.DrawInstanced, 6, r8, 0, 0)
next_shadow:
    inc ebx
    cmp ebx, LOD_COUNT
    jb shadow
    vcall(context, ID3D11DeviceContextVtbl.OMSetBlendState, 0, 0, 0xFFFFFFFF)
    vcall(context, ID3D11DeviceContextVtbl.OMSetDepthStencilState, depth_state, 0)

    ; units: one instanced draw per LOD
    vcall(context, ID3D11DeviceContextVtbl.IASetInputLayout, input_layout)
    vcall(context, ID3D11DeviceContextVtbl.VSSetShader, vs_unit, 0, 0)
    vcall(context, ID3D11DeviceContextVtbl.PSSetShader, ps_unit, 0, 0)
    xor ebx, ebx
lod:
    lea rax, instance_counts
    mov eax, dword ptr [rax + rbx*4]
    test eax, eax
    jz next_lod
    imul rsi, rbx, sizeof(Mesh)
    lea rax, lod_meshes
    add rsi, rax
    lea rax, [rsi].Mesh.vb
    vcall(context, ID3D11DeviceContextVtbl.IASetVertexBuffers, 0, 1, rax, mesh_stride&, mesh_offset&)
    lea rax, instance_buffers
    lea rax, [rax + rbx*8]
    vcall(context, ID3D11DeviceContextVtbl.IASetVertexBuffers, 1, 1, rax, instance_stride&, instance_offset&)
    mov rax, [rsi].Mesh.ib
    vcall(context, ID3D11DeviceContextVtbl.IASetIndexBuffer, rax, DXGI_FORMAT.DXGI_FORMAT_R32_UINT, 0)
    mov eax, [rsi].Mesh.index_count
    lea rcx, instance_counts
    mov r8d, dword ptr [rcx + rbx*4]
    vcall(context, ID3D11DeviceContextVtbl.DrawIndexedInstanced, rax, r8, 0, 0, 0)
next_lod:
    inc ebx
    cmp ebx, LOD_COUNT
    jb lod

    ; projectiles: the unit pipeline with the bolt mesh
    call render_fx
    call render_particles
    call render_gems
    ; hero
    cmp hero_alive, 0
    je no_hero
    vcall(context, ID3D11DeviceContextVtbl.VSSetShader, vs_hero, 0, 0)
    vcall(context, ID3D11DeviceContextVtbl.IASetVertexBuffers, 0, 1, hero_mesh.vb&, mesh_stride&, mesh_offset&)
    vcall(context, ID3D11DeviceContextVtbl.IASetIndexBuffer, hero_mesh.ib, DXGI_FORMAT.DXGI_FORMAT_R32_UINT, 0)
    mov eax, hero_mesh.index_count
    vcall(context, ID3D11DeviceContextVtbl.DrawIndexed, rax, 0, 0)
    no_hero:
    call post_finish
    call hud_draw

    ; --record dir: every second frame as dir/fNNNNN.bmp (30 fps of 60 Hz ticks)
    cmp opt_record, 0
    je no_record
    test frame_index, 1
    jnz no_record
        mov eax, frame_index
        shr eax, 1
        mov r9, rax
        mov r8, opt_record
        lea rdx, record_fmt
        lea rcx, record_path
        call wsprintfA
        lea rax, record_path
        mov capture_target, rax
        call render_capture
    no_record:
    cmp opt_capture, 0
    je no_capture
    mov eax, opt_frames
    dec eax
    cmp eax, frame_index
    jne no_capture
        mov rax, opt_capture
        mov capture_target, rax
        call render_capture
    no_capture:
    mov eax, opt_vsync
    vcall(swap_chain, IDXGISwapChainVtbl.Present, rax, 0)
    add rsp, 72
    pop rsi
    pop rbx
    ret
}

; Effect state for the shaders: pulse, strike, camera basis, game.
render_fill_effects: proc() = {
    ; pulse: centre, radius, running
    vmovss xmm0, pulse_cx
    vmovss frame_cb.fx_pulse[0], xmm0
    vmovss xmm0, pulse_cz
    vmovss frame_cb.fx_pulse[1], xmm0
    vmovss xmm0, pulse_r
    vmovss frame_cb.fx_pulse[2], xmm0
    mov eax, pulse_on
    vcvtsi2ss xmm0, xmm0, eax
    vmovss frame_cb.fx_pulse[3], xmm0
    ; strike: point, telegraph 1 -> 0 while the timer runs, then a decaying flash
    vmovss xmm0, bomb_x
    vmovss frame_cb.fx_bomb[0], xmm0
    vmovss xmm0, bomb_z
    vmovss frame_cb.fx_bomb[1], xmm0
    mov eax, bomb_timer
    vcvtsi2ss xmm0, xmm0, eax
    vmulss xmm0, xmm0, k_bomb_delay_inv
    vmovss frame_cb.fx_bomb[2], xmm0
    vmovss xmm1, bomb_flash
    vsubss xmm1, xmm1, k_bomb_flash_decay
    vxorps xmm2, xmm2, xmm2
    vmaxss xmm1, xmm1, xmm2
    mov eax, bomb_timer
    test eax, eax
    jnz timing
    cmp bomb_was_timing, 0
    je timing
        vmovss xmm1, k_one[0]          ; the strike landed since the last frame
    timing:
    mov bomb_was_timing, eax
    vmovss bomb_flash, xmm1
    vmovss frame_cb.fx_bomb[3], xmm1
    ; camera basis, scaled for the sky's rays
    vmovss xmm3, cam_tan
    vmulss xmm4, xmm3, cam_aspect
    vbroadcastss xmm4, xmm4
    vbroadcastss xmm3, xmm3
    lea rax, cam_view
    vmulps xmm0, xmm4, xmmword ptr [rax + 64]
    vmovups xmmword ptr frame_cb.cam_x, xmm0
    vmulps xmm0, xmm3, xmmword ptr [rax + 80]
    vmovups xmmword ptr frame_cb.cam_y, xmm0
    vmovaps xmm0, xmmword ptr [rax + 96]
    vmovups xmmword ptr frame_cb.cam_z, xmm0
    ; game: alive, hp fraction, level-up flash, beam
    mov eax, hero_alive
    vcvtsi2ss xmm0, xmm0, eax
    vmovss frame_cb.game[0], xmm0
    vmovss xmm0, hero_hp
    vdivss xmm0, xmm0, hero_hp_max
    vmovss frame_cb.game[1], xmm0
    mov eax, beam_on
    vcvtsi2ss xmm0, xmm0, eax
    vmovss frame_cb.game[3], xmm0
    ret
}

; capture ----------------------------------------------------------------------

bmp_header: [54]u8 = {}
capture_target: *u8 = 0
record_path: [512]u8 = {}
record_fmt: [16]const u8 = "%s\\f%05u.bmp"
bmp_file: *void = {}
bmp_written: u32 = 0

; Write the back buffer to opt_capture as a 32-bit top-down BMP.
render_capture: proc() = {
    push rbx
    push rsi
    push rdi
    push r12
    sub rsp, 72                        ; 8 + 32 + 72 = 112
    vcall(context, ID3D11DeviceContextVtbl.CopyResource, staging_tex, backbuffer)
    vcall(context, ID3D11DeviceContextVtbl.Map, staging_tex, 0, D3D11_MAP.D3D11_MAP_READ, 0, mapped&)
    test eax, eax
    js failed
    ; header: 'BM', size, 54 offset, 40-byte info, w, -h, 1 plane, 32 bpp
    lea rdi, bmp_header
    mov word ptr [rdi], 0x4D42
    mov eax, client_width
    imul eax, client_height
    shl eax, 2
    mov r12d, eax                      ; image bytes
    add eax, 54
    mov dword ptr [rdi + 2], eax
    mov dword ptr [rdi + 6], 0
    mov dword ptr [rdi + 10], 54
    mov dword ptr [rdi + 14], 40
    mov eax, client_width
    mov dword ptr [rdi + 18], eax
    mov eax, client_height
    neg eax
    mov dword ptr [rdi + 22], eax
    mov word ptr [rdi + 26], 1
    mov word ptr [rdi + 28], 32
    mov dword ptr [rdi + 30], 0
    mov dword ptr [rdi + 34], r12d
    mov rcx, capture_target
    invoke(CreateFileA, rcx, GENERIC_WRITE, 0, 0, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0)
    cmp rax, -1
    je unmap
    mov bmp_file, rax
    invoke(WriteFile, bmp_file, bmp_header&, 54, bmp_written&, 0)
    ; rows (the mapped pitch may exceed width * 4)
    mov rsi, mapped.pData
    mov ebx, client_height
    mov edi, client_width
    shl edi, 2
row:
    invoke(WriteFile, bmp_file, rsi, rdi, bmp_written&, 0)
    mov eax, mapped.RowPitch
    add rsi, rax
    dec ebx
    jnz row
    invoke(CloseHandle, bmp_file)
unmap:
    vcall(context, ID3D11DeviceContextVtbl.Unmap, staging_tex, 0)
failed:
    add rsp, 72
    pop r12
    pop rdi
    pop rsi
    pop rbx
    ret
}
