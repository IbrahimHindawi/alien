; MILLION DEAD, the RASM engine
;
;   md_rasm.exe [--entities N] [--seed S] [--frames N] [--hidden] [--novsync] [--diag] [--capture f.bmp]
;   md_rasm.exe --bench-sim [--entities N] [--ticks T] [--seed S]     headless simulation benchmark
;   md_rasm.exe --test                                                 self tests
;
; One program, imported module by module (rasm is a unity build). The order
; of the imports is the order of the layers: platform, memory, simulation,
; renderer, game.
import "include/d3d11.rin"
import "include/calls.rasm"
import "include/print.rasm"
import "memory/arena.rasm"
import "platform/platform.rasm"
import "platform/crash.rasm"
import "platform/threads.rasm"
import "simulation/sim.rasm"
import "simulation/separate_v2.rasm"
import "simulation/separate_v3.rasm"
import "simulation/combat.rasm"
import "simulation/compact_lut.rasm"
import "simulation/compact_mt.rasm"
import "simulation/abilities.rasm"
import "simulation/grid_mt.rasm"
import "simulation/dump.rasm"
import "renderer/math.rasm"
import "renderer/camera.rasm"
import "renderer/render.rasm"
import "renderer/post.rasm"
import "renderer/gpu_timer.rasm"
import "renderer/fx.rasm"
import "renderer/particles.rasm"
import "renderer/ui_font.rasm"
import "renderer/ui.rasm"
import "renderer/ring_table.rasm"
import "gameplay/hero.rasm"
import "gameplay/hud.rasm"
import "gameplay/progress.rasm"
import "gameplay/juice.rasm"
import "tests/tests.rasm"

; 768 MiB reserved and committed for the run
#define PERM_BYTES 805306368

bench_t0: u64 = 0
bench_t1: u64 = 0
bench_cyc_grid: u64 = 0
bench_cyc_sep: u64 = 0
bench_cyc_int: u64 = 0
bench_cyc_combat: u64 = 0
bench_ticks_done: u32 = 0

; interactive loop
frame_index: u32 = 0
run_escalation: u32 = 1
loop_last: u64 = 0
tick_accum: u64 = 0                    ; QPC ticks not yet simulated
tick_qpc: u64 = 0                      ; QPC ticks per simulation tick
stats_last: u64 = 0
stats_frames: u32 = 0
stats_sim_qpc: u64 = 0
stats_frame_qpc: u64 = 0
stats_inst_cycles: u64 = 0
title_buffer: [256]u8 = {}
k_tick_seconds: const f32 = 0.016666668

#define MAX_TICKS_PER_FRAME 4
; the run's escalation (scenario, not simulation rules): start with
; RUN_START aliens in a ring, then the population target grows by
; RUN_GROWTH per second up to --entities
#define RUN_START 300
#define RUN_GROWTH 40

; Headless: init, run opt_bench_ticks ticks with the bench input, print the
; time per tick, cycles per entity per phase, and the state hash.
bench_sim: proc() -> i32 = {
    push rbx
    push rsi
    sub rsp, 40
    mov ecx, opt_entities
    mov edx, opt_seed
    call sim_init
    mov bench_cyc_grid, 0
    mov bench_cyc_sep, 0
    mov bench_cyc_int, 0
    mov bench_cyc_combat, 0
    call clock_ticks
    mov bench_t0, rax
    mov ebx, opt_bench_ticks
again:
    test ebx, ebx
    jz finished
    call bench_input
    mov ecx, eax
    call sim_step
    mov rax, cyc_grid
    add bench_cyc_grid, rax
    mov rax, cyc_separate
    add bench_cyc_sep, rax
    mov rax, cyc_integrate
    add bench_cyc_int, rax
    mov rax, cyc_combat
    add bench_cyc_combat, rax
    dec ebx
    jmp again
finished:
    call clock_ticks
    mov bench_t1, rax
    sub rax, bench_t0
    invoke(ticks_to_us, rax)
    xor edx, edx
    mov ecx, opt_bench_ticks
    test ecx, ecx
    jz no_ticks
    div rcx                            ; microseconds per tick
    no_ticks:
    mov ebx, opt_entities
    mov esi, opt_bench_ticks
    invoke(print, "bench-sim entities=%u ticks=%u us_per_tick=%u\n", rbx, rsi, rax)
    ; cycles per entity per tick, x100 (two decimals)
    mov esi, opt_bench_ticks
    mov eax, opt_entities
    imul rsi, rax                      ; entity-ticks
    test rsi, rsi
    jz no_entities
    mov rax, bench_cyc_grid
    imul rax, rax, 100
    xor edx, edx
    div rsi
    mov rbx, rax
    mov rax, bench_cyc_sep
    imul rax, rax, 100
    xor edx, edx
    div rsi
    mov r8, rax
    mov rax, bench_cyc_int
    imul rax, rax, 100
    xor edx, edx
    div rsi
    invoke(print, "cycles/entity x100: grid=%u separate=%u integrate=%u\n", rbx, r8, rax)
    mov rax, bench_cyc_combat
    xor edx, edx
    mov ecx, opt_bench_ticks
    div rcx
    mov ebx, kills
    mov esi, proj_count
    invoke(print, "combat cycles/tick=%u kills=%u projectiles=%u\n", rax, rbx, rsi)
    mov eax, sim_count
    mov ebx, hero_alive
    invoke(print, "count=%u hero_alive=%u\n", rax, rbx)
    no_entities:
    mov rcx, opt_dump
    test rcx, rcx
    jz no_dump
        call sim_dump
    no_dump:
    call sim_hash
    mov rsi, rax
    shr rsi, 32
    mov ebx, eax
    invoke(print, "hash=%08x%08x\n", rsi, rbx)
    xor eax, eax
    add rsp, 40
    pop rsi
    pop rbx
    ret
}

; Update the window title with the averages since the last update.
update_title: proc() = {
    push rbx
    push rsi
    push rdi
    push r12
    push r13
    sub rsp, 80                        ; 8 + 40 + 80 = 128
    mov ebx, stats_frames
    test ebx, ebx
    jz done
    invoke(ticks_to_us, stats_frame_qpc)
    xor edx, edx
    div rbx
    mov rsi, rax                       ; frame us
    mov stat_frame_us, eax
    invoke(ticks_to_us, stats_sim_qpc)
    xor edx, edx
    div rbx
    mov rdi, rax                       ; sim us per frame
    mov stat_sim_us, eax
    call gpu_timer_average
    mov rax, stats_inst_cycles
    xor edx, edx
    div rbx
    xor edx, edx
    mov ecx, 1000
    div rcx
    mov r12, rax                       ; instance kcycles per frame
    mov eax, instance_counts[0]
    add eax, instance_counts[1]
    add eax, instance_counts[2]
    mov r13, rax                       ; visible
    mov eax, kills
    mov r12, rax                       ; kills replace the instance cycles in the title
    vcvttss2si eax, hero_hp
    mov rdi, rax                       ; hp replaces the sim time
    mov eax, sim_count
    mov qword ptr [rsp + 32], rax
    mov qword ptr [rsp + 40], rsi
    mov qword ptr [rsp + 48], rdi
    mov qword ptr [rsp + 56], r12
    mov qword ptr [rsp + 64], r13
    lea rcx, title_buffer
    lea rdx, title_fmt
    mov r8, qword ptr [rsp + 32]
    mov r9, qword ptr [rsp + 40]
    mov rax, qword ptr [rsp + 48]
    mov qword ptr [rsp + 32], rax
    mov rax, qword ptr [rsp + 56]
    mov qword ptr [rsp + 40], rax
    mov rax, qword ptr [rsp + 64]
    mov qword ptr [rsp + 48], rax
    call wsprintfA
    invoke(SetWindowTextA, window, title_buffer&)
    cmp opt_frames, 0
    je no_stdout
        invoke(print, "%s\n", title_buffer&)
    no_stdout:
    mov stats_frames, 0
    mov stats_sim_qpc, 0
    mov stats_frame_qpc, 0
    mov stats_inst_cycles, 0
done:
    add rsp, 80
    pop r13
    pop r12
    pop rdi
    pop rsi
    pop rbx
    ret
}
title_fmt: [112]const u8 = "MILLION DEAD [RASM]  aliens %u  frame %u us  HP %u  kills %u  visible %u   (WASD move, mouse aim, R restart)"

; A fresh run: RUN_START aliens spawned on the ring, target escalating.
run_start: proc() = {
    sub rsp, 40
    xor ecx, ecx
    mov edx, opt_seed
    call sim_init
    mov eax, RUN_START
    cmp eax, opt_entities
    cmova eax, opt_entities
    mov target_count, eax
    cmp game_on, 0
    je no_game
        call game_reset
    no_game:
    add rsp, 40
    ret
}

; Per tick, before sim_step: the swarm snowballs,
; target = min(--entities, RUN_START + s * RUN_GROWTH + 3 s^2 / 2) with s the seconds survived
run_escalate: proc() = {
    mov eax, sim_tick
    xor edx, edx
    mov ecx, 60
    div ecx                            ; s
    mov ecx, eax
    imul ecx, eax                      ; s^2
    lea ecx, [rcx + rcx*2]
    shr ecx, 1                         ; 3 s^2 / 2
    imul eax, eax, RUN_GROWTH
    add eax, ecx
    add eax, RUN_START
    cmp eax, opt_entities
    cmova eax, opt_entities
    mov target_count, eax
    ret
}

; The game: window, renderer, fixed 60 Hz simulation, render every frame.
run_game: proc() -> i32 = {
    push rbx
    push rsi
    push rdi
    sub rsp, 32                        ; 8 + 24 + 32 = 64
    call window_create
    test eax, eax
    jz failed
    call render_init
    test eax, eax
    jz failed
    mov game_on, 1                     ; the progression layer (never in --bench-sim or --test)
    cmp opt_spawn_set, 0
    je escalating
        mov ecx, opt_entities          ; --spawn-half: a stress scene, all at once
        mov edx, opt_seed
        call sim_init
        call game_reset
        mov run_escalation, 0
        jmp started
    escalating:
        call run_start
        mov run_escalation, 1
    started:
    mov rax, qpc_frequency
    xor edx, edx
    mov ecx, 60
    div rcx
    mov tick_qpc, rax
    call clock_ticks
    mov loop_last, rax
    mov stats_last, rax
frame:
    call pump_messages
    test eax, eax
    jz finished
    lea rax, keys_pressed
    cmp byte ptr [rax + VK_ESCAPE], 0
    je no_escape
        invoke(DestroyWindow, window)
    no_escape:
    ; R after death: a fresh run
    cmp hero_alive, 0
    jne no_restart
    lea rax, keys_pressed
    cmp byte ptr [rax + 0x52], 0
    je no_restart
        inc opt_seed
        call run_start
    no_restart:
    call clock_ticks
    mov rbx, rax
    sub rax, loop_last
    mov loop_last, rbx
    add stats_frame_qpc, rax
    ; ticks to run: one per frame in a bounded run (deterministic), else by the clock
    mov esi, 1
    cmp opt_frames, 0
    jne ticks_known
        add tick_accum, rax
        xor esi, esi
        count:
        mov rax, tick_accum
        cmp rax, tick_qpc
        jb ticks_known
        sub rax, tick_qpc
        mov tick_accum, rax
        inc esi
        cmp esi, MAX_TICKS_PER_FRAME
        jb count
        mov tick_accum, 0              ; too far behind: drop the backlog
    ticks_known:
    call game_input
    cmp game_choosing, 0
    je not_choosing
        xor esi, esi                   ; an upgrade pick is open: the world waits
        mov tick_accum, 0
    not_choosing:
    call clock_ticks
    mov rdi, rax
simulate:
    test esi, esi
    jz simulated
    cmp game_choosing, 0
    jne simulated
    cmp run_escalation, 0
    je fixed_population
        call run_escalate
    fixed_population:
    cmp opt_autoplay, 0
    je by_hand
        call bench_input               ; sets the aim too
        mov sim_move_override, 0
        mov ecx, eax
        call sim_step
        jmp stepped
    by_hand:
    call hero_read_keys
    mov sim_move_override, 0
    cmp cam_mode, 0
    je world_axes
        mov ecx, eax
        push rax
        sub rsp, 8
        call camera_relative_move
        add rsp, 8
        pop rax
        mov sim_move_override, 1
    world_axes:
    or eax, FIRE_BIT                   ; the primary weapon is automatic
    mov ecx, eax
    vmovss xmm0, aim_x
    vmovss sim_aim_x, xmm0
    vmovss xmm0, aim_z
    vmovss sim_aim_z, xmm0
    call sim_step
    stepped:
    call game_tick
    vmovss xmm0, render_time
    vaddss xmm0, xmm0, k_tick_seconds
    vmovss render_time, xmm0
    dec esi
    jmp simulate
simulated:
    call clock_ticks
    sub rax, rdi
    add stats_sim_qpc, rax
    call juice_frame
    call camera_update
    call hero_update_matrix
    call game_frame
    call render_frame
    mov rax, render_instance_cycles
    add stats_inst_cycles, rax
    call frame_input_end
    inc stats_frames
    inc frame_index
    ; title twice a second
    mov rax, rbx
    sub rax, stats_last
    mov rcx, qpc_frequency
    shr rcx, 1
    cmp rax, rcx
    jb no_title
        mov stats_last, rbx
        call update_title
    no_title:
    mov eax, opt_frames
    test eax, eax
    jz frame
    cmp frame_index, eax
    jb frame
finished:
    call update_title
    xor eax, eax
    jmp done
failed:
    mov eax, 1
done:
    add rsp, 32
    pop rdi
    pop rsi
    pop rbx
    ret
}

main: proc(argc: i32, argv: **u8) -> i32 = {
    push rbx
    sub rsp, 32
    call parse_options
    test eax, eax
    jz usage
    call crash_install
    call clock_init
    call exe_dir_init
    invoke(arena_init, arena_perm&, PERM_BYTES)
    test eax, eax
    jz no_memory
    invoke(arena_init, arena_frame&, 67108864)
    test eax, eax
    jz no_memory
    call sim_alloc
    test eax, eax
    jz no_memory
    mov ecx, opt_threads
    call pool_init
    cmp opt_test, 0
    je not_test
        call run_tests
        jmp leave
    not_test:
    cmp opt_bench_sim, 0
    je not_bench
        call bench_sim
        jmp leave
    not_bench:
    call run_game
    jmp leave
usage:
    invoke(print, "usage: md_rasm [--entities N] [--seed S] [--frames N] [--hidden] [--novsync] [--diag] [--bench-sim [--ticks T]] [--test]\n")
    mov eax, 2
    jmp leave
no_memory:
    invoke(print, "out of memory\n")
    mov eax, 3
leave:
    mov ebx, eax
    invoke(ExitProcess, rbx)
}
